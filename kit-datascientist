    "# ============================================================\n",
    "# INSTALLATION CELL — 00_install.py\n",
    "# Run this cell ONCE before anything else.\n",
    "# Select which package groups you need, then run.\n",
    "# To add a new group: append an entry to PACKAGE_GROUPS below.\n",
