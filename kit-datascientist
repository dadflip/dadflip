   "source": [
    "# ============================================================\n",
    "# CELLULE 6 — DIAGNOSTIC COMPLET DU DÉSÉQUILIBRE DES CLASSES\n",
    "# + RÉÉQUILIBRAGE PAR COLONNE (CHOIX UTILISATEUR)\n",
    "# ============================================================\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, HTML, clear_output\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from collections import Counter\n",
    "\n",
    "# ----------------------------------------------------------------\n",
    "# Détection des colonnes potentielles comme cible\n",
    "# ----------------------------------------------------------------\n",
    "def detect_potential_targets(df: pd.DataFrame) -> list:\n",
    "    \"\"\"\n",
    "    Détecte toutes les colonnes potentielles comme cible (binaires ou catégorielles).\n",
    "    Retourne une liste de tuples (nom_colonne, type).\n",
    "    \"\"\"\n",
    "    potential_targets = []\n",
    "    for col in df.columns:\n",
    "        n_unique = df[col].nunique()\n",
    "        if n_unique <= 20:  # Seuil pour éviter les IDs ou features numériques\n",
    "            if pd.api.types.is_bool_dtype(df[col]) or n_unique == 2:\n",
    "                potential_targets.append((col, 'binary'))\n",
    "            elif not pd.api.types.is_numeric_dtype(df[col]) or n_unique <= 5:\n",
    "                potential_targets.append((col, 'categorical'))\n",
    "    return potential_targets\n",
    "\n",
    "# ----------------------------------------------------------------\n",
    "# Analyse du déséquilibre pour une colonne donnée\n",
    "# ----------------------------------------------------------------\n",
    "def analyze_class_imbalance(df: pd.DataFrame, target_col: str) -> dict:\n",
    "    \"\"\"\n",
    "    Analyse le déséquilibre des classes pour une colonne cible.\n",
    "    \"\"\"\n",
    "    if target_col not in df.columns:\n",
    "        return {\"error\": f\"Colonne '{target_col}' introuvable.\"}\n",
    "\n",
    "    counts = Counter(df[target_col].dropna())\n",
    "    total = len(df)\n",
    "    majority_class = max(counts, key=counts.get)\n",
    "    majority_count = counts[majority_class]\n",
    "    minority_class = min(counts, key=counts.get)\n",
    "    minority_count = counts[minority_class]\n",
    "\n",
    "    ratios = {cls: count / majority_count for cls, count in counts.items()}\n",
    "    imbalance_ratio = majority_count / minority_count if minority_count > 0 else float('inf')\n",
    "    is_imbalanced = imbalance_ratio > 1.5  # Seuil pour détecter un déséquilibre\n",
    "\n",
    "    return {\n",
    "        \"target_column\": target_col,\n",
    "        \"counts\": dict(counts),\n",
    "        \"ratios\": ratios,\n",
    "        \"majority_class\": majority_class,\n",
    "        \"minority_class\": minority_class,\n",
    "        \"imbalance_ratio\": imbalance_ratio,\n",
    "        \"is_imbalanced\": is_imbalanced,\n",
    "        \"total_samples\": total,\n",
    "        \"n_unique\": len(counts),\n",
    "    }\n",
    "\n",
    "# ----------------------------------------------------------------\n",
    "# Visualisation du déséquilibre pour une colonne\n",
    "# ----------------------------------------------------------------\n",
    "def plot_class_imbalance_for_column(counts: dict, title: str = \"Répartition des classes\") -> None:\n",
    "    \"\"\"Affiche un graphique en barres de la répartition des classes pour une colonne.\"\"\"\n",
    "    plt.figure(figsize=(8, 4))\n",
    "    sns.barplot(x=list(counts.keys()), y=list(counts.values()), palette=\"viridis\")\n",
    "    plt.title(title, fontsize=14, pad=20)\n",
    "    plt.xlabel(\"Classe\", fontsize=12)\n",
    "    plt.ylabel(\"Nombre d'échantillons\", fontsize=12)\n",
    "    plt.xticks(rotation=45)\n",
    "    plt.grid(axis=\"y\", linestyle=\"--\", alpha=0.7)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# ----------------------------------------------------------------\n",
    "# Méthodes de rééquilibrage disponibles\n",
    "# ----------------------------------------------------------------\n",
    "REBALANCING_METHODS = {\n",
    "    \"none\": {\n",
    "        \"name\": \"Aucune action\",\n",
    "        \"description\": \"Ne pas appliquer de rééquilibrage.\",\n",
    "        \"applicable_to\": [\"binary\", \"categorical\"],\n",
    "    },\n",
    "    \"random_undersampling\": {\n",
    "        \"name\": \"Sous-échantillonnage aléatoire\",\n",
    "        \"description\": \"Réduire la classe majoritaire pour égaler la classe minoritaire.\",\n",
    "        \"applicable_to\": [\"binary\", \"categorical\"],\n",
    "    },\n",
    "    \"random_oversampling\": {\n",
    "        \"name\": \"Sur-échantillonnage aléatoire\",\n",
    "        \"description\": \"Dupliquer des échantillons de la classe minoritaire.\",\n",
    "        \"applicable_to\": [\"binary\", \"categorical\"],\n",
    "    },\n",
    "    \"smote\": {\n",
    "        \"name\": \"SMOTE\",\n",
    "        \"description\": \"Génère des échantillons synthétiques pour la classe minoritaire.\",\n",
    "        \"applicable_to\": [\"binary\", \"categorical\"],\n",
    "    },\n",
    "    \"class_weight\": {\n",
    "        \"name\": \"Poids de classe\",\n",
    "        \"description\": \"Utiliser `class_weight='balanced'` dans le modèle.\",\n",
    "        \"applicable_to\": [\"binary\", \"categorical\"],\n",
    "    },\n",
    "}\n",
    "\n",
    "# ----------------------------------------------------------------\n",
    "# Application d'une méthode de rééquilibrage sur une colonne\n",
    "# ----------------------------------------------------------------\n",
    "def apply_rebalancing(df: pd.DataFrame, target_col: str, method: str) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Applique une méthode de rééquilibrage sur un DataFrame pour une colonne cible.\n",
    "    Retourne le DataFrame rééquilibré.\n",
    "    \"\"\"\n",
    "    if method == \"none\":\n",
    "        return df\n",
    "\n",
    "    try:\n",
    "        X = df.drop(columns=[target_col])\n",
    "        y = df[target_col]\n",
    "\n",
    "        if method == \"random_undersampling\":\n",
    "            from imblearn.under_sampling import RandomUnderSampler\n",
    "            resampler = RandomUnderSampler(random_state=42)\n",
    "            X_res, y_res = resampler.fit_resample(X, y)\n",
    "\n",
    "        elif method == \"random_oversampling\":\n",
    "            from imblearn.over_sampling import RandomOverSampler\n",
    "            resampler = RandomOverSampler(random_state=42)\n",
    "            X_res, y_res = resampler.fit_resample(X, y)\n",
    "\n",
    "        elif method == \"smote\":\n",
    "            from imblearn.over_sampling import SMOTE\n",
    "            resampler = SMOTE(random_state=42)\n",
    "            X_res, y_res = resampler.fit_resample(X, y)\n",
    "\n",
    "        elif method == \"class_weight\":\n",
    "            # Pas de modification des données, juste un message\n",
    "            return df\n",
    "\n",
    "        else:\n",
    "            raise ValueError(f\"Méthode inconnue : {method}\")\n",
    "\n",
    "        return pd.concat([X_res, y_res], axis=1)\n",
    "\n",
    "    except ImportError as e:\n",
    "        raise ImportError(f\"Module manquant pour {method} : {e}\")\n",
    "\n",
    "# ----------------------------------------------------------------\n",
    "# Interface pour sélectionner une méthode par colonne\n",
    "# ----------------------------------------------------------------\n",
    "class ColumnRebalancingUI:\n",
    "    def __init__(self, df: pd.DataFrame, target_col: str, analysis: dict):\n",
    "        self.df = df\n",
    "        self.target_col = target_col\n",
    "        self.analysis = analysis\n",
    "        self.method_dropdown = None\n",
    "        self.apply_button = None\n",
    "        self.output = widgets.Output()\n",
    "        self._build_ui()\n",
    "\n",
    "    def _build_ui(self):\n",
    "        \"\"\"Construire l'interface pour une colonne.\"\"\"\n",
    "        # Filtrer les méthodes applicables\n",
    "        applicable_methods = {\n",
    "            k: v for k, v in REBALANCING_METHODS.items()\n",
    "            if self.analysis[\"type\"] in v[\"applicable_to\"]\n",
    "        }\n",
    "        method_options = [(v[\"name\"], k) for k, v in applicable_methods.items()]\n",
    "\n",
    "        self.method_dropdown = widgets.Dropdown(\n",
    "            options=method_options,\n",
    "            value=\"none\",\n",
    "            description=f\"Méthode pour '{self.target_col}':\",\n",
    "            style={\"description_width\": \"initial\"},\n",
    "            layout=widgets.Layout(width=\"400px\"),\n",
    "        )\n",
    "\n",
    "        self.apply_button = widgets.Button(\n",
    "            description=\"Appliquer\",\n",
    "            button_style=\"primary\",\n",
    "            layout=widgets.Layout(width=\"150px\"),\n",
    "        )\n",
    "        self.apply_button.on_click(self._apply_method)\n",
    "\n",
    "        # Afficher les infos de la colonne\n",
    "        info_html = (\n",
    "            f\"<div style='padding:10px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; margin-bottom:10px;'>\"\n",
    "            f\"<h4 style='margin-top:0; color:#1e293b;'>{self.target_col} ({self.analysis['type']})</h4>\"\n",
    "            f\"<p><b>Classe majoritaire :</b> {self.analysis['majority_class']} ({self.analysis['counts'][self.analysis['majority_class']]} échantillons)</p>\"\n",
    "            f\"<p><b>Classe minoritaire :</b> {self.analysis['minority_class']} ({self.analysis['counts'][self.analysis['minority_class']]} échantillons)</p>\"\n",
    "            f\"<p><b>Ratio :</b> {self.analysis['imbalance_ratio']:.2f}:1</p>\"\n",
    "            f\"<p><b>Déséquilibré ?</b> <span style='color: {'#991b1b' if self.analysis['is_imbalanced'] else '#166534'};'>{'Oui' if self.analysis['is_imbalanced'] else 'Non'}</span></p>\"\n",
    "            f\"</div>\"\n",
    "        )\n",
    "\n",
    "        self.ui = widgets.VBox([\n",
    "            widgets.HTML(info_html),\n",
    "            widgets.HBox([self.method_dropdown, self.apply_button]),\n",
    "            self.output,\n",
    "        ])\n",
    "\n",
    "    def _apply_method(self, b):\n",
    "        \"\"\"Applique la méthode sélectionnée et affiche les résultats.\"\"\"\n",
    "        method_key = self.method_dropdown.value\n",
    "        if method_key == \"none\":\n",
    "            with self.output:\n",
    "                clear_output(wait=True)\n",
    "                display(HTML(\"<div style='color:#075985;'>Aucune action appliquée.</div>\"))\n",
    "            return\n",
    "\n",
    "        try:\n",
    "            df_res = apply_rebalancing(self.df, self.target_col, method_key)\n",
    "\n",
    "            with self.output:\n",
    "                clear_output(wait=True)\n",
    "                if method_key == \"class_weight\":\n",
    "                    display(HTML(\n",
    "                        f\"<div style='padding:12px; background:#f0f9ff; border:1px solid #bae6fd; border-radius:6px; color:#075985;'>\"\n",
    "                        f\"Pour utiliser <b>Poids de classe</b>, ajoutez <code>class_weight='balanced'</code> à votre modèle.<br>\"\n",
    "                        f\"Aucune modification des données n'est nécessaire.</div>\"\n",
    "                    ))\n",
    "                else:\n",
    "                    # Afficher les nouveaux comptes\n",
