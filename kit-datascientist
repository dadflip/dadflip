    "# ============================================================\n",
    "# CELLULE 7 — MODÉLISATION COMPLÈTE & AVANCÉE\n",
    "# ============================================================\n",
    "# Fonctionnalités :\n",
    "#   - Détection automatique du type de problème\n",
    "#   - Modèles tabulaires + non tabulaires (texte, image, audio)\n",
    "#   - Hyperparamètres configurables via widgets\n",
    "#   - Courbes d'apprentissage, feature importance, ROC/PR curves\n",
    "#   - Analyse des résidus (régression), matrice de confusion annotée\n",
    "#   - Rapport HTML exportable\n",
    "#   - Comparaison visuelle multi-modèles\n",
    "# ============================================================\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, HTML, clear_output\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "import matplotlib.ticker as mticker\n",
    "import seaborn as sns\n",
    "from sklearn.model_selection import (\n",
    "    train_test_split, learning_curve, StratifiedKFold, KFold\n",
    ")\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score, precision_score, recall_score, f1_score,\n",
    "    roc_auc_score, roc_curve, precision_recall_curve, average_precision_score,\n",
    "    confusion_matrix, classification_report,\n",
    "    mean_squared_error, mean_absolute_error, r2_score\n",
    ")\n",
    "from sklearn.preprocessing import StandardScaler, LabelEncoder, label_binarize\n",
    "from sklearn.inspection import permutation_importance\n",
    "from sklearn.pipeline import Pipeline\n",
    "import warnings, io, base64, time, traceback\n",
    "from collections import Counter\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "# ── Palette cohérente ──────────────────────────────────────────\n",
    "PALETTE = {\n",
    "    \"primary\":   \"#4F46E5\",\n",
    "    \"success\":   \"#10B981\",\n",
    "    \"warning\":   \"#F59E0B\",\n",
    "    \"danger\":    \"#EF4444\",\n",
    "    \"info\":      \"#0EA5E9\",\n",
    "    \"light\":     \"#F8FAFC\",\n",
    "    \"border\":    \"#E2E8F0\",\n",
    "    \"text\":      \"#1E293B\",\n",
    "    \"muted\":     \"#64748B\",\n",
    "    \"card\":      \"#FFFFFF\",\n",
    "}\n",
    "CMAP_SEQ   = \"Blues\"\n",
    "CMAP_DIV   = \"RdYlGn\"\n",
    "MODEL_COLORS = [\n",
    "    \"#4F46E5\", \"#10B981\", \"#F59E0B\", \"#EF4444\", \"#0EA5E9\",\n",
    "    \"#8B5CF6\", \"#EC4899\", \"#14B8A6\", \"#F97316\", \"#84CC16\",\n",
    "]\n",
    "\n",
    "plt.rcParams.update({\n",
    "    \"figure.dpi\": 110,\n",
    "    \"axes.spines.top\": False,\n",
    "    \"axes.spines.right\": False,\n",
    "    \"axes.labelcolor\": PALETTE[\"text\"],\n",
