    "                dd,\n",
    "            ], layout=widgets.Layout(\n",
    "                border_bottom='1px solid #e2e8f0', padding='8px 0',\n",
    "                align_items='center', min_height='48px'\n",
    "            )))\n",
    "\n",
    "        nt_container = widgets.VBox(rows, layout=widgets.Layout(\n",
    "            width='100%', max_height='480px', overflow_y='auto',\n",
    "            border='1px solid #cbd5e1', border_radius='4px', padding='5px'\n",
    "        ))\n",
    "\n",
    "        self.nt_out = widgets.Output()\n",
    "\n",
    "        btn_apply_nt = widgets.Button(\n",
    "            description='Appliquer (non-tabulaire)',\n",
    "            button_style='warning', icon='cogs',\n",
    "            layout=widgets.Layout(width='230px')\n",
    "        )\n",
    "        btn_apply_nt.on_click(self._apply_non_tabular)\n",
    "\n",
    "        return widgets.VBox([\n",
    "            widgets.HTML(\n",
    "                \"<div style='padding:10px; background:#f0f9ff; border:1px solid #bae6fd; \"\n",
    "                \"border-radius:6px; margin-bottom:10px; font-size:13px; color:#075985;'>\"\n",
    "                \"<b>ℹ️ Note :</b> Certaines méthodes nécessitent des dépendances supplémentaires \"\n",
    "                \"(scikit-image, librosa, networkx, sentence-transformers, etc.).</div>\"\n",
    "            ),\n",
    "            nt_container,\n",
    "            widgets.HBox([btn_apply_nt],\n",
    "                         layout=widgets.Layout(margin='10px 0', justify_content='flex-end')),\n",
    "            self.nt_out\n",
    "        ], layout=widgets.Layout(padding='10px'))\n",
    "\n",
    "    # ----------------------------------------------------------------\n",
    "    # Application des encodages\n",
    "    # ----------------------------------------------------------------\n",
    "    def _apply_tabular(self, b):\n",
    "        with self.tab_out:\n",
    "            clear_output(wait=True)\n",
    "            if self.current_ds not in self._tab_row_widgets:\n",
    "                return\n",
    "            df = self.datasets[self.current_ds]\n",
    "            config = {\n",
    "                col: {'strategy': wd['dd_enc'].value}\n",
    "                for col, wd in self._tab_row_widgets[self.current_ds].items()\n",
    "            }\n",
    "            print(\"Traitement tabulaire en cours…\")\n",
    "            try:\n",
    "                df_proc = self._process_tabular(df, config)\n",
    "                self.results[self.current_ds] = df_proc\n",
    "                clear_output(wait=True)\n",
    "                display(HTML(\n",
    "                    f\"<div style='padding:14px; background:#f0fdf4; border:1px solid #bbf7d0; \"\n",
    "                    f\"border-radius:6px;'>\"\n",
    "                    f\"<b style='color:#166534;'>✅ {self.current_ds} encodé — \"\n",
    "                    f\"{df.shape[1]} → {df_proc.shape[1]} colonnes</b></div>\"\n",
    "                ))\n",
    "                display(df_proc.head())\n",
    "            except Exception as e:\n",
    "                import traceback\n",
    "                clear_output(wait=True)\n",
    "                display(HTML(f\"<div style='color:#991b1b; padding:10px;'><b>Erreur :</b> {e}</div>\"))\n",
    "                traceback.print_exc()\n",
    "\n",
    "    def _apply_non_tabular(self, b):\n",
    "        with self.nt_out:\n",
    "            clear_output(wait=True)\n",
    "            summary = []\n",
    "            errors  = []\n",
    "            for key, wd in self._nt_row_widgets.items():\n",
    "                strategy = wd['dd_enc'].value\n",
    "                nt_type  = wd['nt_type']\n",
    "                value    = self.non_tabular[key]\n",
    "                try:\n",
    "                    encoded = NonTabularEncoder.encode(key, value, strategy, nt_type)\n",
    "                    if encoded is None:\n",
    "                        summary.append(f\"<li style='color:#92400e;'>⚠️ <b>{key}</b> — ignoré (drop)</li>\")\n",
    "                    else:\n",
    "                        self.results[key] = encoded\n",
    "                        r_type = type(encoded).__name__\n",
    "                        shape_info = ''\n",
    "                        if hasattr(encoded, 'shape'):\n",
    "                            shape_info = f\" {encoded.shape}\"\n",
    "                        elif isinstance(encoded, pd.DataFrame):\n",
    "                            shape_info = f\" {encoded.shape}\"\n",
    "                        summary.append(\n",
    "                            f\"<li style='color:#166534;'>✅ <b>{key}</b> \"\n",
    "                            f\"[{strategy}] → {r_type}{shape_info}</li>\"\n",
    "                        )\n",
    "                except Exception as e:\n",
    "                    errors.append(f\"<li style='color:#991b1b;'>❌ <b>{key}</b> — {e}</li>\")\n",
    "\n",
    "            items_html = ''.join(summary + errors)\n",
    "            display(HTML(\n",
    "                f\"<div style='padding:14px; background:#f8fafc; border:1px solid #e2e8f0; \"\n",
    "                f\"border-radius:6px;'>\"\n",
    "                f\"<b style='color:#1e293b; font-size:14px;'>Résultats encodage non-tabulaire :</b>\"\n",
    "                f\"<ul style='margin:10px 0 0 20px; font-size:13px;'>{items_html}</ul></div>\"\n",
    "            ))\n",
    "\n",
    "    def _apply_all(self, b):\n",
    "        # Tabulaires\n",
    "        for ds_name in list(self._tab_row_widgets.keys()):\n",
    "            self.current_ds = ds_name\n",
    "            self._apply_tabular(None)\n",
    "        # Non-tabulaires\n",
    "        self._apply_non_tabular(None)\n",
    "        with self.global_out:\n",
    "            clear_output(wait=True)\n",
    "            total = len(self.results)\n",
    "            display(HTML(\n",
    "                f\"<div style='padding:14px; background:#f0fdf4; border:1px solid #bbf7d0; \"\n",
    "                f\"border-radius:6px; margin-top:10px;'>\"\n",
    "                f\"<b style='color:#166534; font-size:15px;'>🎉 Tous les encodages appliqués — \"\n",
    "                f\"{total} dataset(s) dans encoder.results</b></div>\"\n",
    "            ))\n",
    "\n",
    "    # ----------------------------------------------------------------\n",
    "    # Processeur tabulaire (identique à la version originale)\n",
    "    # ----------------------------------------------------------------\n",
    "    def _process_tabular(self, df, config):\n",
    "        from sklearn.preprocessing import LabelEncoder, StandardScaler, MinMaxScaler\n",
    "        from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "\n",
    "        df_out = df.copy()\n",
    "        for col, col_config in config.items():\n",
    "            if col not in df_out.columns:\n",
    "                continue\n",
    "            enc = col_config['strategy']\n",
    "\n",
    "            if enc == 'none':\n",
    "                pass\n",
    "            elif enc == 'drop':\n",
    "                df_out.drop(columns=[col], inplace=True)\n",
    "            elif enc == 'label':\n",
    "                le = LabelEncoder()\n",
    "                df_out[col] = le.fit_transform(df_out[col].astype(str))\n",
    "            elif enc == 'onehot':\n",
    "                dummies = pd.get_dummies(df_out[col], prefix=col, drop_first=True, dtype=int)\n",
    "                df_out  = pd.concat([df_out.drop(columns=[col]), dummies], axis=1)\n",
    "            elif enc == 'freq':\n",
    "                freq = df_out[col].value_counts(normalize=True)\n",
    "                df_out[col] = df_out[col].map(freq).fillna(0)\n",
    "            elif enc in ['tfidf_50', 'tfidf_100']:\n",
    "                max_f = 50 if enc == 'tfidf_50' else 100\n",
    "                vec   = TfidfVectorizer(max_features=max_f)\n",
    "                mat   = vec.fit_transform(df_out[col].astype(str).fillna(''))\n",
    "                cols  = [f\"{col}_tfidf_{i}\" for i in range(mat.shape[1])]\n",
    "                df_out = pd.concat([df_out.drop(columns=[col]),\n",
    "                                    pd.DataFrame(mat.toarray(), columns=cols, index=df_out.index)], axis=1)\n",
    "            elif enc == 'extract_ymd':\n",
    "                s_dt = pd.to_datetime(df_out[col], errors='coerce')\n",
    "                df_out[f\"{col}_year\"]  = s_dt.dt.year.fillna(0).astype('int64')\n",
    "                df_out[f\"{col}_month\"] = s_dt.dt.month.fillna(0).astype('int64')\n",
    "                df_out[f\"{col}_day\"]   = s_dt.dt.day.fillna(0).astype('int64')\n",
    "                df_out.drop(columns=[col], inplace=True)\n",
    "            elif enc == 'epoch':\n",
    "                df_out[col] = pd.to_datetime(df_out[col], errors='coerce').astype('int64') // 10**9\n",
    "            elif enc == 'std':\n",
    "                df_out[col] = StandardScaler().fit_transform(df_out[[col]].fillna(0))\n",
    "            elif enc == 'minmax':\n",
    "                df_out[col] = MinMaxScaler().fit_transform(df_out[[col]].fillna(0))\n",
    "\n",
    "        return df_out\n",
    "\n",
    "    def show(self):\n",
    "        display(self.ui)\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------\n",
    "# Instanciation\n",
