    "        \"JSON (.json)\":                     \"json\",\n",
    "        \"Parquet (.parquet)\":               \"parquet\",\n",
    "        \"Feather (.feather)\":               \"feather\",\n",
    "        \"HDF5 (.h5 / .hdf)\":               \"hdf5\",\n",
