    "if 'normalizer' in locals() and normalizer.results:\n",
    "    btn_export = widgets.Button(description=\"Exporter en CSV\", button_style='primary')\n",
    "    out_exp = widgets.Output()\n",
    "    def on_exp(b):\n",
    "        with out_exp:\n",
    "            clear_output()\n",
    "            export_data(normalizer.results)\n",
    "            display(HTML(\"<b style='color:green;'>Exportation terminée. Les fichiers sont disponibles dans votre environnement.</b>\"))\n",
    "    btn_export.on_click(on_exp)\n",
    "    display(btn_export, out_exp)\n",
