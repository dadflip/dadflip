    "\n",
    "class EDAVisualizerUtils:\n",
    "    \"\"\"Utility class injected into state so other cells (like encode) can reuse these plots.\"\"\"\n",
    "    @staticmethod\n",
    "    def plot_univariate(df, col, kind=None, plot_type=None, bins=30, kde=True, log_scale=False, color='#3b82f6'):\n",
    "        is_num = pd.api.types.is_numeric_dtype(df[col])\n",
    "        if kind is None:\n",
    "            kind = 'numeric' if is_num else 'categorical'\n",
    "                \n",
    "        plt.figure(figsize=(10, 6))\n",
    "        \n",
    "        plot_as_numeric = False\n",
    "        if kind in ['numeric', 'timeseries']:\n",
    "            plot_as_numeric = True\n",
    "        elif kind not in ['categorical', 'binary', 'id_like', 'text'] and is_num:\n",
    "            plot_as_numeric = True\n",
    "            \n",
    "        if plot_as_numeric:\n",
    "            plot_type = plot_type or 'hist'\n",
    "            data = df[col].dropna()\n",
    "            if plot_type == 'hist':\n",
    "                sns.histplot(data, kde=kde, bins=bins, color=color, log_scale=log_scale)\n",
    "            elif plot_type == 'kde':\n",
    "                sns.kdeplot(data, fill=True, color=color, log_scale=log_scale)\n",
    "            elif plot_type == 'box':\n",
    "                sns.boxplot(y=data, color=color)\n",
    "                if log_scale: plt.yscale('log')\n",
    "            elif plot_type == 'violin':\n",
    "                sns.violinplot(y=data, color=color)\n",
    "                if log_scale: plt.yscale('log')\n",
    "            plt.title(f\"Distribution of {col}\")\n",
    "        else:\n",
    "            plot_type = plot_type or 'bar'\n",
    "            val_counts = df[col].value_counts().head(bins)\n",
    "            if plot_type == 'bar':\n",
    "                sns.barplot(y=val_counts.index, x=val_counts.values, palette='viridis')\n",
    "                plt.title(f\"Top {len(val_counts)} Categories for {col}\")\n",
    "            elif plot_type == 'pie':\n",
    "                plt.pie(val_counts.values, labels=val_counts.index, autopct='%1.1f%%',\n",
    "                        colors=sns.color_palette('viridis', len(val_counts)))\n",
    "                plt.title(f\"Top {len(val_counts)} Categories for {col}\")\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    @staticmethod\n",
    "    def plot_bivariate(df, x_col, y_col, x_kind=None, y_kind=None, plot_type=None, hue=None, alpha=0.5, palette='Set2'):\n",
    "        num_dtypes = (pd.api.types.is_numeric_dtype(df[x_col]), pd.api.types.is_numeric_dtype(df[y_col]))\n",
    "        if x_kind is None: x_kind = 'numeric' if num_dtypes[0] else 'categorical'\n",
    "        if y_kind is None: y_kind = 'numeric' if num_dtypes[1] else 'categorical'\n",
    "            \n",
    "        plt.figure(figsize=(10, 6))\n",
    "        \n",
    "        def _is_num_kind(k, is_n):\n",
    "            if k in ['numeric', 'timeseries']: return True\n",
    "            if k not in ['categorical', 'binary', 'id_like', 'text'] and is_n: return True\n",
    "            return False\n",
    "            \n",
    "        x_is_n = _is_num_kind(x_kind, num_dtypes[0])\n",
    "        y_is_n = _is_num_kind(y_kind, num_dtypes[1])\n",
    "        \n",
    "        is_nn = (x_is_n and y_is_n)\n",
    "        is_nc = (x_is_n and not y_is_n)\n",
    "        is_cn = (not x_is_n and y_is_n)\n",
    "        is_cc = (not x_is_n and not y_is_n)\n",
    "        \n",
    "        hue_data = df[hue] if hue and hue in df.columns else None\n",
    "        \n",
    "        if is_nn:\n",
    "            plot_type = plot_type or 'scatter'\n",
    "            if plot_type == 'scatter':\n",
    "                sns.scatterplot(data=df, x=x_col, y=y_col, hue=hue_data, alpha=alpha, palette=palette if hue else None)\n",
    "            elif plot_type == 'hexbin':\n",
    "                plt.hexbin(x=df[x_col], y=df[y_col], gridsize=30, cmap='Blues', mincnt=1)\n",
    "                plt.colorbar(label='count')\n",
    "            elif plot_type == 'hist2d':\n",
    "                sns.histplot(data=df, x=x_col, y=y_col, bins=30, pthresh=.1, cmap='mako', cbar=True)\n",
    "            elif plot_type == 'kde':\n",
    "                sns.kdeplot(data=df, x=x_col, y=y_col, hue=hue_data, fill=True, alpha=alpha, palette=palette)\n",
    "        elif is_cn or is_nc:\n",
    "            plot_type = plot_type or 'box'\n",
    "            c_col = x_col if is_cc or is_cn else y_col\n",
    "            n_col = y_col if is_cc or is_cn else x_col\n",
    "            top_cats = df[c_col].value_counts().nlargest(15).index\n",
    "            plot_df = df[df[c_col].isin(top_cats)]\n",
    "            x_arg, y_arg = (c_col, n_col) if is_cn else (n_col, c_col)\n",
    "            if plot_type == 'box':\n",
    "                sns.boxplot(data=plot_df, x=x_arg, y=y_arg, hue=hue_data, palette=palette)\n",
    "            elif plot_type == 'violin':\n",
    "                sns.violinplot(data=plot_df, x=x_arg, y=y_arg, hue=hue_data, palette=palette)\n",
    "            elif plot_type == 'strip':\n",
    "                sns.stripplot(data=plot_df, x=x_arg, y=y_arg, hue=hue_data, alpha=alpha, palette=palette, dodge=bool(hue))\n",
    "            elif plot_type == 'swarm':\n",
    "                if len(plot_df) > 1000: plot_df = plot_df.sample(1000, random_state=42)\n",
    "                sns.swarmplot(data=plot_df, x=x_arg, y=y_arg, hue=hue_data, palette=palette, dodge=bool(hue))\n",
    "        else:\n",
    "            plot_type = plot_type or 'heatmap'\n",
    "            top_x = df[x_col].value_counts().nlargest(15).index\n",
    "            top_y = df[y_col].value_counts().nlargest(15).index\n",
    "            plot_df = df[df[x_col].isin(top_x) & df[y_col].isin(top_y)]\n",
    "            if plot_type == 'heatmap':\n",
    "                tbl = pd.crosstab(plot_df[y_col], plot_df[x_col])\n",
    "                sns.heatmap(tbl, annot=True, fmt='d', cmap='Blues')\n",
    "            elif plot_type == 'stacked_bar':\n",
    "                tbl = pd.crosstab(plot_df[x_col], plot_df[y_col], normalize='index')\n",
    "                tbl.plot(kind='bar', stacked=True, ax=plt.gca(), colormap='viridis')\n",
    "                plt.legend(title=y_col, bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "                \n",
    "        plt.title(f\"{y_col} vs {x_col}\")\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "\n",
    "class UltimateEDA:\n",
    "    def __init__(self, state):\n",
    "        self.state = state\n",
    "        self.all_datasets = {}\n",
    "        for k, v in self.state.data_raw.items(): self.all_datasets[f\"[RAW] {k}\"] = v\n",
    "        for k, v in getattr(self.state, 'data_cleaned', {}).items(): self.all_datasets[f\"[CLN] {k}\"] = v\n",
    "        for k, v in getattr(self.state, 'data_encoded', {}).items(): self.all_datasets[f\"[ENC] {k}\"] = v\n",
    "        \n",
    "        self.meta = {}\n",
    "        if not hasattr(self.state, 'meta'):\n",
    "            self.state.meta = {}\n",
    "            \n",
    "        for k, v in self.all_datasets.items():\n",
    "            if isinstance(v, pd.DataFrame):\n",
    "                orig_key = k.split(\" \", 1)[1] if \" \" in k else k\n",
    "                if orig_key not in self.state.meta:\n",
    "                    self.state.meta[orig_key] = {}\n",
    "                tabular_types = list(self.state.config.get('encoding', {}).get('tabular', {}).keys()) if hasattr(self.state, 'config') else None\n",
    "                inferred = infer_types(v, available_types=tabular_types)\n",
    "                for col_name, col_info in inferred.items():\n",
    "                    if col_name not in self.state.meta[orig_key]:\n",
    "                        self.state.meta[orig_key][col_name] = col_info\n",
    "                    else:\n",
    "                        user_kind = self.state.meta[orig_key][col_name].get('kind', col_info['kind'])\n",
    "                        self.state.meta[orig_key][col_name].update(col_info)\n",
    "                        self.state.meta[orig_key][col_name]['kind'] = user_kind\n",
    "                self.meta[k] = self.state.meta[orig_key]\n",
    "        \n",
    "        self.state.visualizers = EDAVisualizerUtils()\n",
    "        self.current_ds = None\n",
    "        self._build_ui()\n",
    "        \n",
    "    def _build_ui(self):\n",
    "        if not self.all_datasets:\n",
    "            self.ui = widgets.HTML(\"<div style='padding:12px; color:#b91c1c;'>[WARNING] No dataset available for EDA. Load data in Cell 1b first.</div>\")\n",
    "            return\n",
    "            \n",
    "        self.ds_selector = widgets.Dropdown(\n",
    "            options=list(self.all_datasets.keys()),\n",
    "            description='Dataset:',\n",
    "            layout=widgets.Layout(width='360px')\n",
    "        )\n",
    "        self.ds_selector.observe(self.on_ds_change, names='value')\n",
    "        self.current_ds = self.ds_selector.value\n",
    "        \n",
    "        header = widgets.HTML(\"\"\"\n",
    "            <div style='display:flex; align-items:center; gap:10px; margin-bottom:4px;'>\n",
    "                <span style='font-size:1.3em; font-weight:700; color:#6d28d9;'>EDA</span>\n",
    "                <span style='color:#9ca3af; font-size:0.9em;'>Exploratory Data Analysis</span>\n",
    "            </div>\n",
    "        \"\"\")\n",
    "        \n",
    "        top_bar = widgets.HBox(\n",
    "            [header, widgets.HTML(\"<div style='flex:1'></div>\"), self.ds_selector],\n",
    "            layout=widgets.Layout(\n",
    "                align_items='center',\n",
    "                justify_content='space-between',\n",
    "                margin='0 0 12px 0',\n",
    "                padding='0 0 10px 0',\n",
    "                border_bottom='2px solid #ede9fe'\n",
    "            )\n",
    "        )\n",
    "        \n",
    "        self.dynamic_ui = widgets.VBox([])\n",
    "        self.ui = widgets.VBox(\n",
    "            [top_bar, self.dynamic_ui],\n",
    "            layout=widgets.Layout(\n",
    "                width='100%', max_width='1000px',\n",
    "                border='1px solid #e5e7eb',\n",
    "                padding='18px',\n",
    "                border_radius='10px',\n",
    "                background_color='#ffffff'\n",
    "            )\n",
    "        )\n",
    "        self.on_ds_change(None)\n",
    "\n",
    "    def on_ds_change(self, change):\n",
    "        if change: self.current_ds = change.new\n",
    "        data = self.all_datasets[self.current_ds]\n",
    "        orig_key = self.current_ds.split(\" \", 1)[1] if \" \" in self.current_ds else self.current_ds\n",
    "        ds_type = self.state.data_types.get(orig_key, 'tabular')\n",
    "        \n",
    "        if ds_type in ['tabular', 'sklearn', 'clipboard', 'excel'] or isinstance(data, pd.DataFrame):\n",
    "            self._build_tabular_ui(data)\n",
    "        elif ds_type == 'image':\n",
    "            self._build_image_ui(data)\n",
    "        elif ds_type == 'text':\n",
    "            self._build_text_ui(data)\n",
    "        elif ds_type == 'graph':\n",
    "            self._build_graph_ui(data)\n",
    "        elif ds_type == 'ontology':\n",
    "            self._build_ontology_ui(data)\n",
    "        elif ds_type == 'timeseries':\n",
    "            self._build_timeseries_ui(data)\n",
    "        else:\n",
    "            self.dynamic_ui.children = [widgets.HTML(\n",
    "                f\"<div style='padding:12px;'>[INFO] Non-tabular dataset selected ({ds_type}). Visualisation limited.</div>\"\n",
    "            )]\n",
    "\n",
    "    # -- Tab 0 : Quality & Stats -----------------------------------------------\n",
    "    def _build_tabular_ui(self, df):\n",
    "        self.tabs = widgets.Tab()\n",
    "        cols = list(df.columns)\n",
    "        \n",
    "        # -- Recap tab --------------------------------------------------------\n",
    "        self.out_recap = widgets.Output()\n",
    "\n",
    "        tabular_types = list(self.state.config.get('encoding', {}).get('tabular', {}).keys()) if hasattr(self.state, 'config') else []\n",
    "        if not tabular_types:\n",
    "            tabular_types = ['numeric', 'categorical', 'datetime', 'binary', 'id_like', 'text']\n",
    "            \n",
    "        self.type_col_dd  = widgets.Dropdown(options=cols,         description='Column:', layout=_W_DD)\n",
    "        self.type_kind_dd = widgets.Dropdown(options=tabular_types, description='-> type:',  layout=_W_DD_S)\n",
    "        self.type_btn     = widgets.Button(description='Update', button_style='warning', layout=_W_BTN)\n",
    "        self.type_msg     = widgets.HTML(\"\")\n",
    "\n",
    "        def _update_kind_dd(change):\n",
    "            if self.type_col_dd.value:\n",
    "                self.type_kind_dd.value = self.meta[self.current_ds][self.type_col_dd.value]['kind']\n",
    "        self.type_col_dd.observe(_update_kind_dd, names='value')\n",
    "        if cols: _update_kind_dd(None)\n",
    "        \n",
    "        def _on_type_update(b):\n",
    "            col, new_kind = self.type_col_dd.value, self.type_kind_dd.value\n",
    "            orig_key = self.current_ds.split(\" \", 1)[1] if \" \" in self.current_ds else self.current_ds\n",
    "            self.state.meta[orig_key][col]['kind'] = new_kind\n",
    "            self.meta[self.current_ds][col]['kind'] = new_kind\n",
    "            self.type_msg.value = f\"<span style='color:#059669; font-size:0.85em;'>[OK] '{col}' -> {new_kind}</span>\"\n",
    "            self._fill_recap_tab(df)\n",
    "        self.type_btn.on_click(_on_type_update)\n",
    "\n",
    "        self.btn_missing = widgets.Button(description='Plot Missing', button_style='info', layout=_W_BTN)\n",
    "        self.btn_missing.on_click(lambda b: self._plot_missing(df))\n",
    "\n",
    "        help_recap = _help_box(\n",
    "            \"<b>Column Metadata:</b> data types, inferred kinds, missing rates.<br>\"\n",
    "            \"<b>Missing Values:</b> click 'Plot Missing' to visualize gaps - high rates may need imputation.<br>\"\n",
    "            \"<b>Statistics:</b> spot anomalies, scale differences, and value ranges.<br>\"\n",
    "            \"<b>Override Type:</b> correct any mis-inferred column type using the dropdowns.\",\n",
    "            '#3b82f6'\n",
    "        )\n",
    "\n",
    "        type_row = widgets.HBox(\n",
    "            [self.type_col_dd, self.type_kind_dd, self.type_btn, self.type_msg],\n",
    "            layout=widgets.Layout(align_items='center', gap='8px', margin='0 0 10px 0')\n",
    "        )\n",
    "        action_row = widgets.HBox(\n",
    "            [self.btn_missing],\n",
    "            layout=widgets.Layout(margin='8px 0 0 0')\n",
    "        )\n",
    "        tab_recap = widgets.VBox([help_recap, type_row, _SEP, self.out_recap, action_row])\n",
    "\n",
    "        # -- Univariate tab ---------------------------------------------------\n",
    "        self.uni_col  = widgets.Dropdown(options=cols, description='Variable:', layout=_W_DD)\n",
    "        self.uni_type = widgets.Dropdown(\n",
    "            options=['auto', 'hist', 'kde', 'box', 'violin', 'bar', 'pie'],\n",
    "            value='auto', description='Plot:', layout=_W_DD_S\n",
    "        )\n",
    "        self.uni_bins = widgets.IntSlider(value=30, min=5, max=100, description='Bins/Top N:', layout=_W_SL)\n",
    "        self.uni_kde  = widgets.Checkbox(value=True,  description='KDE',       layout=_W_CB)\n",
    "        self.uni_log  = widgets.Checkbox(value=False, description='Log scale', layout=widgets.Layout(width='105px'))\n",
    "        self.uni_btn  = widgets.Button(description='Plot', button_style='primary', layout=_W_BTN)\n",
    "        self.uni_out  = widgets.Output()\n",
    "        self.uni_btn.on_click(lambda b: self._plot_uni(df))\n",
    "\n",
    "        help_uni = _help_box(\n",
    "            \"<b>Numeric:</b> Histogram / KDE for shape & skewness - Box/Violin for outliers & quartiles.<br>\"\n",
    "            \"<b>Categorical:</b> Bar or Pie chart for frequency of each category.<br>\"\n",
    "            \"<b>Bins:</b> histogram granularity (or top-N for categorical).<br>\"\n",
    "            \"<b>Log Scale:</b> useful for data spanning multiple orders of magnitude.\",\n",
    "            '#8b5cf6'\n",
    "        )\n",
    "\n",
    "        uni_row1 = widgets.HBox([self.uni_col, self.uni_type, self.uni_bins],\n",
    "                                layout=widgets.Layout(align_items='flex-end', gap='10px'))\n",
    "        uni_row2 = widgets.HBox([self.uni_kde, self.uni_log, self.uni_btn],\n",
    "                                layout=widgets.Layout(align_items='center', gap='10px', margin='6px 0 0 0'))\n",
    "        tab_uni = widgets.VBox([help_uni, uni_row1, uni_row2, self.uni_out])\n",
    "\n",
    "        # -- Bivariate tab ----------------------------------------------------\n",
    "        self.bi_x     = widgets.Dropdown(options=cols,                          description='X:', layout=_W_DD)\n",
    "        self.bi_y     = widgets.Dropdown(options=cols,                          description='Y:', layout=_W_DD)\n",
    "        self.bi_type  = widgets.Dropdown(\n",
    "            options=['auto','scatter','hexbin','hist2d','kde','box','violin','strip','swarm','heatmap','stacked_bar'],\n",
    "            value='auto', description='Plot:', layout=_W_DD_S\n",
    "        )\n",
    "        self.bi_hue   = widgets.Dropdown(options=['None'] + cols, value='None', description='Hue:', layout=_W_DD_S)\n",
    "        self.bi_alpha = widgets.FloatSlider(value=0.6, min=0.1, max=1.0, step=0.1,\n",
    "                                            description='Alpha:', layout=_W_SL)\n",
    "        self.bi_pal   = widgets.Dropdown(\n",
    "            options=['Set1','Set2','Set3','viridis','plasma','coolwarm','husl'],\n",
    "            value='Set2', description='Palette:', layout=_W_DD_S\n",
    "        )\n",
    "        self.bi_btn   = widgets.Button(description='Plot', button_style='primary', layout=_W_BTN)\n",
    "        self.bi_out   = widgets.Output()\n",
    "        self.bi_btn.on_click(lambda b: self._plot_bi(df))\n",
    "\n",
    "        help_bi = _help_box(\n",
    "            \"<b>Num x Num:</b> Scatter (trend/clusters) - Hexbin/Hist2D (dense data) - KDE (density).<br>\"\n",
    "            \"<b>Num x Cat:</b> Box, Violin, Strip, Swarm - compare distributions across groups.<br>\"\n",
    "            \"<b>Cat x Cat:</b> Heatmap or Stacked Bar - frequency associations.<br>\"\n",
    "            \"<b>Hue:</b> adds a 3rd categorical dimension via color.\",\n",
    "            '#10b981'\n",
    "        )\n",
    "\n",
    "        bi_row1 = widgets.HBox([self.bi_x, self.bi_y, self.bi_type],\n",
    "                               layout=widgets.Layout(align_items='flex-end', gap='10px'))\n",
    "        bi_row2 = widgets.HBox([self.bi_hue, self.bi_pal, self.bi_alpha],\n",
    "                               layout=widgets.Layout(align_items='flex-end', gap='10px', margin='6px 0 0 0'))\n",
    "        bi_row3 = widgets.HBox([self.bi_btn], layout=widgets.Layout(margin='8px 0 0 0'))\n",
    "        tab_bi  = widgets.VBox([help_bi, bi_row1, bi_row2, bi_row3, self.bi_out])\n",
    "\n",
    "        # -- Multivariate tab -------------------------------------------------\n",
    "        self.multi_type = widgets.Dropdown(\n",
    "            options=['Correlation Matrix', 'Pairplot'],\n",
    "            value='Correlation Matrix', description='Analysis:', layout=_W_DD\n",
    "        )\n",
    "        self.multi_hue  = widgets.Dropdown(options=['None'] + cols, value='None',\n",
    "                                           description='Hue (Pair):', layout=_W_DD_S)\n",
    "        self.multi_corr = widgets.Dropdown(options=['pearson', 'spearman', 'kendall'],\n",
    "                                           value='pearson', description='Method:', layout=_W_DD_S)\n",
    "\n",
    "        meta = self.meta[self.current_ds]\n",
    "        available_kinds = set()\n",
    "        self.multi_col_boxes = {}\n",
    "        for c in cols:\n",
    "            k = meta[c]['kind']\n",
    "            available_kinds.add(k)\n",
    "            self.multi_col_boxes[c] = widgets.Checkbox(\n",
    "                value=bool(pd.api.types.is_numeric_dtype(df[c])),\n",
    "                description=f\"{c} [{k}]\",\n",
    "                style={'description_width': 'initial'},\n",
    "                layout=widgets.Layout(width='auto', margin='1px 4px')\n",
    "            )\n",
    "\n",
    "        btn_layout = widgets.Layout(width='auto', height='26px', margin='2px')\n",
    "        select_btns = []\n",
    "        for k in sorted(available_kinds):\n",
    "            btn = widgets.Button(description=f\"All {k}\", button_style='info', layout=btn_layout)\n",
    "            def _make_selector(kind):\n",
    "                def _select(*args):\n",
    "                    for c_name, cb in self.multi_col_boxes.items():\n",
    "                        cb.value = (meta[c_name]['kind'] == kind)\n",
    "                return _select\n",
    "            btn.on_click(_make_selector(k))\n",
    "            select_btns.append(btn)\n",
    "        btn_none = widgets.Button(description=\"Clear all\", button_style='warning', layout=btn_layout)\n",
    "        btn_none.on_click(lambda *a: [setattr(cb, 'value', False) for cb in self.multi_col_boxes.values()])\n",
    "        select_btns.append(btn_none)\n",
    "\n",
    "        select_btns_box = widgets.GridBox(\n",
    "            select_btns,\n",
    "            layout=widgets.Layout(\n",
    "                grid_template_columns='repeat(auto-fill, minmax(100px, 1fr))',\n",
    "                grid_gap='4px', margin='4px 0 8px 0'\n",
    "            )\n",
    "        )\n",
    "        col_boxes_grid = widgets.GridBox(\n",
    "            list(self.multi_col_boxes.values()),\n",
    "            layout=widgets.Layout(\n",
    "                grid_template_columns='repeat(auto-fill, minmax(170px, 1fr))',\n",
    "                grid_gap='2px'\n",
    "            )\n",
    "        )\n",
    "        self.multi_cols_container = widgets.VBox(\n",
    "            [\n",
    "                widgets.HTML(\"<div style='font-size:0.82em; font-weight:600; color:#6b7280; margin-bottom:4px;'>COLUMNS</div>\"),\n",
    "                select_btns_box,\n",
    "                col_boxes_grid\n",
    "            ],\n",
    "            layout=widgets.Layout(\n",
    "                max_height='230px', overflow_y='auto',\n",
    "                border='1px solid #e5e7eb', border_radius='6px',\n",
    "                padding='10px', margin='8px 0'\n",
    "            )\n",
    "        )\n",
    "\n",
    "        self.multi_btn = widgets.Button(\n",
    "            description='Generate Plot',\n",
    "            button_style='primary',\n",
    "            layout=widgets.Layout(width='160px', height='32px', margin='4px 0 8px 0')\n",
    "        )\n",
    "        self.multi_out = widgets.Output()\n",
    "        self.multi_btn.on_click(lambda b: self._plot_multivariate(df))\n",
    "\n",
    "        help_multi = _help_box(\n",
    "            \"<b>Correlation Matrix:</b> pairwise correlations. Pearson = linear; Spearman/Kendall = rank (non-linear). \"\n",
    "            \"Values near +/-1 = strong, near 0 = weak.<br>\"\n",
    "            \"<b>Pairplot:</b> matrix of scatter + histograms. Slow with >10 columns - first 10 will be used.<br>\"\n",
    "            \"<i>Numeric columns are pre-selected by default.</i>\",\n",
    "            '#f59e0b'\n",
    "        )\n",
    "\n",
    "        multi_row1 = widgets.HBox(\n",
    "            [self.multi_type, self.multi_hue, self.multi_corr],\n",
    "            layout=widgets.Layout(align_items='flex-end', gap='10px', margin='0 0 4px 0')\n",
    "        )\n",
    "        tab_multi = widgets.VBox([help_multi, multi_row1, self.multi_cols_container, self.multi_btn, self.multi_out])\n",
    "\n",
    "        # -- Assemble tabs ----------------------------------------------------\n",
    "        self.tabs.children = [tab_recap, tab_uni, tab_bi, tab_multi]\n",
    "        for i, title in enumerate(['Quality & Stats', 'Univariate', 'Bivariate', 'Multivariate']):\n",
    "            self.tabs.set_title(i, title)\n",
    "        self.dynamic_ui.children = [self.tabs]\n",
    "        self._fill_recap_tab(df)\n",
    "\n",
    "    def _fill_recap_tab(self, df):\n",
    "        with self.out_recap:\n",
    "            clear_output()\n",
    "            meta = self.meta[self.current_ds]\n",
    "            rows = [\n",
    "                {'Variable': c, 'Type': m['kind'],\n",
    "                 'Missing': f\"{m['missing']} ({m['pct_miss']:.1f}%)\",\n",
    "                 'Unique': m['n_unique'], 'Dtype': m['dtype']}\n",
    "                for c, m in meta.items()\n",
    "            ]\n",
    "            display(HTML(\"<b style='color:#374151; font-size:0.9em;'>Column Metadata</b>\"))\n",
    "            display(pd.DataFrame(rows).set_index('Variable'))\n",
    "            \n",
    "            num_cols = df.select_dtypes(include=np.number)\n",
    "            cat_cols = df.select_dtypes(include=['object', 'category'])\n",
    "            if not num_cols.empty:\n",
    "                display(HTML(\"<br><b style='color:#374151; font-size:0.9em;'>Numerical Statistics</b>\"))\n",
    "                display(num_cols.describe().T)\n",
    "            if not cat_cols.empty:\n",
    "                display(HTML(\"<br><b style='color:#374151; font-size:0.9em;'>Categorical Statistics</b>\"))\n",
    "                display(cat_cols.describe().T)\n",
    "\n",
    "    def _plot_missing(self, df):\n",
    "        with self.out_recap:\n",
    "            plt.figure(figsize=(10, 5))\n",
    "            missing = df.isna().sum()\n",
    "            missing = missing[missing > 0]\n",
    "            if missing.empty:\n",
    "                print(\"[OK] No missing values found.\")\n",
    "            else:\n",
    "                missing.sort_values(ascending=False).plot(kind='bar', color='#ef4444')\n",
    "                plt.title(\"Missing Values per Feature\")\n",
    "                plt.ylabel(\"Count\")\n",
    "                plt.tight_layout()\n",
    "                plt.show()\n",
    "\n",
    "    def _plot_uni(self, df):\n",
    "        with self.uni_out:\n",
    "            clear_output(wait=True)\n",
    "            col   = self.uni_col.value\n",
    "            kind  = self.meta[self.current_ds][col]['kind']\n",
    "            p_type = None if self.uni_type.value == 'auto' else self.uni_type.value\n",
    "            EDAVisualizerUtils.plot_univariate(\n",
    "                df, col, kind, plot_type=p_type,\n",
    "                bins=self.uni_bins.value, kde=self.uni_kde.value, log_scale=self.uni_log.value\n",
    "            )\n",
    "\n",
    "    def _plot_bi(self, df):\n",
    "        with self.bi_out:\n",
    "            clear_output(wait=True)\n",
    "            x_col, y_col = self.bi_x.value, self.bi_y.value\n",
    "            if x_col == y_col:\n",
    "                print(\"[INFO] Please select two different variables.\")\n",
    "                return\n",
    "            x_kind = self.meta[self.current_ds][x_col]['kind']\n",
    "            y_kind = self.meta[self.current_ds][y_col]['kind']\n",
    "            p_type = None if self.bi_type.value == 'auto' else self.bi_type.value\n",
    "            h      = None if self.bi_hue.value == 'None' else self.bi_hue.value\n",
    "            with warnings.catch_warnings():\n",
    "                warnings.simplefilter(\"ignore\")\n",
    "                EDAVisualizerUtils.plot_bivariate(\n",
    "                    df, x_col, y_col, x_kind, y_kind,\n",
    "                    plot_type=p_type, hue=h, alpha=self.bi_alpha.value, palette=self.bi_pal.value\n",
    "                )\n",
    "\n",
    "    def _plot_multivariate(self, df):\n",
    "        with self.multi_out:\n",
    "            clear_output(wait=True)\n",
    "            m_type = self.multi_type.value\n",
    "            cols   = [c for c, cb in self.multi_col_boxes.items() if cb.value]\n",
    "            if not cols:\n",
    "                print(\"[INFO] Please select at least one column.\")\n",
    "                return\n",
    "            if m_type == 'Correlation Matrix':\n",
    "                num_cols = [c for c in cols if pd.api.types.is_numeric_dtype(df[c])]\n",
    "                if len(num_cols) < 2:\n",
    "                    print(f\"[INFO] Need at least 2 numeric columns (got {len(num_cols)}).\")\n",
    "                    return\n",
    "                corr = df[num_cols].corr(method=self.multi_corr.value)\n",
    "                plt.figure(figsize=(min(max(len(num_cols)*0.8, 8), 16),\n",
    "                                    min(max(len(num_cols)*0.6, 6), 12)))\n",
    "                sns.heatmap(corr, annot=len(num_cols)<=12, cmap='coolwarm', fmt=\".2f\", center=0, square=True)\n",
    "                plt.title(f\"{self.multi_corr.value.capitalize()} Correlation Matrix\")\n",
    "                plt.tight_layout()\n",
    "                plt.show()\n",
    "            elif m_type == 'Pairplot':\n",
    "                if len(cols) > 10:\n",
    "                    print(\"[WARNING] More than 10 columns - using first 10.\")\n",
    "                    cols = list(cols)[:10]\n",
    "                h = None if self.multi_hue.value == 'None' else self.multi_hue.value\n",
    "                cols_to_plot = cols + [h] if (h and h not in cols) else cols\n",
    "                with warnings.catch_warnings():\n",
    "                    warnings.simplefilter(\"ignore\")\n",
    "                    sns.pairplot(df[cols_to_plot].dropna(), hue=h, palette='Set2')\n",
    "                    plt.show()\n",
    "\n",
    "    # -- Non-tabular UIs (unchanged logic, tidy layout) -----------------------\n",
    "    def _build_image_ui(self, img):\n",
    "        out = widgets.Output()\n",
    "        self.dynamic_ui.children = [out]\n",
    "        with out:\n",
    "            print(f\"Format: {getattr(img, 'format', 'Unknown')}  |  \"\n",
    "                  f\"Size: {getattr(img, 'size', 'Unknown')}  |  \"\n",
    "                  f\"Mode: {getattr(img, 'mode', 'Unknown')}\")\n",
    "            if hasattr(img, 'size'):\n",
    "                scale = min(400 / max(img.size[0], 1), 1)\n",
    "                new_size = (int(img.size[0] * scale), int(img.size[1] * scale))\n",
    "                from IPython.display import Image as IPyImage\n",
    "                import io\n",
    "                buf = io.BytesIO()\n",
    "                preview_img = img if img.mode == 'RGB' else img.convert('RGB')\n",
    "                preview_img.resize(new_size).save(buf, format='JPEG')\n",
    "                display(IPyImage(data=buf.getvalue()))\n",
    "\n",
    "    def _build_text_ui(self, text):\n",
    "        out = widgets.Output()\n",
    "        self.dynamic_ui.children = [out]\n",
    "        with out:\n",
    "            print(f\"Length: {len(text)} characters\\n--- Preview ---\")\n",
    "            print(text[:2000] + (\"\\n... [TRUNCATED]\" if len(text) > 2000 else \"\"))\n",
    "\n",
    "    def _build_graph_ui(self, G):\n",
    "        out = widgets.Output()\n",
    "        self.dynamic_ui.children = [out]\n",
    "        with out:\n",
    "            import networkx as nx\n",
    "            print(f\"Nodes: {G.number_of_nodes()}  |  Edges: {G.number_of_edges()}  |  Directed: {G.is_directed()}\")\n",
    "            plt.figure(figsize=(10, 5))\n",
    "            plt.subplot(1, 2, 1)\n",
    "            degrees = [d for n, d in G.degree()]\n",
    "            sns.histplot(degrees, bins=30, kde=True, color='#10b981')\n",
    "            plt.title(\"Node Degree Distribution\"); plt.xlabel(\"Degree\")\n",
    "            plt.subplot(1, 2, 2)\n",
    "            sub_nodes = list(G.nodes())[:100]\n",
    "            H = G.subgraph(sub_nodes)\n",
    "            nx.draw(H, node_size=20, alpha=0.6, edge_color='#9ca3af', node_color='#3b82f6')\n",
    "            plt.title(\"Graph Sample (100 nodes)\")\n",
    "            plt.tight_layout(); plt.show()\n",
    "\n",
    "    def _build_ontology_ui(self, g):\n",
    "        out = widgets.Output()\n",
    "        self.dynamic_ui.children = [out]\n",
    "        with out:\n",
    "            print(f\"Ontology  |  Triples: {len(g)}\")\n",
    "            try:\n",
    "                from rdflib.namespace import OWL, RDF\n",
    "                classes = list(g.subjects(RDF.type, OWL.Class))\n",
    "                props_obj = list(g.subjects(RDF.type, OWL.ObjectProperty))\n",
    "                props_dt = list(g.subjects(RDF.type, OWL.DatatypeProperty))\n",
    "                inds = list(g.subjects(RDF.type, OWL.NamedIndividual))\n",
    "                print(f\"Classes: {len(classes)}  |  Object Properties: {len(props_obj)}  |  Data Properties: {len(props_dt)}  |  Individuals: {len(inds)}\")\n",
    "                print(\"\\nSample Classes:\")\n",
    "                for c in classes[:10]:\n",
    "                    print(\" -\", getattr(c, \"n3\", lambda: str(c))())\n",
    "            except Exception as e:\n",
    "                print(\"Could not analyze ontology structure:\", e)\n",
    "\n",
    "    def _build_timeseries_ui(self, df):\n",
    "        if not isinstance(df, pd.DataFrame):\n",
    "            self.dynamic_ui.children = [widgets.HTML(\"<div style='padding:12px;'>Time series is not in DataFrame format.</div>\")]\n",
    "            return\n",
    "\n",
    "        num_cols = list(df.select_dtypes(include=np.number).columns)\n",
    "        all_cols = list(df.columns)\n",
    "\n",
    "        self.ts_col      = widgets.Dropdown(options=num_cols,                          description='Measurement:', layout=_W_DD)\n",
    "        self.ts_time_col = widgets.Dropdown(options=['Index'] + all_cols, value='Index', description='Time Col:',    layout=_W_DD)\n",
    "        self.ts_type     = widgets.Dropdown(\n",
    "            options=['Line', 'Scatter', 'Area', 'Box (by month/year)', 'Autocorrelation'],\n",
    "            value='Line', description='Plot Type:', layout=_W_DD\n",
    "        )\n",
    "        self.ts_window   = widgets.IntSlider(value=1, min=1, max=365, description='Rolling Window:', layout=_W_SL)\n",
    "        self.ts_btn      = widgets.Button(description='Plot', button_style='primary', layout=_W_BTN)\n",
    "        self.ts_out      = widgets.Output()\n",
    "        self.ts_btn.on_click(lambda b: self._plot_timeseries(df))\n",
    "\n",
    "        help_ts = _help_box(\n",
    "            \"<b>Line/Area:</b> track change over time. Rolling Window > 1 smooths noise to reveal trends.<br>\"\n",
    "            \"<b>Box (by month/year):</b> requires datetime index - spots seasonal patterns.<br>\"\n",
    "            \"<b>Autocorrelation:</b> relationship between a value and its lagged self. Strong linearity = high predictability.\",\n",
    "            '#06b6d4'\n",
    "        )\n",
    "\n",
    "        ts_row1 = widgets.HBox([self.ts_time_col, self.ts_col],\n",
    "                               layout=widgets.Layout(align_items='flex-end', gap='10px'))\n",
    "        ts_row2 = widgets.HBox([self.ts_type, self.ts_window, self.ts_btn],\n",
    "                               layout=widgets.Layout(align_items='flex-end', gap='10px', margin='6px 0 0 0'))\n",
    "        self.dynamic_ui.children = [widgets.VBox([help_ts, ts_row1, ts_row2, self.ts_out])]\n",
    "\n",
    "    def _plot_timeseries(self, df):\n",
    "        with self.ts_out:\n",
    "            clear_output(wait=True)\n",
    "            col, time_col = self.ts_col.value, self.ts_time_col.value\n",
    "            p_type, window = self.ts_type.value, self.ts_window.value\n",
    "            if not col:\n",
    "                print(\"Please select a measurement column.\")\n",
    "                return\n",
    "            plt.figure(figsize=(12, 6))\n",
    "            s = df[col] if time_col == 'Index' else df.set_index(time_col)[col]\n",
    "            s = s.dropna()\n",
    "            x, y = s.index, s.values\n",
    "            if window > 1:\n",
    "                y = s.rolling(window).mean().values\n",
    "            if p_type == 'Line':\n",
    "                plt.plot(x, y, color='#3b82f6', label=f\"{col} (window={window})\")\n",
    "                plt.legend()\n",
    "            elif p_type == 'Scatter':\n",
    "                plt.scatter(x, y, color='#8b5cf6', alpha=0.5, s=10)\n",
    "            elif p_type == 'Area':\n",
    "                plt.fill_between(x, y, color='#10b981', alpha=0.3)\n",
    "                plt.plot(x, y, color='#10b981')\n",
    "            elif p_type == 'Box (by month/year)':\n",
    "                if not pd.api.types.is_datetime64_any_dtype(s.index):\n",
    "                    print(\"Index must be datetime for seasonal box plot.\")\n",
    "                    return\n",
    "                sns.boxplot(x=s.index.month, y=y, palette='Set2')\n",
    "                plt.xlabel(\"Month\")\n",
    "            elif p_type == 'Autocorrelation':\n",
    "                lag = window\n",
    "                plt.scatter(y[:-lag], y[lag:], alpha=0.5)\n",
    "                plt.xlabel(\"y(t)\"); plt.ylabel(f\"y(t+{lag})\")\n",
    "                plt.title(f\"Autocorrelation (lag={lag})\")\n",
    "            if p_type != 'Autocorrelation':\n",
    "                plt.title(f\"Time Series: {col}\")\n",
    "                plt.xlabel(\"Time\"); plt.ylabel(col)\n",
    "            plt.tight_layout(); plt.show()\n",
    "\n",
    "\n",
    "def runner(state):\n",
    "    eda = UltimateEDA(state)\n",
    "    display(eda.ui)\n",
    "    return eda\n",
    "\n",
    "try:\n",
    "    runner(state)\n",
    "except NameError:\n",
    "    pass"
