    "# ----------------------------------------------------------------\n",
    "# Processeurs d'encodage non-tabulaires\n",
    "# ----------------------------------------------------------------\n",
    "class NonTabularEncoder:\n",
    "    \"\"\"Applique les transformations d'encodage pour les données non-tabulaires.\"\"\"\n",
    "\n",
    "    @staticmethod\n",
    "    def encode(key: str, value, strategy: str, nt_type: str):\n",
    "        if strategy == 'none':\n",
    "            return value\n",
    "        if strategy == 'drop':\n",
    "            return None\n",
    "\n",
    "        try:\n",
    "            if nt_type == 'image':\n",
    "                return NonTabularEncoder._encode_image(value, strategy)\n",
    "            elif nt_type == 'text':\n",
    "                return NonTabularEncoder._encode_text(value, strategy)\n",
    "            elif nt_type == 'graph':\n",
    "                return NonTabularEncoder._encode_graph(value, strategy)\n",
    "            elif nt_type == 'audio':\n",
    "                return NonTabularEncoder._encode_audio(value, strategy)\n",
    "            elif nt_type == 'timeseries':\n",
    "                return NonTabularEncoder._encode_timeseries(value, strategy)\n",
    "            elif nt_type == 'embedding':\n",
    "                return NonTabularEncoder._encode_embedding(value, strategy)\n",
    "            elif nt_type == 'document':\n",
    "                return NonTabularEncoder._encode_document(value, strategy)\n",
    "        except ImportError as e:\n",
    "            raise ImportError(f\"Module manquant pour '{strategy}': {e}\")\n",
    "        return value\n",
    "\n",
    "    # ---- Image ----\n",
    "    @staticmethod\n",
    "    def _encode_image(value, strategy):\n",
    "        import numpy as np\n",
    "        arr = np.array(value) if not isinstance(value, np.ndarray) else value.copy()\n",
    "\n",
    "        if strategy == 'flatten':\n",
    "            return arr.flatten()\n",
    "\n",
    "        elif strategy == 'normalize_01':\n",
    "            return (arr.astype(float) / 255.0) if arr.max() > 1 else arr.astype(float)\n",
    "\n",
    "        elif strategy == 'normalize_imagenet':\n",
    "            mean = np.array([0.485, 0.456, 0.406])\n",
    "            std  = np.array([0.229, 0.224, 0.225])\n",
    "            a    = (arr.astype(float) / 255.0) if arr.max() > 1 else arr.astype(float)\n",
    "            return (a - mean) / std\n",
    "\n",
    "        elif strategy == 'color_histogram':\n",
    "            if arr.ndim == 2:\n",
    "                hist, _ = np.histogram(arr.flatten(), bins=64, range=(0, 256))\n",
    "                return hist.astype(float) / hist.sum()\n",
    "            else:\n",
    "                hists = []\n",
    "                for c in range(arr.shape[2]):\n",
    "                    h, _ = np.histogram(arr[:, :, c].flatten(), bins=64, range=(0, 256))\n",
    "                    hists.append(h.astype(float) / h.sum())\n",
    "                return np.concatenate(hists)\n",
    "\n",
    "        elif strategy == 'hog':\n",
    "            from skimage.feature import hog\n",
    "            if arr.ndim == 3:\n",
    "                from skimage.color import rgb2gray\n",
    "                arr_gray = rgb2gray(arr)\n",
    "            else:\n",
    "                arr_gray = arr\n",
    "            features, _ = hog(arr_gray, orientations=8, pixels_per_cell=(16, 16),\n",
    "                               cells_per_block=(1, 1), visualize=True)\n",
    "            return features\n",
    "\n",
    "        elif strategy == 'lbp':\n",
    "            from skimage.feature import local_binary_pattern\n",
    "            from skimage.color import rgb2gray\n",
    "            arr_gray = rgb2gray(arr) if arr.ndim == 3 else arr\n",
    "            lbp = local_binary_pattern(arr_gray, P=8, R=1, method='uniform')\n",
    "            hist, _ = np.histogram(lbp.flatten(), bins=10, range=(0, 10))\n",
    "            return hist.astype(float) / hist.sum()\n",
    "\n",
    "        elif strategy in ('cnn_resnet50', 'cnn_vgg16', 'cnn_mobilenet'):\n",
    "            import torch\n",
    "            from torchvision import models, transforms\n",
    "            from PIL import Image\n",
    "\n",
    "            model_map = {\n",
    "                'cnn_resnet50':  models.resnet50,\n",
    "                'cnn_vgg16':     models.vgg16,\n",
    "                'cnn_mobilenet': models.mobilenet_v2,\n",
    "            }\n",
    "            model = model_map[strategy](pretrained=True)\n",
    "            model.eval()\n",
    "            if hasattr(model, 'fc'):       model.fc       = torch.nn.Identity()\n",
    "            elif hasattr(model, 'classifier'): model.classifier = torch.nn.Identity()\n",
    "\n",
    "            tf = transforms.Compose([\n",
    "                transforms.Resize((224, 224)),\n",
    "                transforms.ToTensor(),\n",
    "                transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])\n",
    "            ])\n",
    "            pil_img = Image.fromarray(arr.astype(np.uint8)) if isinstance(arr, np.ndarray) else arr\n",
    "            tensor  = tf(pil_img).unsqueeze(0)\n",
    "            with torch.no_grad():\n",
    "                return model(tensor).squeeze().numpy()\n",
    "\n",
    "        elif strategy == 'pca_pixels':\n",
    "            from sklearn.decomposition import PCA\n",
    "            flat = arr.flatten().reshape(1, -1).astype(float)\n",
    "            pca  = PCA(n_components=50)\n",
    "            return pca.fit_transform(flat).flatten()\n",
    "\n",
    "        elif strategy == 'phash':\n",
    "            from PIL import Image\n",
    "            import hashlib\n",
    "            pil_img = Image.fromarray(arr.astype(np.uint8)) if isinstance(arr, np.ndarray) else arr\n",
    "            img_s   = pil_img.convert('L').resize((8, 8), Image.LANCZOS)\n",
    "            pixels  = np.array(img_s).flatten()\n",
    "            avg     = pixels.mean()\n",
    "            bits    = (pixels > avg).astype(int)\n",
    "            return bits\n",
    "\n",
    "        return arr\n",
    "\n",
    "    # ---- Texte ----\n",
    "    @staticmethod\n",
    "    def _encode_text(value, strategy):\n",
    "        import numpy as np\n",
    "        # Normalisation : liste ou Series → liste de strings\n",
    "        if isinstance(value, pd.Series):\n",
    "            corpus = value.astype(str).fillna('').tolist()\n",
    "        elif isinstance(value, str):\n",
    "            corpus = [value]\n",
    "        elif isinstance(value, list):\n",
    "            corpus = [str(t) for t in value]\n",
    "        else:\n",
    "            corpus = [str(value)]\n",
    "\n",
    "        if strategy == 'bow':\n",
    "            from sklearn.feature_extraction.text import CountVectorizer\n",
    "            vec = CountVectorizer()\n",
    "            mat = vec.fit_transform(corpus)\n",
    "            return pd.DataFrame(mat.toarray(), columns=vec.get_feature_names_out())\n",
    "\n",
    "        elif strategy.startswith('tfidf_'):\n",
    "            from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "            max_f = int(strategy.split('_')[1])\n",
    "            vec   = TfidfVectorizer(max_features=max_f)\n",
    "            mat   = vec.fit_transform(corpus)\n",
    "            return pd.DataFrame(mat.toarray(), columns=[f'tfidf_{i}' for i in range(mat.shape[1])])\n",
    "\n",
    "        elif strategy == 'hash_trick':\n",
    "            from sklearn.feature_extraction.text import HashingVectorizer\n",
    "            vec = HashingVectorizer(n_features=128, alternate_sign=False)\n",
    "            mat = vec.transform(corpus)\n",
    "            return pd.DataFrame(mat.toarray(), columns=[f'hash_{i}' for i in range(128)])\n",
    "\n",
    "        elif strategy == 'linguistic_features':\n",
    "            rows = []\n",
    "            for t in corpus:\n",
    "                words = t.split()\n",
    "                rows.append({\n",
    "                    'n_chars': len(t),\n",
    "                    'n_words': len(words),\n",
    "                    'n_unique_words': len(set(words)),\n",
    "                    'avg_word_len': np.mean([len(w) for w in words]) if words else 0,\n",
    "                    'n_sentences': t.count('.') + t.count('!') + t.count('?'),\n",
    "                    'lexical_diversity': len(set(words)) / max(len(words), 1),\n",
    "                })\n",
    "            return pd.DataFrame(rows)\n",
    "\n",
    "        elif strategy in ('lda_10', 'lda_20'):\n",
    "            from sklearn.feature_extraction.text import CountVectorizer\n",
    "            from sklearn.decomposition import LatentDirichletAllocation\n",
    "            n_topics = int(strategy.split('_')[1])\n",
    "            vec      = CountVectorizer(max_features=200)\n",
    "            mat      = vec.fit_transform(corpus)\n",
    "            lda      = LatentDirichletAllocation(n_components=n_topics, random_state=42)\n",
    "            topics   = lda.fit_transform(mat)\n",
    "            return pd.DataFrame(topics, columns=[f'topic_{i}' for i in range(n_topics)])\n",
    "\n",
    "        elif strategy == 'sbert':\n",
    "            from sentence_transformers import SentenceTransformer\n",
    "            model = SentenceTransformer('all-MiniLM-L6-v2')\n",
    "            embeds = model.encode(corpus)\n",
    "            return pd.DataFrame(embeds, columns=[f'sbert_{i}' for i in range(embeds.shape[1])])\n",
    "\n",
    "        elif strategy in ('word2vec_mean', 'fasttext_mean', 'glove_mean'):\n",
    "            raise NotImplementedError(\n",
    "                f\"'{strategy}' nécessite un modèle pré-entraîné. \"\n",
    "                \"Chargez le modèle manuellement et passez les embeddings en 'embedding'.\"\n",
    "            )\n",
    "\n",
    "        return corpus\n",
    "\n",
    "    # ---- Graphe ----\n",
    "    @staticmethod\n",
    "    def _encode_graph(value, strategy):\n",
    "        import networkx as nx\n",
    "        import numpy as np\n",
    "\n",
    "        if strategy == 'node_degree':\n",
    "            deg = dict(value.degree())\n",
    "            return pd.DataFrame(list(deg.items()), columns=['node', 'degree'])\n",
    "\n",
    "        elif strategy == 'pagerank':\n",
    "            pr = nx.pagerank(value)\n",
    "            return pd.DataFrame(list(pr.items()), columns=['node', 'pagerank'])\n",
    "\n",
    "        elif strategy == 'betweenness':\n",
    "            bc = nx.betweenness_centrality(value)\n",
    "            return pd.DataFrame(list(bc.items()), columns=['node', 'betweenness'])\n",
    "\n",
    "        elif strategy == 'closeness':\n",
    "            cc = nx.closeness_centrality(value)\n",
    "            return pd.DataFrame(list(cc.items()), columns=['node', 'closeness'])\n",
    "\n",
    "        elif strategy == 'eigenvector':\n",
    "            try:\n",
    "                ec = nx.eigenvector_centrality(value, max_iter=500)\n",
    "            except nx.PowerIterationFailedConvergence:\n",
    "                ec = {n: 0.0 for n in value.nodes()}\n",
    "            return pd.DataFrame(list(ec.items()), columns=['node', 'eigenvector'])\n",
    "\n",
    "        elif strategy == 'spectral':\n",
    "            from sklearn.manifold import SpectralEmbedding\n",
    "            adj  = nx.to_numpy_array(value)\n",
    "            n    = min(10, adj.shape[0] - 1)\n",
    "            emb  = SpectralEmbedding(n_components=n, affinity='precomputed').fit_transform(adj)\n",
    "            cols = [f'spectral_{i}' for i in range(n)]\n",
    "            return pd.DataFrame(emb, index=list(value.nodes()), columns=cols)\n",
    "\n",
    "        elif strategy == 'adj_matrix_flat':\n",
    "            adj = nx.to_numpy_array(value)\n",
    "            return adj.flatten()\n",
    "\n",
    "        elif strategy == 'global_stats':\n",
    "            g = value\n",
    "            stats = {\n",
    "                'n_nodes':   g.number_of_nodes(),\n",
    "                'n_edges':   g.number_of_edges(),\n",
    "                'density':   nx.density(g),\n",
    "                'is_directed': int(g.is_directed()),\n",
    "                'avg_degree': np.mean([d for _, d in g.degree()]),\n",
    "                'n_components': nx.number_connected_components(g.to_undirected()),\n",
    "            }\n",
    "            try:\n",
    "                stats['diameter'] = nx.diameter(g.to_undirected())\n",
    "            except Exception:\n",
    "                stats['diameter'] = -1\n",
    "            return pd.DataFrame([stats])\n",
    "\n",
    "        return value\n",
    "\n",
    "    # ---- Audio ----\n",
    "    @staticmethod\n",
    "    def _encode_audio(value, strategy):\n",
    "        import librosa\n",
    "        import numpy as np\n",
    "\n",
    "        # value peut être (y, sr) ou un array numpy\n",
    "        if isinstance(value, tuple) and len(value) == 2:\n",
    "            y, sr = value\n",
    "        else:\n",
    "            y, sr = np.array(value, dtype=float), 22050\n",
    "\n",
    "        if strategy == 'mfcc':\n",
    "            mfcc = librosa.feature.mfcc(y=y, sr=sr, n_mfcc=13)\n",
    "            feats = np.concatenate([mfcc.mean(axis=1), mfcc.std(axis=1)])\n",
    "            return feats\n",
    "\n",
    "        elif strategy == 'mel_spectrogram':\n",
    "            mel = librosa.feature.melspectrogram(y=y, sr=sr, n_mels=64)\n",
    "            mel_db = librosa.power_to_db(mel, ref=np.max)\n",
    "            return mel_db.flatten()\n",
    "\n",
    "        elif strategy == 'stft':\n",
    "            D = np.abs(librosa.stft(y))\n",
    "            return D.mean(axis=1)\n",
    "\n",
    "        elif strategy == 'chroma':\n",
    "            chroma = librosa.feature.chroma_stft(y=y, sr=sr)\n",
    "            return np.concatenate([chroma.mean(axis=1), chroma.std(axis=1)])\n",
    "\n",
    "        elif strategy == 'zcr':\n",
    "            zcr = librosa.feature.zero_crossing_rate(y)\n",
    "            return np.array([zcr.mean(), zcr.std()])\n",
    "\n",
    "        elif strategy == 'rms_energy':\n",
    "            rms = librosa.feature.rms(y=y)\n",
    "            return np.array([rms.mean(), rms.std(), rms.max()])\n",
    "\n",
    "        elif strategy == 'spectral_centroid':\n",
    "            sc = librosa.feature.spectral_centroid(y=y, sr=sr)\n",
    "            sr_feat = librosa.feature.spectral_rolloff(y=y, sr=sr)\n",
    "            return np.array([sc.mean(), sc.std(), sr_feat.mean(), sr_feat.std()])\n",
    "\n",
    "        elif strategy == 'tonnetz':\n",
    "            harmonic = librosa.effects.harmonic(y)\n",
    "            tnet = librosa.feature.tonnetz(y=harmonic, sr=sr)\n",
    "            return np.concatenate([tnet.mean(axis=1), tnet.std(axis=1)])\n",
    "\n",
    "        return y\n",
    "\n",
    "    # ---- Série Temporelle ----\n",
    "    @staticmethod\n",
    "    def _encode_timeseries(value, strategy):\n",
    "        import numpy as np\n",
    "        df = value if isinstance(value, pd.DataFrame) else pd.DataFrame(value)\n",
    "\n",
    "        if strategy == 'rolling_stats':\n",
    "            rows = {}\n",
    "            for col in df.select_dtypes(include='number').columns:\n",
    "                s = df[col].dropna()\n",
    "                rows[f'{col}_mean']  = s.mean()\n",
    "                rows[f'{col}_std']   = s.std()\n",
    "                rows[f'{col}_min']   = s.min()\n",
    "                rows[f'{col}_max']   = s.max()\n",
    "                rows[f'{col}_range'] = s.max() - s.min()\n",
    "                rows[f'{col}_q25']   = s.quantile(0.25)\n",
    "                rows[f'{col}_q75']   = s.quantile(0.75)\n",
    "            return pd.DataFrame([rows])\n",
    "\n",
    "        elif strategy == 'diff_1':\n",
    "            return df.diff(1).dropna()\n",
    "\n",
    "        elif strategy == 'diff_2':\n",
    "            return df.diff(2).dropna()\n",
    "\n",
    "        elif strategy == 'fft_features':\n",
    "            result = {}\n",
    "            for col in df.select_dtypes(include='number').columns:\n",
    "                fft_vals = np.abs(np.fft.rfft(df[col].fillna(0).values))\n",
    "                top5 = np.sort(fft_vals)[-5:][::-1]\n",
    "                for i, v in enumerate(top5):\n",
    "                    result[f'{col}_fft_top{i+1}'] = v\n",
    "            return pd.DataFrame([result])\n",
    "\n",
    "        elif strategy == 'lag_encoding':\n",
    "            lags = [1, 2, 3, 5, 7]\n",
    "            dfs  = [df]\n",
    "            for lag in lags:\n",
    "                shifted = df.shift(lag).add_suffix(f'_lag{lag}')\n",
    "                dfs.append(shifted)\n",
    "            return pd.concat(dfs, axis=1).dropna()\n",
    "\n",
    "        elif strategy == 'tsfresh':\n",
    "            from tsfresh import extract_features\n",
    "            return extract_features(df.reset_index(), column_id='index')\n",
    "\n",
    "        elif strategy == 'stl_decomp':\n",
    "            from statsmodels.tsa.seasonal import STL\n",
    "            results = {}\n",
    "            for col in df.select_dtypes(include='number').columns:\n",
    "                try:\n",
    "                    stl = STL(df[col].dropna(), period=12).fit()\n",
    "                    results[f'{col}_trend_mean']    = stl.trend.mean()\n",
    "                    results[f'{col}_seasonal_mean'] = stl.seasonal.mean()\n",
    "                    results[f'{col}_resid_std']     = stl.resid.std()\n",
    "                except Exception:\n",
    "                    pass\n",
    "            return pd.DataFrame([results])\n",
    "\n",
    "        return df\n",
    "\n",
    "    # ---- Embedding ----\n",
    "    @staticmethod\n",
    "    def _encode_embedding(value, strategy):\n",
    "        import numpy as np\n",
    "        arr = np.array(value)\n",
    "\n",
    "        if strategy == 'l2_norm':\n",
    "            norm = np.linalg.norm(arr, axis=-1, keepdims=True)\n",
    "            return arr / (norm + 1e-10)\n",
    "\n",
    "        elif strategy == 'std_norm':\n",
    "            from sklearn.preprocessing import StandardScaler\n",
    "            return StandardScaler().fit_transform(arr if arr.ndim == 2 else arr.reshape(1, -1))\n",
    "\n",
    "        elif strategy.startswith('pca_'):\n",
    "            from sklearn.decomposition import PCA\n",
    "            n = int(strategy.split('_')[1])\n",
    "            return PCA(n_components=n).fit_transform(arr if arr.ndim == 2 else arr.reshape(1, -1))\n",
    "\n",
    "        elif strategy == 'umap_2d':\n",
    "            import umap\n",
    "            return umap.UMAP(n_components=2, random_state=42).fit_transform(arr)\n",
    "\n",
    "        elif strategy == 'umap_10d':\n",
    "            import umap\n",
    "            return umap.UMAP(n_components=10, random_state=42).fit_transform(arr)\n",
    "\n",
    "        elif strategy == 'tsne_2d':\n",
    "            from sklearn.manifold import TSNE\n",
    "            return TSNE(n_components=2, random_state=42).fit_transform(arr)\n",
    "\n",
    "        return arr\n",
    "\n",
    "    # ---- Document ----\n",
    "    @staticmethod\n",
    "    def _encode_document(value, strategy):\n",
    "        if strategy == 'json_flatten':\n",
    "            if isinstance(value, dict):\n",
    "                return pd.json_normalize(value)\n",
    "            elif isinstance(value, list):\n",
    "                return pd.json_normalize(value)\n",
    "            return pd.DataFrame([value])\n",
    "\n",
    "        elif strategy == 'structural_features':\n",
    "            def count_keys(d, depth=0):\n",
    "                if isinstance(d, dict):\n",
    "                    return sum(count_keys(v, depth + 1) for v in d.values()) + len(d)\n",
    "                elif isinstance(d, list):\n",
    "                    return sum(count_keys(i, depth) for i in d)\n",
    "                return 0\n",
    "            n_keys = count_keys(value) if isinstance(value, (dict, list)) else 0\n",
    "            return pd.DataFrame([{'n_keys': n_keys, 'depth': 1}])\n",
    "\n",
    "        return value\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# UltimateEncoder — gestion unifiée tabulaire + non-tabulaire\n",
    "# ================================================================\n",
    "class UltimateEncoder:\n",
    "    def __init__(self, all_datasets):\n",
    "        self.all_datasets = all_datasets\n",
    "\n",
    "        self.datasets = {\n",
    "            k: v.copy()\n",
    "            for k, v in all_datasets.items()\n",
    "            if isinstance(v, pd.DataFrame) and not (\n",
    "                pd.api.types.is_datetime64_any_dtype(v.index) or\n",
    "                any(t in k.lower() for t in ['ts', 'timeseries', 'time_series'])\n",
    "            )\n",
    "        }\n",
    "        self.non_tabular = {\n",
    "            k: v\n",
    "            for k, v in all_datasets.items()\n",
    "            if k not in self.datasets\n",
    "        }\n",
    "        self.nt_types = {\n",
    "            k: infer_non_tabular_type(k, v)\n",
    "            for k, v in self.non_tabular.items()\n",
    "        }\n",
    "        self.meta = {k: infer_types(v) for k, v in self.datasets.items()}\n",
    "\n",
    "        self.results       = {}\n",
    "        self.tab_configs   = {}\n",
    "        self.nt_configs    = {}\n",
    "\n",
    "        self._tab_row_widgets = {}\n",
    "        self._nt_row_widgets  = {}\n",
    "\n",
    "        self._build_ui()\n",
    "\n",
    "    # ----------------------------------------------------------------\n",
    "    # Options & defaults tabulaires\n",
    "    # ----------------------------------------------------------------\n",
    "    encoding_options = {\n",
    "        'numeric'    : [('Aucun (Passthrough)', 'none'), ('Standardisation (Z-score)', 'std'),\n",
    "                        ('Min-Max Scaling', 'minmax'), ('Ignorer (Drop)', 'drop')],\n",
    "        'categorical': [('One-Hot Encoding', 'onehot'), ('Label Encoding', 'label'),\n",
    "                        ('Frequency Encoding', 'freq'), ('Ignorer (Drop)', 'drop')],\n",
    "        'binary'     : [('Label Encoding', 'label'), ('Ignorer (Drop)', 'drop')],\n",
    "        'datetime'   : [('Extraire Année/Mois/Jour', 'extract_ymd'),\n",
    "                        ('Timestamp (Epoch)', 'epoch'), ('Ignorer (Drop)', 'drop')],\n",
    "        'text'       : [('TF-IDF (50 features)', 'tfidf_50'),\n",
    "                        ('TF-IDF (100 features)', 'tfidf_100'), ('Ignorer (Drop)', 'drop')],\n",
    "        'id_like'    : [('Ignorer (Drop)', 'drop'), ('Label Encoding', 'label'), ('Aucun', 'none')],\n",
    "    }\n",
    "    default_encoding = {\n",
    "        'numeric': 'none', 'categorical': 'onehot', 'binary': 'label',\n",
    "        'datetime': 'extract_ymd', 'text': 'tfidf_50', 'id_like': 'drop'\n",
    "    }\n",
    "\n",
    "    # ----------------------------------------------------------------\n",
    "    # Construction de l'UI\n",
    "    # ----------------------------------------------------------------\n",
    "    def _build_ui(self):\n",
    "        header_html = (\n",
    "            \"<div style='border-bottom:2px solid #e2e8f0; margin-bottom:16px; padding-bottom:8px;'>\"\n",
    "            \"<h2 style='font-size:20px; color:#1e293b; margin:0;'>\"\n",
    "            \"Encodage des Variables — Tabulaire &amp; Non-Tabulaire</h2></div>\"\n",
    "        )\n",
    "\n",
    "        tabs_children = []\n",
    "        tab_titles    = []\n",
    "\n",
    "        # ---- Onglet Tabulaire ----\n",
    "        if self.datasets:\n",
    "            tab_titles.append('📊 Données Tabulaires')\n",
    "            tabs_children.append(self._build_tabular_panel())\n",
    "        else:\n",
    "            tab_titles.append('📊 Données Tabulaires')\n",
    "            tabs_children.append(widgets.HTML(\n",
    "                \"<div style='padding:16px; color:#64748b;'>Aucun DataFrame tabulaire détecté.</div>\"\n",
    "            ))\n",
    "\n",
    "        # ---- Onglet Non-Tabulaire ----\n",
    "        if self.non_tabular:\n",
    "            tab_titles.append('🗂️ Données Non-Tabulaires')\n",
    "            tabs_children.append(self._build_non_tabular_panel())\n",
    "        else:\n",
    "            tab_titles.append('🗂️ Données Non-Tabulaires')\n",
    "            tabs_children.append(widgets.HTML(\n",
    "                \"<div style='padding:16px; color:#64748b;'>Aucune donnée non-tabulaire détectée.</div>\"\n",
    "            ))\n",
    "\n",
    "        tabs = widgets.Tab(children=tabs_children)\n",
    "        for i, t in enumerate(tab_titles):\n",
    "            tabs.set_title(i, t)\n",
    "\n",
    "        self.global_out = widgets.Output()\n",
    "\n",
    "        btn_apply_all = widgets.Button(\n",
    "            description='✅ Appliquer Tous les Encodages',\n",
    "            button_style='success',\n",
    "            layout=widgets.Layout(width='260px', height='38px'),\n",
    "            style={'font_weight': 'bold'}\n",
    "        )\n",
    "        btn_apply_all.on_click(self._apply_all)\n",
    "\n",
    "        self.ui = widgets.VBox([\n",
    "            widgets.HTML(header_html),\n",
    "            tabs,\n",
    "            widgets.HBox([btn_apply_all],\n",
    "                         layout=widgets.Layout(margin='16px 0 8px 0', justify_content='flex-end')),\n",
    "            self.global_out\n",
    "        ], layout=widgets.Layout(width='100%', padding='20px'))\n",
    "\n",
    "    # ---- Panel Tabulaire ----\n",
    "    def _build_tabular_panel(self):\n",
    "        self.ds_selector = widgets.Dropdown(\n",
    "            options=list(self.datasets.keys()),\n",
    "            description='Dataset:',\n",
    "            layout=widgets.Layout(width='350px'),\n",
    "            style={'description_width': 'initial'}\n",
    "        )\n",
    "        self.ds_selector.observe(self._on_tab_ds_change, names='value')\n",
    "        self.current_ds = self.ds_selector.value\n",
    "\n",
    "        self.table_container = widgets.VBox(layout=widgets.Layout(\n",
    "            width='100%', max_height='480px', overflow_y='auto',\n",
    "            border='1px solid #cbd5e1', border_radius='4px', padding='5px'\n",
    "        ))\n",
    "        self.tab_out = widgets.Output()\n",
    "\n",
    "        btn_apply_tab = widgets.Button(\n",
    "            description='Appliquer (ce dataset)',\n",
    "            button_style='primary', icon='cogs',\n",
    "            layout=widgets.Layout(width='210px')\n",
    "        )\n",
    "        btn_apply_tab.on_click(self._apply_tabular)\n",
    "\n",
    "        self._on_tab_ds_change(None)\n",
    "\n",
    "        return widgets.VBox([\n",
    "            widgets.HBox([self.ds_selector], layout=widgets.Layout(margin='12px 0')),\n",
    "            self.table_container,\n",
    "            widgets.HBox([btn_apply_tab],\n",
    "                         layout=widgets.Layout(margin='10px 0', justify_content='flex-end')),\n",
    "            self.tab_out\n",
    "        ], layout=widgets.Layout(padding='10px'))\n",
    "\n",
    "    def _on_tab_ds_change(self, change):\n",
    "        if change:\n",
    "            self.current_ds = change['new']\n",
    "        df   = self.datasets[self.current_ds]\n",
    "        meta = self.meta[self.current_ds]\n",
    "\n",
    "        type_trans = {\n",
    "            'datetime': 'Date/Heure', 'binary': 'Binaire', 'numeric': 'Numérique',\n",
    "            'text': 'Texte', 'id_like': 'ID / Unique', 'categorical': 'Catégoriel'\n",
    "        }\n",
    "        header = widgets.HBox([\n",
    "            widgets.HTML(\"<b style='color:#475569;'>Colonne</b>\",    layout=widgets.Layout(width='190px')),\n",
    "            widgets.HTML(\"<b style='color:#475569;'>Type</b>\",       layout=widgets.Layout(width='100px')),\n",
    "            widgets.HTML(\"<b style='color:#475569;'>Val. Un.</b>\",   layout=widgets.Layout(width='100px')),\n",
    "            widgets.HTML(\"<b style='color:#475569;'>Méthode</b>\",    layout=widgets.Layout(width='210px')),\n",
    "        ], layout=widgets.Layout(\n",
    "            border_bottom='2px solid #94a3b8', padding='8px 0',\n",
    "            background='#f8fafc', align_items='center'\n",
    "        ))\n",
    "        rows = [header]\n",
    "        self._tab_row_widgets[self.current_ds] = {}\n",
    "\n",
    "        for col in df.columns:\n",
    "            m    = meta[col]\n",
    "            kind = m['kind']\n",
    "            options     = self.encoding_options.get(kind, [('Ignorer', 'drop')])\n",
    "            default_val = self.default_encoding.get(kind, 'drop')\n",
    "            if kind == 'categorical' and m['n_unique'] > 15:\n",
    "                default_val = 'freq'\n",
    "\n",
    "            dd = widgets.Dropdown(options=options, value=default_val,\n",
    "                                  layout=widgets.Layout(width='200px'))\n",
    "            self._tab_row_widgets[self.current_ds][col] = {'dd_enc': dd, 'kind': kind}\n",
    "\n",
    "            rows.append(widgets.HBox([\n",
    "                widgets.HTML(f\"<b style='color:#1e293b; overflow-wrap:anywhere;'>{col}</b>\",\n",
    "                             layout=widgets.Layout(width='190px')),\n",
    "                widgets.HTML(f\"<span style='font-size:12px; color:#64748b;'>{type_trans.get(kind, kind)}</span>\",\n",
    "                             layout=widgets.Layout(width='100px')),\n",
    "                widgets.HTML(f\"<span style='font-size:12px; color:#64748b;'>{m['n_unique']}</span>\",\n",
    "                             layout=widgets.Layout(width='100px')),\n",
    "                dd,\n",
    "            ], layout=widgets.Layout(border_bottom='1px solid #e2e8f0', padding='6px 0',\n",
    "                                     align_items='center', min_height='44px')))\n",
    "\n",
    "        self.table_container.children = rows\n",
    "        with self.tab_out:\n",
    "            clear_output()\n",
    "\n",
    "    # ---- Panel Non-Tabulaire ----\n",
