    "\n",
    "    def _build_ui(self):\n",
    "        self.task, self.subtask = self._detect_task()\n",
    "        scoring_default = _scoring_for_task(self.task, self.subtask)\n",
    "\n",
    "        header  = widgets.HTML(styles.card_html(\n",
    "            \"Optimisation & Sélection\",\n",
