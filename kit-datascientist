    "# ============================================================\n",
    "# CELLULE 5 — ENCODAGE DES VARIABLES (Textes, Images, Catégoriques)\n",
    "# ============================================================\n",
    "class EncodingManager:\n",
    "    ENCODING_OPTIONS = {\n",
    "        'numeric'    : ['Passthrough', 'Drop'],\n",
    "        'categorical': ['OneHotEncoder', 'LabelEncoder', 'OrdinalEncoder', 'FrequencyEncoder', 'Drop'],\n",
    "        'binary'     : ['LabelEncoder', 'Drop'],\n",
    "        'datetime'   : ['Extraire composantes', 'Drop'],\n",
    "        'text'       : ['TF-IDF (100 features)', 'Garder brut', 'Drop'],\n",
    "        'id_like'    : ['Drop', 'Garder brut'],\n",
    "    }\n",
    "    \n",
    "    def __init__(self, cleaned_datasets, meta):\n",
    "        self.datasets = cleaned_datasets\n",
    "        self.meta = meta\n",
    "        self.results = {}\n",
    "\n",
    "    def show(self):\n",
    "        display(HTML(\"<h3>Encodage des Variables</h3>\"))\n",
    "        if not self.datasets:\n",
    "            print(\"Aucune donnée nettoyée à encoder. Exécutez la cellule 4.\")\n",
    "            return\n",
    "            \n",
    "        ds_dd = widgets.Dropdown(options=list(self.datasets.keys()), description='Jeu T.')\n",
    "        btn_enc = widgets.Button(description='Auto-Encoder', button_style='success')\n",
    "        out_enc = widgets.Output()\n",
    "\n",
    "        def apply_encoding(df, meta):\n",
    "            df_enc = df.copy()\n",
    "            for col, m in meta.items():\n",
    "                if col not in df_enc.columns: continue\n",
    "                kind = m['kind']\n",
    "                s = df_enc[col]\n",
    "                \n",
    "                try:\n",
    "                    if kind == 'categorical':\n",
    "                        if s.nunique() <= 15:\n",
    "                            dummies = pd.get_dummies(s, prefix=col, drop_first=True, dtype=int)\n",
    "                            df_enc = pd.concat([df_enc.drop(columns=[col]), dummies], axis=1)\n",
    "                        else:\n",
    "                            le = LabelEncoder()\n",
    "                            df_enc[col] = le.fit_transform(s.astype(str))\n",
    "                    elif kind == 'text':\n",
    "                        tfidf = TfidfVectorizer(max_features=50)\n",
    "                        mat = tfidf.fit_transform(s.astype(str).fillna(''))\n",
    "                        col_names = [f\"{col}_tfidf_{i}\" for i in range(mat.shape[1])]\n",
    "                        df_tfidf = pd.DataFrame(mat.toarray(), columns=col_names, index=df_enc.index)\n",
    "                        df_enc = pd.concat([df_enc.drop(columns=[col]), df_tfidf], axis=1)\n",
    "                    elif kind == 'datetime':\n",
    "                        s_dt = pd.to_datetime(s, errors='coerce')\n",
    "                        df_enc[f\"{col}_annee\"] = s_dt.dt.year\n",
    "                        df_enc[f\"{col}_mois\"] = s_dt.dt.month\n",
    "                        df_enc.drop(columns=[col], inplace=True)\n",
    "                    elif kind == 'id_like':\n",
    "                        df_enc.drop(columns=[col], inplace=True)\n",
    "                except Exception as e:\n",
    "                    print(f\"Erreur avec la colonne {col}: {str(e)}\")\n",
    "            return df_enc\n",
    "\n",
    "        def run_enc(b):\n",
    "            with out_enc:\n",
    "                clear_output()\n",
    "                lbl = ds_dd.value\n",
    "                df_enc = apply_encoding(self.datasets[lbl], self.meta[lbl])\n",
    "                self.results[lbl] = df_enc\n",
    "                \n",
    "                display(HTML(f\"<div style='padding:10px; border-left:4px solid green; background-color:#e8f5e9;'>\"\n",
    "                             f\"<b>Encodage appliqué sur {lbl} !</b><br>\"\n",
    "                             f\"Colonnes avant : {self.datasets[lbl].shape[1]} -> après : {df_enc.shape[1]}<br>\"\n",
    "                             f\"Le TF-IDF a été limité à 50 composantes pour les textes.\"\n",
    "                             f\"</div>\"))\n",
    "                             \n",
    "        btn_enc.on_click(run_enc)\n",
    "        display(widgets.HBox([ds_dd, btn_enc]))\n",
    "        display(out_enc)\n",
    "\n",
    "if 'cleaner' in locals() and cleaner.results:\n",
    "    encoder = EncodingManager(cleaner.results, eda.meta)\n",
    "    encoder.show()\n",
    "else:\n",
    "    print(\"Veuillez appliquer le nettoyage (Cellule 4) avant d'encoder.\")\n"
