    "        all_titles = ['Metrics', 'Clf — Curves', 'Reg — Residuals', 'Feature Importance', 'Interpretability', 'Comparison', 'Predictions']\n",
    "\n",
    "        if self.task == 'regression':\n",
    "            all_tabs.pop(1)\n",
    "            all_titles.pop(1)\n",
