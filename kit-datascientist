    "def _import_model_class(module_path: str, class_name: str):\n",
    "    \"\"\"Import dynamique sécurisé.\"\"\"\n",
    "    parts = module_path.split(\".\")\n",
    "    mod = __import__(parts[0], fromlist=[parts[1]] if len(parts) > 1 else [])\n",
    "    for p in parts[1:]:\n",
    "        mod = getattr(mod, p)\n",
    "    return getattr(mod, class_name)\n",
    "\n",
    "def _instantiate_model(module_path: str, class_name: str, params: dict, random_state: int = 42):\n",
    "    \"\"\"Instancie un modèle en injectant random_state si supporté.\"\"\"\n",
    "    ModelClass = _import_model_class(module_path, class_name)\n",
    "    try:\n",
    "        return ModelClass(random_state=random_state, **params)\n",
    "    except TypeError:\n",
    "        return ModelClass(**params)\n",
    "\n",
    "# ================================================================\n",
    "# 3. ÉVALUATION ET MÉTRIQUES\n",
    "# ================================================================\n",
    "def evaluate_model(model, X_test, y_test, problem_type: str, target_type: str,\n",
    "                   label_encoder=None) -> dict:\n",
    "    y_pred = model.predict(X_test)\n",
    "    metrics = {\"model_name\": type(model).__name__}\n",
    "\n",
    "    if problem_type == \"classification\":\n",
    "        avg = \"binary\" if target_type == \"binary\" else \"weighted\"\n",
    "        metrics[\"accuracy\"]  = accuracy_score(y_test, y_pred)\n",
    "        metrics[\"precision\"] = precision_score(y_test, y_pred, average=avg, zero_division=0)\n",
    "        metrics[\"recall\"]    = recall_score(y_test, y_pred, average=avg, zero_division=0)\n",
    "        metrics[\"f1\"]        = f1_score(y_test, y_pred, average=avg, zero_division=0)\n",
    "        metrics[\"confusion_matrix\"] = confusion_matrix(y_test, y_pred).tolist()\n",
    "        metrics[\"report\"]    = classification_report(y_test, y_pred, output_dict=True, zero_division=0)\n",
    "\n",
    "        # ROC / PR curves\n",
    "        if hasattr(model, \"predict_proba\"):\n",
    "            y_proba = model.predict_proba(X_test)\n",
    "            if target_type == \"binary\":\n",
    "                fpr, tpr, _ = roc_curve(y_test, y_proba[:, 1])\n",
    "                metrics[\"roc_auc\"]   = roc_auc_score(y_test, y_proba[:, 1])\n",
    "                metrics[\"fpr\"]       = fpr.tolist()\n",
    "                metrics[\"tpr\"]       = tpr.tolist()\n",
    "                prec, rec, _ = precision_recall_curve(y_test, y_proba[:, 1])\n",
    "                metrics[\"avg_prec\"]  = average_precision_score(y_test, y_proba[:, 1])\n",
    "                metrics[\"pr_prec\"]   = prec.tolist()\n",
    "                metrics[\"pr_rec\"]    = rec.tolist()\n",
    "            else:\n",
    "                # multi-class OvR\n",
    "                classes = np.unique(y_test)\n",
    "                try:\n",
    "                    metrics[\"roc_auc\"] = roc_auc_score(\n",
    "                        y_test, y_proba, multi_class=\"ovr\", average=\"weighted\"\n",
    "                    )\n",
    "                except:\n",
    "                    metrics[\"roc_auc\"] = np.nan\n",
    "        else:\n",
    "            metrics[\"roc_auc\"] = np.nan\n",
    "\n",
    "    elif problem_type == \"regression\":\n",
    "        metrics[\"mse\"]     = mean_squared_error(y_test, y_pred)\n",
    "        metrics[\"rmse\"]    = np.sqrt(metrics[\"mse\"])\n",
    "        metrics[\"mae\"]     = mean_absolute_error(y_test, y_pred)\n",
    "        metrics[\"r2\"]      = r2_score(y_test, y_pred)\n",
    "        metrics[\"mape\"]    = float(np.mean(np.abs((y_test - y_pred) / (np.abs(y_test) + 1e-8))) * 100)\n",
    "        residuals          = y_test - y_pred\n",
    "        metrics[\"residuals\"] = residuals.tolist() if hasattr(residuals, \"tolist\") else list(residuals)\n",
    "        metrics[\"y_pred\"]  = y_pred.tolist() if hasattr(y_pred, \"tolist\") else list(y_pred)\n",
    "        metrics[\"y_true\"]  = y_test.tolist() if hasattr(y_test, \"tolist\") else list(y_test)\n",
    "\n",
    "    return metrics\n",
