    "    # -------------------------------------------------------\n",
    "    # UPLOAD SLOTS (per mode)\n",
    "    # -------------------------------------------------------\n",
    "\n",
    "    def _build_slots(self):\n",
    "        src = self.SUPPORTED_TYPES[self.source_dd.value]\n",
