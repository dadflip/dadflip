    "\n",
    "# ================================================================\n",
    "# 1. DÉTECTION DU TYPE DE PROBLÈME\n",
    "# ================================================================\n",
    "def detect_problem_type(df: pd.DataFrame, target_col: str) -> dict:\n",
    "    \"\"\"\n",
    "    Analyse la colonne cible et infère automatiquement :\n",
    "      - problem_type : 'classification' ou 'regression'\n",
    "      - target_type  : 'binary', 'multiclass', ou 'continuous'\n",
    "      - n_classes    : nombre de classes (classification)\n",
    "      - class_balance: dict de distribution des classes\n",
    "    \"\"\"\n",
    "    if target_col not in df.columns:\n",
    "        return {\"error\": f\"Colonne '{target_col}' introuvable.\"}\n",
    "\n",
    "    target   = df[target_col].dropna()\n",
    "    n_unique = target.nunique()\n",
    "    dtype    = target.dtype\n",
    "    is_num   = pd.api.types.is_numeric_dtype(dtype)\n",
    "\n",
    "    if n_unique == 2:\n",
    "        base = {\"problem_type\": \"classification\", \"target_type\": \"binary\",\n",
    "                \"is_discrete\": True, \"n_classes\": 2}\n",
    "    elif (not is_num) or (n_unique <= 20):\n",
    "        # valeurs entières consécutives ou catégorielles → classification\n",
    "        unique_vals = sorted(target.unique())\n",
    "        if is_num and n_unique <= 20:\n",
    "            try:\n",
    "                if all(float(x).is_integer() for x in unique_vals):\n",
    "                    base = {\"problem_type\": \"classification\", \"target_type\": \"multiclass\",\n",
    "                            \"is_discrete\": True, \"n_classes\": n_unique}\n",
    "                else:\n",
    "                    base = {\"problem_type\": \"regression\", \"target_type\": \"continuous\",\n",
    "                            \"is_discrete\": False, \"n_classes\": None}\n",
    "            except:\n",
    "                base = {\"problem_type\": \"classification\", \"target_type\": \"multiclass\",\n",
    "                        \"is_discrete\": True, \"n_classes\": n_unique}\n",
    "        else:\n",
    "            base = {\"problem_type\": \"classification\", \"target_type\": \"multiclass\",\n",
    "                    \"is_discrete\": True, \"n_classes\": n_unique}\n",
    "    elif is_num:\n",
    "        base = {\"problem_type\": \"regression\", \"target_type\": \"continuous\",\n",
    "                \"is_discrete\": False, \"n_classes\": None}\n",
    "    else:\n",
    "        base = {\"problem_type\": \"classification\", \"target_type\": \"multiclass\",\n",
    "                \"is_discrete\": True, \"n_classes\": n_unique}\n",
    "\n",
    "    # Distribution des classes / target\n",
    "    if base[\"problem_type\"] == \"classification\":\n",
    "        counts = target.value_counts(normalize=True).to_dict()\n",
    "        base[\"class_balance\"] = counts\n",
    "        # Imbalance ratio\n",
    "        vals = list(counts.values())\n",
    "        base[\"imbalance_ratio\"] = round(max(vals) / min(vals), 2) if min(vals) > 0 else None\n",
    "    else:\n",
    "        base[\"target_stats\"] = {\n",
    "            \"mean\": round(float(target.mean()), 4),\n",
    "            \"std\":  round(float(target.std()), 4),\n",
    "            \"min\":  round(float(target.min()), 4),\n",
    "            \"max\":  round(float(target.max()), 4),\n",
    "        }\n",
    "\n",
    "    return base\n",
    "\n",
    "def detect_potential_targets(df: pd.DataFrame, max_cols: int = 10) -> list:\n",
    "    \"\"\"Heuristique pour suggérer les colonnes cibles les plus probables.\"\"\"\n",
    "    scores = []\n",
    "    for col in df.columns:\n",
    "        s = df[col]\n",
    "        score = 0\n",
    "        name_lower = col.lower()\n",
    "        # Bonus nom\n",
    "        for kw in [\"target\",\"label\",\"class\",\"y\",\"output\",\"result\",\"churn\",\"fraud\",\n",
    "                   \"price\",\"score\",\"rating\",\"status\",\"survived\",\"diagnosis\"]:\n",
    "            if kw in name_lower:\n",
    "                score += 10\n",
    "        # Position (dernière colonne souvent la cible)\n",
    "        if col == df.columns[-1]:\n",
    "            score += 5\n",
    "        # Peu de valeurs uniques → classification\n",
    "        if s.nunique() <= 20:\n",
    "            score += 3\n",
    "        scores.append((col, score))\n",
    "    scores.sort(key=lambda x: -x[1])\n",
    "    return scores[:max_cols]\n",
    "\n",
    "# ================================================================\n",
    "# 2. CATALOGUE DES MODÈLES\n",
