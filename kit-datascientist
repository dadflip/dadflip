    "            \"<b>Cat x Cat:</b> Heatmap or Stacked Bar.<br>\"\n",
    "            \"<b>Hue:</b> adds a 3rd categorical dimension via color.\",\n",
    "            '#10b981'\n",
    "        )\n",
    "        bi_row1 = widgets.HBox([self.bi_x, self.bi_y, self.bi_type], layout=widgets.Layout(align_items='flex-end', gap='10px'))\n",
    "        bi_row2 = widgets.HBox([self.bi_hue, self.bi_pal, self.bi_alpha], layout=widgets.Layout(align_items='flex-end', gap='10px', margin='6px 0 0 0'))\n",
    "        bi_row3 = widgets.HBox([self.bi_btn, self.bi_save_btn], layout=widgets.Layout(align_items='center', gap='8px', margin='8px 0 0 0'))\n",
    "        tab_bi  = widgets.VBox([help_bi, bi_row1, bi_row2, bi_row3, self.bi_out])\n",
    "\n",
    "        self.multi_type = widgets.Dropdown(\n",
    "            options=eda_cfg.get(\"multivariate_analysis\", []),\n",
    "            value='Correlation Matrix', description='Analysis:', layout=styles.LAYOUT_DD\n",
    "        )\n",
    "        self.multi_hue  = widgets.Dropdown(options=['None'] + cols, value='None', description='Hue (Pair):', layout=styles.LAYOUT_AUTO)\n",
