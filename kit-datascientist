    "# ============================================================\n",
    "# DATA LOADER — 01_loader.py\n",
    "# Handles: CSV, TSV, Excel, JSON, Parquet, Feather, HDF5,\n",
    "#          ORC, SQLite, Time-series, Images, Graph,\n",
    "#          Text, ZIP batch, URL, Clipboard, sklearn toy datasets\n",
    "# Modes   : Single file, Multi-file (train/test/val splits),\n",
    "#           Multi-source (heterogeneous)\n",
    "# ============================================================\n",
    "\n",
    "import io\n",
    "import os\n",
    "import json\n",
    "import glob\n",
    "import zipfile\n",
    "import sqlite3\n",
    "import urllib.request\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "try:\n",
    "    import networkx as nx\n",
    "except ImportError:\n",
    "    nx = None\n",
    "\n",
    "try:\n",
    "    from PIL import Image\n",
    "except ImportError:\n",
    "    Image = None\n",
    "\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, clear_output, HTML\n",
    "\n",
    "# Optional heavy deps — soft imports\n",
    "try:\n",
    "    import cv2 as _cv2\n",
    "except ImportError:\n",
    "    _cv2 = None\n",
    "\n",
    "try:\n",
    "    import pyarrow.feather as _feather\n",
    "except ImportError:\n",
    "    _feather = None\n",
    "\n",
    "try:\n",
    "    import pyarrow.orc as _orc\n",
    "except ImportError:\n",
    "    _orc = None\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# LOW-LEVEL FILE READER\n",
    "# ============================================================\n",
    "\n",
    "def _read_file_bytes(\n",
    "    raw_bytes: bytes,\n",
    "    filename: str,\n",
    "    source_type: str,\n",
    "    # --- tabular options ---\n",
    "    sep: str = \",\",\n",
    "    encoding: str = \"utf-8\",\n",
    "    header=0,\n",
    "    decimal: str = \".\",\n",
    "    thousands: str = None,\n",
    "    na_values=None,\n",
    "    sheet_name=0,\n",
    "    # --- image options ---\n",
    "    image_target_size: tuple = None,\n",
    "    image_mode: str = \"RGB\",\n",
    "    # --- text options ---\n",
    "    text_encoding: str = \"utf-8\",\n",
    "    # --- graph options ---\n",
    "    graph_format: str = \"auto\",\n",
    "):\n",
    "    \"\"\"\n",
    "    Low-level dispatcher: returns the appropriate Python object\n",
    "    for the given source_type and file bytes.\n",
    "    \"\"\"\n",
    "    ext = filename.rsplit(\".\", 1)[-1].lower() if \".\" in filename else \"\"\n",
    "    buf = io.BytesIO(raw_bytes)\n",
    "\n",
    "    # ------ IMAGE -------\n",
    "    if source_type == \"image\":\n",
    "        img = Image.open(buf).convert(image_mode)\n",
    "        if image_target_size:\n",
    "            img = img.resize(image_target_size, Image.LANCZOS)\n",
    "        return img\n",
    "\n",
    "    # ------ GRAPH -------\n",
    "    if source_type == \"graph\":\n",
    "        if graph_format == \"auto\":\n",
    "            try:\n",
    "                return nx.read_graphml(io.BytesIO(raw_bytes))\n",
    "            except Exception:\n",
    "                try:\n",
    "                    return nx.read_gml(io.BytesIO(raw_bytes))\n",
    "                except Exception:\n",
    "                    return nx.read_edgelist(io.BytesIO(raw_bytes))\n",
    "        elif graph_format == \"graphml\":\n",
    "            return nx.read_graphml(io.BytesIO(raw_bytes))\n",
    "        elif graph_format == \"gml\":\n",
    "            return nx.read_gml(io.BytesIO(raw_bytes))\n",
    "        elif graph_format == \"edgelist\":\n",
    "            return nx.read_edgelist(io.BytesIO(raw_bytes))\n",
    "        elif graph_format == \"adjlist\":\n",
    "            return nx.read_adjlist(io.BytesIO(raw_bytes))\n",
    "\n",
    "    # ------ ONTOLOGY -------\n",
    "    if source_type == \"ontology\":\n",
    "        try:\n",
    "            import rdflib\n",
    "        except ImportError:\n",
    "            raise ImportError(\"rdflib not installed. Please install rdflib.\")\n",
    "            \n",
    "        g = rdflib.Graph()\n",
    "        fmt = \"xml\"\n",
    "        if ext in (\"ttl\", \"turtle\"): fmt = \"turtle\"\n",
    "        elif ext == \"nt\": fmt = \"nt\"\n",
    "        elif ext == \"n3\": fmt = \"n3\"\n",
    "        elif ext == \"jsonld\": fmt = \"json-ld\"\n",
    "        g.parse(data=raw_bytes, format=fmt)\n",
    "        return g\n",
    "\n",
    "    # ------ TEXT -------\n",
    "    if source_type == \"text\":\n",
    "        return raw_bytes.decode(text_encoding, errors=\"replace\")\n",
    "\n",
    "    # ------ TABULAR / TIME-SERIES -------\n",
    "    shared_kwargs = dict(\n",
    "        encoding=encoding,\n",
    "        header=header,\n",
    "        decimal=decimal,\n",
    "        na_values=na_values,\n",
    "    )\n",
    "    if thousands:\n",
    "        shared_kwargs[\"thousands\"] = thousands\n",
    "\n",
    "    if ext == \"csv\" or (ext not in (\"tsv\", \"xls\", \"xlsx\", \"json\", \"parquet\", \"feather\", \"orc\", \"hdf\", \"h5\") and source_type in (\"csv\", \"tabular\", \"timeseries\")):\n",
    "        return pd.read_csv(buf, sep=sep, **shared_kwargs)\n",
    "    elif ext == \"tsv\":\n",
    "        return pd.read_csv(buf, sep=\"\\t\", **shared_kwargs)\n",
    "    elif ext in (\"xls\", \"xlsx\"):\n",
    "        return pd.read_excel(buf, sheet_name=sheet_name, header=header)\n",
    "    elif ext == \"json\":\n",
    "        try:\n",
    "            return pd.read_json(buf, encoding=encoding)\n",
    "        except Exception:\n",
    "            buf.seek(0)\n",
    "            return pd.DataFrame(json.load(buf))\n",
    "    elif ext == \"parquet\":\n",
    "        return pd.read_parquet(buf)\n",
    "    elif ext == \"feather\":\n",
    "        if _feather:\n",
    "            return _feather.read_feather(buf)\n",
    "        raise ImportError(\"pyarrow not installed. Run: pip install pyarrow\")\n",
    "    elif ext == \"orc\":\n",
    "        if _orc:\n",
    "            return _orc.read_table(buf).to_pandas()\n",
    "        raise ImportError(\"pyarrow not installed. Run: pip install pyarrow\")\n",
    "    elif ext in (\"hdf\", \"h5\"):\n",
    "        import tempfile, os\n",
    "        with tempfile.NamedTemporaryFile(delete=False, suffix=f\".{ext}\") as tmp:\n",
    "            tmp.write(raw_bytes)\n",
    "            tmp_path = tmp.name\n",
    "        try:\n",
    "            df = pd.read_hdf(tmp_path)\n",
    "        finally:\n",
    "            os.unlink(tmp_path)\n",
    "        return df\n",
    "    else:\n",
    "        # Fallback: try CSV\n",
    "        return pd.read_csv(buf, sep=sep, **shared_kwargs)\n",
    "\n",
    "\n",
    "def _read_sqlite(raw_bytes: bytes, table_name: str = None) -> pd.DataFrame:\n",
    "    \"\"\"Load a SQLite .db file from bytes and return a chosen table.\"\"\"\n",
    "    import tempfile\n",
    "    with tempfile.NamedTemporaryFile(delete=False, suffix=\".db\") as tmp:\n",
    "        tmp.write(raw_bytes)\n",
    "        tmp_path = tmp.name\n",
    "    try:\n",
    "        conn = sqlite3.connect(tmp_path)\n",
    "        tables = pd.read_sql(\"SELECT name FROM sqlite_master WHERE type='table'\", conn)[\"name\"].tolist()\n",
    "        tbl = table_name if table_name and table_name in tables else tables[0]\n",
    "        df = pd.read_sql(f\"SELECT * FROM [{tbl}]\", conn)\n",
    "        conn.close()\n",
    "    finally:\n",
    "        os.unlink(tmp_path)\n",
    "    return df\n",
    "\n",
    "\n",
    "def _load_sklearn_dataset(dataset_name: str):\n",
    "    \"\"\"Load a built-in sklearn toy dataset as a DataFrame.\"\"\"\n",
    "    from sklearn import datasets as _ds\n",
    "    loaders = {\n",
    "        \"iris\": _ds.load_iris,\n",
    "        \"wine\": _ds.load_wine,\n",
    "        \"breast_cancer\": _ds.load_breast_cancer,\n",
    "        \"diabetes\": _ds.load_diabetes,\n",
    "        \"digits\": _ds.load_digits,\n",
    "        \"boston\": None,  # deprecated\n",
    "        \"california_housing\": _ds.fetch_california_housing,\n",
    "        \"titanic\": None,\n",
    "    }\n",
    "    if dataset_name not in loaders or loaders[dataset_name] is None:\n",
    "        raise ValueError(f\"Dataset '{dataset_name}' not available. Choose from: {list(loaders.keys())}\")\n",
    "    bunch = loaders[dataset_name]()\n",
    "    df = pd.DataFrame(bunch.data, columns=bunch.feature_names)\n",
    "    if hasattr(bunch, \"target\"):\n",
    "        df[\"target\"] = bunch.target\n",
    "    return df\n",
    "\n",
    "\n",
    "def _load_from_url(url: str, source_type: str, **kwargs) -> object:\n",
    "    \"\"\"Download a file from URL or load from a local path, and parse it.\"\"\"\n",
    "    if url.startswith(\"https://\") or url.startswith(\"http://\"):\n",
    "        req = urllib.request.Request(url, headers={\"User-Agent\": \"Mozilla/5.0\"})\n",
    "        with urllib.request.urlopen(req, timeout=30) as resp:\n",
    "            raw = resp.read()\n",
    "        filename = url.split(\"?\")[0].split(\"/\")[-1] or \"data.csv\"\n",
    "        return _read_file_bytes(raw, filename, source_type, **kwargs)\n",
    "    else:\n",
    "        # Treat as local file path\n",
    "        with open(url, \"rb\") as f:\n",
    "            raw = f.read()\n",
    "        filename = os.path.basename(url) or \"data.raw\"\n",
    "        return _read_file_bytes(raw, filename, source_type, **kwargs)\n",
    "\n",
    "\n",
    "def _load_zip_batch(raw_bytes: bytes, source_type: str, **kwargs) -> dict:\n",
    "    \"\"\"\n",
    "    Unzip and load all matching files inside a ZIP archive.\n",
    "    Returns a dict: {filename_stem → loaded_object}\n",
    "    \"\"\"\n",
    "    result = {}\n",
    "    with zipfile.ZipFile(io.BytesIO(raw_bytes)) as zf:\n",
    "        for name in zf.namelist():\n",
    "            if name.endswith(\"/\"):\n",
    "                continue  # skip directories\n",
    "            ext = name.rsplit(\".\", 1)[-1].lower() if \".\" in name else \"\"\n",
    "            file_bytes = zf.read(name)\n",
    "            stem = os.path.splitext(os.path.basename(name))[0]\n",
    "            try:\n",
    "                obj = _read_file_bytes(file_bytes, name, source_type, **kwargs)\n",
    "                result[stem] = obj\n",
    "            except Exception as e:\n",
    "                result[stem + \"__ERROR\"] = str(e)\n",
    "    return result\n",
    "\n",
    "\n",
