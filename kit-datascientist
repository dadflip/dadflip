    "# ============================================================\n",
    "# CELLULE 4 — NETTOYAGE DES DONNÉES (Valeurs Manquantes & Outliers)\n",
    "# Supporte : DataFrames tabulaires + pass-through Images, Textes, Graphes\n",
    "# ============================================================\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, HTML, clear_output\n",
    "\n",
    "class AdvancedCleaner:\n",
    "    missing_options = [\n",
    "        ('Ne rien faire', 'none'),\n",
    "        ('Supprimer les lignes (NA)', 'drop_rows'),\n",
    "        ('Supprimer la colonne', 'drop_cols'),\n",
    "        ('Remplacer : Moyenne', 'mean'),\n",
    "        ('Remplacer : Médiane', 'median'),\n",
    "        ('Remplacer : Mode', 'mode'),\n",
    "        ('Remplacer : 0', 'zero'),\n",
    "        ('Propagation : Avant', 'ffill'),\n",
    "        ('Propagation : Arrière', 'bfill')\n",
    "    ]\n",
    "    \n",
    "    outlier_options = [\n",
    "        ('Ne rien faire', 'none'),\n",
    "        ('Écrêtage IQR', 'clip_iqr'),\n",
    "        ('Écrêtage 1%-99%', 'clip_percentile'),\n",
    "        ('Supprimer IQR', 'drop_iqr'),\n",
    "        ('Supprimer Z-Score', 'drop_zscore')\n",
    "    ]\n",
    "\n",
    "    def __init__(self, raw_datasets, meta):\n",
    "        # -------------------------------------------------------\n",
    "        # NOUVEAU : on sépare les DataFrames des autres types\n",
    "        # Les données non-tabulaires (images, textes, graphes)\n",
    "        # sont conservées telles quelles dans self.results\n",
    "        # pour être transmises à la cellule 5 sans modification.\n",
    "        # -------------------------------------------------------\n",
    "        self.all_datasets = raw_datasets  # référence complète (tous types)\n",
    "        \n",
    "        self.original_datasets = {\n",
    "            k: v.copy()\n",
    "            for k, v in raw_datasets.items()\n",
    "            if isinstance(v, pd.DataFrame)\n",
    "        }\n",
    "        self.current_datasets = {\n",
    "            k: v.copy()\n",
    "            for k, v in self.original_datasets.items()\n",
    "        }\n",
    "        self.meta = meta\n",
    "        self.current_ds = None\n",
    "        self.row_widgets = {}\n",
    "        self._build_ui()\n",
    "\n",
    "    # ----------------------------------------------------------\n",
    "    # NOUVEAU : results expose TOUS les datasets (tabulaires\n",
    "    # nettoyés + non-tabulaires pass-through) pour la cellule 5.\n",
    "    # ----------------------------------------------------------\n",
    "    @property\n",
    "    def results(self):\n",
    "        merged = {}\n",
    "        # 1. Datasets non-tabulaires — transmis sans modification\n",
    "        for k, v in self.all_datasets.items():\n",
    "            if not isinstance(v, pd.DataFrame):\n",
    "                merged[k] = v\n",
    "        # 2. DataFrames nettoyés (ou originaux si non traités)\n",
    "        for k, v in self.current_datasets.items():\n",
    "            merged[k] = v\n",
    "        return merged\n",
    "\n",
    "    def _build_ui(self):\n",
    "        # Bannière récapitulant les datasets non-tabulaires pass-through\n",
    "        non_tabular_keys = [\n",
    "            k for k, v in self.all_datasets.items()\n",
    "            if not isinstance(v, pd.DataFrame)\n",
    "        ]\n",
    "\n",
    "        if not self.original_datasets and not non_tabular_keys:\n",
    "            self.ui = widgets.HTML(\n",
    "                \"<div style='padding:12px; border-left:4px solid #ef4444; \"\n",
    "                \"background:#fef2f2; color:#b91c1c;'>\"\n",
    "                \"Aucun dataset détecté pour le nettoyage.</div>\"\n",
    "            )\n",
    "            return\n",
    "\n",
    "        header_html = (\n",
    "            \"<div style='border-bottom: 2px solid #e2e8f0; margin-bottom: 15px; \"\n",
    "            \"padding-bottom: 10px;'>\"\n",
    "            \"<h2 style='font-size:20px; color:#0f172a; margin:0;'>\"\n",
    "            \"Nettoyage Centralisé par Colonne</h2></div>\"\n",
    "        )\n",
    "\n",
    "        # Info-box pour les types non tabulaires\n",
    "        passthrough_box = widgets.HTML(\"\")\n",
    "        if non_tabular_keys:\n",
    "            labels_html = \"\".join(\n",
    "                f\"<li style='margin-bottom:4px;'>\"\n",
    "                f\"<b>{k}</b> — {type(self.all_datasets[k]).__name__}</li>\"\n",
    "                for k in non_tabular_keys\n",
    "            )\n",
    "            passthrough_box = widgets.HTML(\n",
    "                f\"<div style='padding:12px; background:#eff6ff; border:1px solid #bfdbfe; \"\n",
    "                f\"border-radius:6px; margin-bottom:12px;'>\"\n",
    "                f\"<b style='color:#1e40af;'>ℹ️ Datasets non-tabulaires \"\n",
    "                f\"(transmis intacts à l'encodage) :</b>\"\n",
    "                f\"<ul style='margin:8px 0 0 20px; font-size:13px; color:#1e40af;'>\"\n",
    "                f\"{labels_html}</ul></div>\"\n",
    "            )\n",
    "\n",
    "        if not self.original_datasets:\n",
    "            # Aucun DataFrame : UI minimale avec juste la bannière pass-through\n",
    "            self.ui = widgets.VBox([\n",
    "                widgets.HTML(header_html),\n",
    "                passthrough_box,\n",
    "                widgets.HTML(\n",
    "                    \"<div style='padding:12px; background:#fef9c3; \"\n",
    "                    \"border-left:4px solid #ca8a04; color:#713f12; border-radius:4px;'>\"\n",
    "                    \"Aucun DataFrame tabulaire à nettoyer. \"\n",
    "                    \"Les données non-tabulaires seront transmises directement.</div>\"\n",
    "                )\n",
    "            ])\n",
    "            return\n",
    "\n",
    "        # --- Sélecteur de dataset tabulaire ---\n",
    "        self.ds_selector = widgets.Dropdown(\n",
    "            options=list(self.original_datasets.keys()),\n",
    "            description='Dataset:',\n",
    "            layout=widgets.Layout(width='350px'),\n",
    "            style={'description_width': 'initial'}\n",
    "        )\n",
    "        self.ds_selector.observe(self.on_ds_change, names='value')\n",
    "        self.current_ds = self.ds_selector.value\n",
    "\n",
    "        # --- Quick Actions ---\n",
    "        self.btn_sel_all  = widgets.Button(description='Tout Sélect.',    layout=widgets.Layout(width='auto', padding='0 10px'))\n",
    "        self.btn_sel_num  = widgets.Button(description='Sélect. Num.',    layout=widgets.Layout(width='auto', padding='0 10px'))\n",
    "        self.btn_sel_cat  = widgets.Button(description='Sélect. Cat.',    layout=widgets.Layout(width='auto', padding='0 10px'))\n",
    "        self.btn_sel_none = widgets.Button(description='Désélectionner',  layout=widgets.Layout(width='auto', padding='0 10px'))\n",
    "\n",
    "        self.btn_sel_all.on_click(lambda b: self._apply_selection('all'))\n",
    "        self.btn_sel_num.on_click(lambda b: self._apply_selection('num'))\n",
    "        self.btn_sel_cat.on_click(lambda b: self._apply_selection('cat'))\n",
    "        self.btn_sel_none.on_click(lambda b: self._apply_selection('none'))\n",
    "\n",
    "        self.qa_missing = widgets.Dropdown(\n",
    "            options=self.missing_options,\n",
    "            description='Variables Manquantes:',\n",
    "            layout=widgets.Layout(width='280px'),\n",
    "            style={'description_width': 'max-content'}\n",
    "        )\n",
    "        self.qa_outlier = widgets.Dropdown(\n",
    "            options=self.outlier_options,\n",
    "            description='Valeurs Extrêmes:',\n",
    "            layout=widgets.Layout(width='280px'),\n",
    "            style={'description_width': 'max-content'}\n",
    "        )\n",
    "        self.btn_apply_qa = widgets.Button(\n",
    "            description='Appliquer aux sélections',\n",
    "            button_style='info',\n",
    "            layout=widgets.Layout(width='auto', padding='0 15px')\n",
    "        )\n",
    "        self.btn_apply_qa.on_click(self._apply_quick_action)\n",
    "\n",
    "        qa_box = widgets.VBox([\n",
    "            widgets.HBox([\n",
    "                widgets.HTML(\"<b style='width: 140px; display: inline-block;'>Sélection :</b>\"),\n",
    "                self.btn_sel_all, self.btn_sel_num, self.btn_sel_cat, self.btn_sel_none\n",
    "            ], layout=widgets.Layout(align_items='center', margin='0 0 10px 0', gap='8px')),\n",
    "            widgets.HBox([\n",
    "                widgets.HTML(\"<b style='width: 140px; display: inline-block;'>Actions de groupe :</b>\"),\n",
    "                self.qa_missing, self.qa_outlier, self.btn_apply_qa\n",
    "            ], layout=widgets.Layout(align_items='center', gap='8px'))\n",
    "        ], layout=widgets.Layout(\n",
    "            margin='0 0 15px 0', padding='10px',\n",
    "            border='1px solid #e2e8f0',\n",
    "            background='#f8fafc', border_radius='6px'\n",
    "        ))\n",
    "\n",
    "        self.table_container = widgets.VBox(layout=widgets.Layout(\n",
    "            width='100%', max_height='500px', overflow_y='auto',\n",
    "            border='1px solid #cbd5e1', border_radius='4px', padding='5px'\n",
    "        ))\n",
    "\n",
    "        self.btn_apply_all = widgets.Button(\n",
    "            description='Exécuter le nettoyage', button_style='success',\n",
    "            icon='play', layout=widgets.Layout(width='auto', padding='0 20px', height='36px')\n",
    "        )\n",
    "        self.btn_reset = widgets.Button(\n",
    "            description='Restaurer le dataset original', button_style='warning',\n",
    "            icon='undo', layout=widgets.Layout(width='auto', padding='0 20px', height='36px')\n",
    "        )\n",
    "\n",
    "        self.btn_apply_all.on_click(self._execute_cleaning)\n",
    "        self.btn_reset.on_click(self._reset_dataset)\n",
    "\n",
    "        actions_box = widgets.HBox(\n",
    "            [self.btn_apply_all, self.btn_reset],\n",
    "            layout=widgets.Layout(margin='15px 0 0 0', gap='10px', justify_content='flex-end')\n",
    "        )\n",
    "\n",
    "        self.out_logs = widgets.Output()\n",
    "\n",
    "        self.ui = widgets.VBox([\n",
    "            widgets.HTML(header_html),\n",
    "            passthrough_box,\n",
    "            self.ds_selector,\n",
    "            widgets.HTML(\"<div style='height: 10px;'></div>\"),\n",
    "            qa_box,\n",
    "            self.table_container,\n",
    "            actions_box,\n",
    "            self.out_logs\n",
    "        ], layout=widgets.Layout(width='100%', padding='20px', background='white', border_radius='8px'))\n",
    "\n",
    "        self.on_ds_change(None)\n",
    "\n",
    "    def on_ds_change(self, change):\n",
    "        if change:\n",
    "            self.current_ds = change.new\n",
    "        self._build_table()\n",
    "\n",
    "    def _apply_selection(self, mode):\n",
    "        for col, wgts in self.row_widgets.items():\n",
    "            if mode == 'all':   wgts['cb'].value = True\n",
    "            elif mode == 'none': wgts['cb'].value = False\n",
    "            elif mode == 'num':  wgts['cb'].value = wgts['is_num']\n",
    "            elif mode == 'cat':  wgts['cb'].value = not wgts['is_num']\n",
    "\n",
    "    def _apply_quick_action(self, b):\n",
    "        m_val = self.qa_missing.value\n",
    "        o_val = self.qa_outlier.value\n",
    "        for col, wgts in self.row_widgets.items():\n",
    "            if wgts['cb'].value:\n",
    "                if m_val != 'none': wgts['missing'].value = m_val\n",
    "                if o_val != 'none' and wgts['is_num']: wgts['outlier'].value = o_val\n",
    "\n",
    "    def _build_table(self):\n",
    "        df = self.current_datasets[self.current_ds]\n",
    "\n",
    "        header = widgets.HBox([\n",
    "            widgets.HTML(\"<div style='width:30px; text-align:center; color:#475569;'><b>Sel</b></div>\",\n",
    "                         layout=widgets.Layout(width='40px')),\n",
    "            widgets.HTML(\"<div style='width:180px; color:#475569;'><b>Nom de la Colonne</b></div>\",\n",
    "                         layout=widgets.Layout(width='190px')),\n",
    "            widgets.HTML(\"<div style='width:90px; color:#475569;'><b>Type</b></div>\",\n",
    "                         layout=widgets.Layout(width='100px')),\n",
    "            widgets.HTML(\"<div style='width:90px; color:#475569;'><b>Valeurs Manquantes</b></div>\",\n",
    "                         layout=widgets.Layout(width='100px')),\n",
    "            widgets.HTML(\"<div style='color:#475569;'><b>Traitement des Manquants</b></div>\",\n",
    "                         layout=widgets.Layout(width='210px')),\n",
    "            widgets.HTML(\"<div style='color:#475569;'><b>Traitement des Extrêmes</b></div>\",\n",
    "                         layout=widgets.Layout(width='210px'))\n",
    "        ], layout=widgets.Layout(\n",
    "            border_bottom='2px solid #94a3b8', padding='8px 0',\n",
    "            background='#f8fafc', align_items='center'\n",
    "        ))\n",
    "\n",
    "        rows = [header]\n",
    "        self.row_widgets = {}\n",
    "\n",
    "        type_trans = {\n",
    "            'datetime': 'Date/Heure', 'binary': 'Binaire',\n",
    "            'numeric': 'Numérique', 'text': 'Texte',\n",
    "            'id_like': 'ID / Unique', 'categorical': 'Catégoriel'\n",
    "        }\n",
    "\n",
    "        for col in df.columns:\n",
    "            meta_kind = (\n",
    "                self.meta[self.current_ds][col]['kind']\n",
    "                if self.current_ds in self.meta and col in self.meta[self.current_ds]\n",
    "                else 'categorical'\n",
    "            )\n",
    "            is_num     = (meta_kind == 'numeric')\n",
    "            dtype_str  = type_trans.get(meta_kind, meta_kind.capitalize())\n",
    "            missing_cnt = df[col].isna().sum()\n",
    "            missing_pct = (missing_cnt / len(df)) * 100 if len(df) > 0 else 0\n",
    "\n",
    "            cb = widgets.Checkbox(\n",
    "                value=False, indent=False,\n",
    "                layout=widgets.Layout(width='30px', margin='0 0 0 5px')\n",
    "            )\n",
    "            lbl_col = widgets.HTML(\n",
    "                f\"<div style='width:180px; white-space:normal; overflow-wrap:anywhere; \"\n",
    "                f\"word-break:break-word; font-weight:600; color:#1e293b;'>{col}</div>\",\n",
    "                layout=widgets.Layout(width='190px', overflow='hidden')\n",
    "            )\n",
    "            lbl_type = widgets.HTML(\n",
    "                f\"<div style='font-size:12px; color:#64748b; width:90px; \"\n",
    "                f\"white-space:normal; overflow-wrap:anywhere; word-break:break-word;'>{dtype_str}</div>\",\n",
    "                layout=widgets.Layout(width='100px', overflow='hidden')\n",
    "            )\n",
    "\n",
    "            color_m = \"#ef4444\" if missing_pct > 20 else (\"#eab308\" if missing_cnt > 0 else \"#10b981\")\n",
    "            lbl_miss = widgets.HTML(\n",
    "                f\"<div style='color:{color_m}; font-weight:600; width:90px; font-size:13px; line-height:1.2;'>\"\n",
    "                f\"{missing_pct:.1f}%<br><span style='font-size:11px; color:#94a3b8; font-weight:normal;'>\"\n",
    "                f\"({missing_cnt} NA)</span></div>\",\n",
    "                layout=widgets.Layout(width='100px', overflow='hidden')\n",
    "            )\n",
    "\n",
    "            dd_miss = widgets.Dropdown(\n",
    "                options=self.missing_options, value='none',\n",
    "                layout=widgets.Layout(width='200px', margin='0 10px 0 0')\n",
    "            )\n",
    "            dd_out = widgets.Dropdown(\n",
    "                options=self.outlier_options, value='none',\n",
    "                disabled=not is_num,\n",
    "                layout=widgets.Layout(width='200px')\n",
    "            )\n",
    "\n",
    "            self.row_widgets[col] = {'cb': cb, 'is_num': is_num, 'missing': dd_miss, 'outlier': dd_out}\n",
    "\n",
    "            row = widgets.HBox(\n",
    "                [cb, lbl_col, lbl_type, lbl_miss, dd_miss, dd_out],\n",
    "                layout=widgets.Layout(\n",
    "                    border_bottom='1px solid #e2e8f0', padding='6px 0',\n",
    "                    align_items='center', min_height='50px'\n",
    "                )\n",
    "            )\n",
    "            rows.append(row)\n",
    "\n",
    "        self.table_container.children = rows\n",
    "\n",
    "    def _reset_dataset(self, b):\n",
    "        with self.out_logs:\n",
    "            clear_output()\n",
    "            self.current_datasets[self.current_ds] = self.original_datasets[self.current_ds].copy()\n",
    "            display(HTML(\n",
    "                \"<div style='padding:12px; background:#fffbeb; color:#b45309; \"\n",
    "                \"border-radius:6px; border:1px solid #fcd34d;'>\"\n",
    "                \"Dataset <b>restauré</b> avec succès à son état initial.</div>\"\n",
    "            ))\n",
    "            self._build_table()\n",
    "\n",
    "    def _execute_cleaning(self, b):\n",
    "        with self.out_logs:\n",
    "            clear_output()\n",
    "            df = self.current_datasets[self.current_ds]\n",
    "            df_new = df.copy()\n",
    "\n",
    "            logs = []\n",
    "            cols_to_drop = []\n",
    "\n",
    "            for col, wgts in self.row_widgets.items():\n",
    "                if col not in df_new.columns:\n",
    "                    continue\n",
    "\n",
    "                m_act = wgts['missing'].value\n",
    "                o_act = wgts['outlier'].value\n",
    "\n",
    "                if m_act == 'none' and o_act == 'none':\n",
    "                    continue\n",
    "\n",
    "                if m_act == 'drop_cols':\n",
    "                    cols_to_drop.append(col)\n",
    "                    logs.append(f\"<b>{col}</b> : Colonne supprimée.\")\n",
    "                    continue\n",
    "\n",
    "                if m_act == 'drop_rows':\n",
    "                    initial_len = len(df_new)\n",
    "                    df_new.dropna(subset=[col], inplace=True)\n",
    "                    delta = initial_len - len(df_new)\n",
    "                    if delta > 0:\n",
    "                        logs.append(f\"<b>{col}</b> : {delta} lignes supprimées (NA).\")\n",
    "                elif m_act == 'mean' and wgts['is_num']:\n",
    "                    df_new[col] = df_new[col].fillna(df_new[col].mean())\n",
    "                    logs.append(f\"<b>{col}</b> : Manquants remplacés par la moyenne.\")\n",
    "                elif m_act == 'median' and wgts['is_num']:\n",
    "                    df_new[col] = df_new[col].fillna(df_new[col].median())\n",
    "                    logs.append(f\"<b>{col}</b> : Manquants remplacés par la médiane.\")\n",
    "                elif m_act == 'mode':\n",
    "                    modes = df_new[col].mode()\n",
    "                    if not modes.empty:\n",
    "                        df_new[col] = df_new[col].fillna(modes.iloc[0])\n",
    "                        logs.append(f\"<b>{col}</b> : Manquants remplacés par le mode.\")\n",
    "                elif m_act == 'zero':\n",
    "                    val = 0 if wgts['is_num'] else '0'\n",
    "                    df_new[col] = df_new[col].fillna(val)\n",
    "                    logs.append(f\"<b>{col}</b> : Manquants remplacés par 0.\")\n",
    "                elif m_act == 'ffill':\n",
    "                    df_new[col] = df_new[col].ffill()\n",
    "                    logs.append(f\"<b>{col}</b> : Manquants propagés (Avant - ffill).\")\n",
    "                elif m_act == 'bfill':\n",
    "                    df_new[col] = df_new[col].bfill()\n",
    "                    logs.append(f\"<b>{col}</b> : Manquants propagés (Arrière - bfill).\")\n",
    "\n",
    "                if o_act != 'none' and wgts['is_num']:\n",
    "                    initial_len = len(df_new)\n",
    "                    if o_act == 'clip_iqr':\n",
    "                        q1, q3 = df_new[col].quantile(0.25), df_new[col].quantile(0.75)\n",
    "                        iqr = q3 - q1\n",
    "                        df_new[col] = df_new[col].clip(lower=q1 - 1.5 * iqr, upper=q3 + 1.5 * iqr)\n",
    "                        logs.append(f\"<b>{col}</b> : Extrêmes écrêtés (Norme IQR).\")\n",
    "                    elif o_act == 'clip_percentile':\n",
    "                        df_new[col] = df_new[col].clip(\n",
    "                            lower=df_new[col].quantile(0.01),\n",
    "                            upper=df_new[col].quantile(0.99)\n",
    "                        )\n",
    "                        logs.append(f\"<b>{col}</b> : Extrêmes écrêtés (Percentiles 1%-99%).\")\n",
    "                    elif o_act == 'drop_iqr':\n",
    "                        q1, q3 = df_new[col].quantile(0.25), df_new[col].quantile(0.75)\n",
    "                        iqr = q3 - q1\n",
    "                        df_new = df_new[\n",
    "                            (df_new[col] >= q1 - 1.5 * iqr) &\n",
    "                            (df_new[col] <= q3 + 1.5 * iqr)\n",
    "                        ].copy()\n",
    "                        logs.append(f\"<b>{col}</b> : {initial_len - len(df_new)} lignes extrêmes supprimées (IQR).\")\n",
    "                    elif o_act == 'drop_zscore':\n",
    "                        std = df_new[col].std()\n",
    "                        if std > 0:\n",
    "                            df_new = df_new[\n",
    "                                ((df_new[col] - df_new[col].mean()) / std).abs() <= 3\n",
    "                            ].copy()\n",
    "                            logs.append(f\"<b>{col}</b> : {initial_len - len(df_new)} lignes extrêmes supprimées (Z-Score > 3).\")\n",
    "\n",
    "            if cols_to_drop:\n",
    "                df_new.drop(columns=cols_to_drop, inplace=True)\n",
    "\n",
    "            self.current_datasets[self.current_ds] = df_new\n",
    "\n",
    "            if not logs:\n",
    "                display(HTML(\n",
    "                    \"<div style='padding:12px; background:#eff6ff; color:#1e40af; \"\n",
    "                    \"border-radius:6px; border:1px solid #bfdbfe;'>\"\n",
    "                    \"Aucune action de modification n'a été spécifiée.</div>\"\n",
    "                ))\n",
    "            else:\n",
    "                html_logs = (\n",
    "                    \"<ul style='margin:10px 0 0 25px; font-size:13px; color:#166534;'>\" +\n",
    "                    \"\".join([f\"<li style='margin-bottom:4px;'>{l}</li>\" for l in logs]) +\n",
    "                    \"</ul>\"\n",
    "                )\n",
    "                display(HTML(\n",
    "                    f\"<div style='padding:14px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:6px;'>\"\n",
    "                    f\"<b style='color:#15803d; font-size:15px;'>Nettoyage appliqué avec succès</b>\"\n",
    "                    f\"{html_logs}</div>\"\n",
    "                ))\n",
    "\n",
    "            self._build_table()\n",
    "\n",
    "    def show(self):\n",
    "        display(self.ui)\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------\n",
    "# Instanciation — compatible avec un loader contenant des types mixtes\n",
    "# ----------------------------------------------------------------\n",
    "if 'eda' in locals() and loader.get_all():\n",
    "    cleaner = AdvancedCleaner(loader.get_all(), eda.meta)\n",
    "    cleaner.show()\n",
    "else:\n",
    "    display(HTML(\n",
    "        \"<div style='padding:12px; background:#fef2f2; border-left:4px solid #ef4444; \"\n",
    "        \"color:#991b1b; border-radius:4px;'>\"\n",
    "        \"Veuillez exécuter l'étape 1 pour insérer des données dans le buffer.</div>\"\n",
    "    ))"
   ]
