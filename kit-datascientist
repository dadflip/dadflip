    "# ============================================================\n",
    "# CELLULE 6 — NORMALISATION (Mise à l'échelle)\n",
    "# ============================================================\n",
    "class NormalizationManager:\n",
    "    def __init__(self, encoded_datasets):\n",
    "        self.datasets = encoded_datasets\n",
    "        self.results = {}\n",
    "\n",
    "    def show(self):\n",
    "        display(HTML(\"<h3>Normalisation des Variables Numériques</h3>\"))\n",
    "        if not self.datasets:\n",
    "            print(\"Aucune donnée encodée à normaliser.\")\n",
    "            return\n",
    "            \n",
    "        ds_dd = widgets.Dropdown(options=list(self.datasets.keys()), description='Jeu T.')\n",
    "        meth_dd = widgets.Dropdown(options=['StandardScaler', 'MinMaxScaler', 'RobustScaler'], description='Méthode :')\n",
    "        btn_norm = widgets.Button(description='Normaliser', button_style='success')\n",
    "        out_norm = widgets.Output()\n",
    "\n",
    "        def run_norm(b):\n",
    "            with out_norm:\n",
    "                clear_output()\n",
    "                lbl = ds_dd.value\n",
    "                df = self.datasets[lbl].copy()\n",
    "                \n",
    "                # Automatically select all numeric columns\n",
    "                num_cols = df.select_dtypes(include=[np.number]).columns.tolist()\n",
    "                \n",
    "                if meth_dd.value == 'StandardScaler': scaler = StandardScaler()\n",
    "                elif meth_dd.value == 'MinMaxScaler': scaler = MinMaxScaler()\n",
    "                else: scaler = RobustScaler()\n",
    "                \n",
    "                if num_cols:\n",
    "                    df[num_cols] = scaler.fit_transform(df[num_cols])\n",
    "                    self.results[lbl] = df\n",
    "                    \n",
    "                    display(HTML(f\"<div style='padding:10px; border-left:4px solid green; background-color:#e8f5e9;'>\"\n",
    "                                 f\"<b>Normalisation ({meth_dd.value}) appliquée sur {lbl} !</b><br>\"\n",
    "                                 f\"Variables transformées : {len(num_cols)} variables quantitatives.\"\n",
    "                                 f\"</div>\"))\n",
    "                                 \n",
    "                    display(df.head())\n",
    "                else:\n",
    "                    print(\"Aucune colonne numérique détectée après l'encodage.\")\n",
    "                    \n",
    "        btn_norm.on_click(run_norm)\n",
    "        display(widgets.HBox([ds_dd, meth_dd, btn_norm]))\n",
    "        display(out_norm)\n",
    "\n",
    "if 'encoder' in locals() and encoder.results:\n",
    "    normalizer = NormalizationManager(encoder.results)\n",
    "    normalizer.show()\n",
    "else:\n",
    "    print(\"Veuillez appliquer l'encodage (Cellule 5) avant de normaliser.\")\n"
