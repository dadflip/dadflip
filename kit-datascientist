    "#   \"check\"       : list of importable module names (for verification)\n",
    "#   \"default\"     : bool — pre-checked in the UI\n",
    "#   \"required\"    : bool — cannot be unchecked (greyed out, always installed)\n",
    "# ============================================================\n",
    "\n",
