    "                        obj = obj.sample(frac=self._sample_frac.value / 100.0, random_state=self._random_state.value)\n",
    "\n",
    "                self.state.data_raw[label] = obj\n",
    "                self.state.data_types[label] = src\n",
    "                loaded.append(label)\n",
    "\n",
    "        # ---- file upload ----\n",
    "        else:\n",
    "            for slot_name, upload_btn in self._slots:\n",
