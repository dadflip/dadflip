    "        self.multi_hue.value = '(Aucun)'\n",
    "        \n",
    "        self.refresh_recap()\n",
    "        \n",
    "    def refresh_recap(self):\n",
    "        with self.out_recap:\n",
    "            clear_output()\n",
    "            df = self.datasets[self.current_ds]\n",
    "            meta = self.meta[self.current_ds]\n",
    "            \n",
    "            rows = [{'Variable': c, 'Type': m['kind'], 'Manquants': f\"{m['missing']} ({m['pct_miss']:.1f}%)\", 'Uniques': m['n_unique'], 'Sample (Top 1)': str(df[c].dropna().head(1).values[0]) if m['missing']<len(df) else 'NaN'} for c, m in meta.items()]\n",
    "            \n",
    "            display(HTML(\"<h4 style='margin-bottom:8px;'>Méta-données & Qualité</h4>\"))\n",
    "            # Make the DataFrame look good\n",
    "            styled_df = pd.DataFrame(rows).set_index('Variable')\n",
    "            display(styled_df)\n",
    "            \n",
    "            display(HTML(\"<br><h4 style='margin-bottom:8px;'>Statistiques Descriptives (Describe)</h4>\"))\n",
    "            if not df.select_dtypes(include=np.number).empty:\n",
    "                display(df.describe().T)\n",
    "            else: display(HTML(\"<i style='color:#64748b;'>Aucune variable numérique pour obtenir des statistiques de base.</i>\"))\n",
    "\n",
    "    def run_univ(self, b):\n",
    "        with self.out_univ:\n",
    "            clear_output(wait=True)\n",
    "            df = self.datasets[self.current_ds]\n",
    "            cols = self.univ_cols_ui.value\n",
    "            p_type = self.univ_plot_type.value\n",
    "            hue = self.univ_hue.value if self.univ_hue.value != '(Aucun)' else None\n",
    "            bins = self.univ_bins.value\n",
    "            log = self.univ_log.value\n",
    "            \n",
    "            if not cols:\n",
    "                print(\"Sélectionnez au moins une colonne.\")\n",
    "                return\n",
    "\n",
    "            n = len(cols)\n",
    "            fig = plt.figure(figsize=(10, 5 * n))\n",
    "            \n",
    "            for i, c in enumerate(cols):\n",
    "                ax = fig.add_subplot(n, 1, i + 1)\n",
    "                try:\n",
    "                    if p_type == 'Histogramme':\n",
    "                        sns.histplot(data=df, x=c, hue=hue, bins=bins, kde=True, log_scale=log, ax=ax)\n",
    "                        plt.setp(ax.get_xticklabels(), rotation=45, ha='right')\n",
    "                    elif p_type == 'Boxplot':\n",
    "                        sns.boxplot(data=df, y=c, x=hue, ax=ax)\n",
    "                        plt.setp(ax.get_xticklabels(), rotation=45, ha='right')\n",
    "                    elif p_type == 'Violin':\n",
    "                        sns.violinplot(data=df, y=c, x=hue, split=(df[hue].nunique()==2 if hue else False), ax=ax)\n",
    "                        plt.setp(ax.get_xticklabels(), rotation=45, ha='right')\n",
    "                    elif p_type == 'KDE':\n",
    "                        sns.kdeplot(data=df, x=c, hue=hue, fill=True, log_scale=log, ax=ax)\n",
    "                        plt.setp(ax.get_xticklabels(), rotation=45, ha='right')\n",
    "                    elif p_type == 'Bar Chart':\n",
    "                        val_counts = df[c].value_counts().head(bins)\n",
    "                        if hue:\n",
    "                            sns.countplot(data=df[df[c].isin(val_counts.index)], x=c, hue=hue, ax=ax)\n",
    "                        else:\n",
    "                            sns.barplot(x=val_counts.index, y=val_counts.values, ax=ax)\n",
    "                        plt.setp(ax.get_xticklabels(), rotation=45, ha='right')\n",
    "                    elif p_type == 'Pie Chart':\n",
    "                        val_counts = df[c].value_counts().head(bins)\n",
    "                        ax.pie(val_counts, labels=val_counts.index, autopct='%1.1f%%', startangle=90)\n",
    "                    elif p_type == 'Line (Freq)':\n",
    "                        val_counts = df[c].value_counts().sort_index()\n",
    "                        sns.lineplot(x=val_counts.index, y=val_counts.values, ax=ax)\n",
    "                        plt.setp(ax.get_xticklabels(), rotation=45, ha='right')\n",
    "                    \n",
    "                    ax.set_title(f\"Analyse Univariée : {c} ({p_type})\")\n",
    "                except Exception as e:\n",
    "                    ax.text(0.5, 0.5, f\"Erreur : {e}\", ha='center', va='center')\n",
    "                    \n",
    "            plt.tight_layout()\n",
    "            plt.show()\n",
    "\n",
    "    def run_biv(self, b):\n",
    "        with self.out_biv:\n",
    "            clear_output(wait=True)\n",
    "            df = self.datasets[self.current_ds]\n",
    "            x_val, y_val = self.biv_x.value, self.biv_y.value\n",
    "            p_type = self.biv_plot_type.value\n",
    "            hue = self.biv_hue.value if self.biv_hue.value != '(Aucun)' else None\n",
    "            alpha = self.biv_alpha.value\n",
    "            \n",
    "            x_cols = list(df.columns) if x_val == '(TOUTES)' else [x_val]\n",
    "            y_cols = list(df.columns) if y_val == '(TOUTES)' else [y_val]\n",
    "            \n",
    "            if len(x_cols) * len(y_cols) > 20: # Prevent crash\n",
    "                print(f\"Trop de graphiques ({len(x_cols) * len(y_cols)}). Réduisez la sélection.\")\n",
    "                return\n",
    "                \n",
    "            fig = plt.figure(figsize=(10, 6 * len(x_cols) * len(y_cols)))\n",
    "            idx = 1\n",
    "            for x in x_cols:\n",
    "                for y in y_cols:\n",
    "                    if x == y: continue\n",
    "                    ax = fig.add_subplot(len(x_cols) * len(y_cols), 1, idx)\n",
    "                    idx += 1\n",
    "                    try:\n",
    "                        if p_type == 'Scatter':\n",
    "                            sns.scatterplot(data=df, x=x, y=y, hue=hue, alpha=alpha, ax=ax)\n",
    "                            plt.setp(ax.get_xticklabels(), rotation=45, ha='right')\n",
    "                        elif p_type == 'Line':\n",
    "                            sns.lineplot(data=df, x=x, y=y, hue=hue, alpha=alpha, ax=ax)\n",
    "                            plt.setp(ax.get_xticklabels(), rotation=45, ha='right')\n",
    "                        elif p_type == 'Bar':\n",
    "                            sns.barplot(data=df, x=x, y=y, hue=hue, ax=ax)\n",
    "                            plt.setp(ax.get_xticklabels(), rotation=45, ha='right')\n",
    "                        elif p_type == 'Box':\n",
    "                            sns.boxplot(data=df, x=x, y=y, hue=hue, ax=ax)\n",
    "                            plt.setp(ax.get_xticklabels(), rotation=45, ha='right')\n",
    "                        elif p_type == 'Violin':\n",
    "                            sns.violinplot(data=df, x=x, y=y, hue=hue, split=(df[hue].nunique()==2 if hue else False), ax=ax)\n",
    "                            plt.setp(ax.get_xticklabels(), rotation=45, ha='right')\n",
    "                        elif p_type == 'Hexbin':\n",
    "                            df_cl = df[[x, y]].dropna()\n",
    "                            if pd.api.types.is_numeric_dtype(df_cl[x]) and pd.api.types.is_numeric_dtype(df_cl[y]):\n",
    "                                hb = ax.hexbin(df_cl[x], df_cl[y], gridsize=30, cmap='Blues', mincnt=1)\n",
    "                                fig.colorbar(hb, ax=ax, label='Count')\n",
    "                                plt.setp(ax.get_xticklabels(), rotation=45, ha='right')\n",
    "                            else:\n",
    "                                ax.text(0.5, 0.5, \"Hexbin : variables numériques requises.\", ha='center', va='center')\n",
    "                        ax.set_title(f\"{x} vs {y} ({p_type})\")\n",
    "                    except Exception as e:\n",
    "                        ax.text(0.5, 0.5, f\"Erreur : {e}\", ha='center', va='center')\n",
    "            \n",
    "            plt.tight_layout()\n",
    "            plt.show()\n",
    "\n",
    "    def run_multi(self, b):\n",
    "        with self.out_multi:\n",
    "            clear_output(wait=True)\n",
    "            df = self.datasets[self.current_ds]\n",
    "            p_type = self.multi_type.value\n",
    "            method = self.multi_method.value\n",
    "            vars_to_use = self.multi_vars_ui.value\n",
    "            hue = self.multi_hue.value if self.multi_hue.value != '(Aucun)' else None\n",
    "            \n",
    "            if not vars_to_use:\n",
    "                print(\"Sélectionnez au moins une variable numérique.\")\n",
    "                return\n",
    "                \n",
    "            try:\n",
    "                if p_type == 'Matrice de Corrélation':\n",
    "                    if len(vars_to_use) < 2:\n",
    "                        print(\"Sélectionnez au moins 2 variables pour calculer la corrélation.\")\n",
    "                        return\n",
    "                    corr = df[vars_to_use].corr(method=method)\n",
    "                    plt.figure(figsize=(max(8, len(vars_to_use)*1.0), max(6, len(vars_to_use)*1.0)))\n",
    "                    sns.heatmap(corr, annot=True, cmap='vlag', fmt=\".2f\", center=0, square=True, linewidths=.5, cbar_kws={\"shrink\": .7})\n",
    "                    plt.title(f\"Matrice de Corrélation ({method})\")\n",
    "                    plt.xticks(rotation=45, ha='right')\n",
    "                    plt.yticks(rotation=0)\n",
    "                    plt.tight_layout()\n",
    "                    plt.show()\n",
    "                elif p_type == 'Pairplot':\n",
    "                    if len(vars_to_use) < 2:\n",
    "                        print(\"Le Pairplot nécessite au moins 2 variables.\")\n",
    "                        return\n",
    "                    if len(vars_to_use) > 10:\n",
    "                        print(f\"Avertissement : {len(vars_to_use)} variables risquent de ralentir considérablement l'affichage.\")\n",
    "                    \n",
    "                    cols_to_plot = vars_to_use + ([hue] if hue else [])\n",
