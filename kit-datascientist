    "\n",
    "        ctrl_row1 = widgets.HBox(\n",
    "            [self.preview_rows, self.preview_sort_col, self.preview_sort_asc],\n",
    "            layout=widgets.Layout(align_items='center', gap='10px', margin='0 0 6px 0')\n",
