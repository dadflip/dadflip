    "                        if ax is not None:\n",
    "                            plt.setp(ax.get_xticklabels(), rotation=45, ha='right')\n",
    "                    plt.tight_layout()\n",
    "                    plt.show()\n",
    "            except Exception as e:\n",
    "                print(f\"Erreur d'analyse : {e}\")\n",
