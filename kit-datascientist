    "        \"check\": [\"shap\", \"lime\"],\n",
    "        \"default\": False,\n",
    "        \"required\": False,\n",
    "    },\n",
    "    {\n",
    "        \"id\": \"hpo\",\n",
    "        \"label\": \"[Hyperparameter Tuning] (Optuna, Hyperopt)\",\n",
    "        \"description\": \"optuna + hyperopt — Bayesian / TPE optimisation\",\n",
