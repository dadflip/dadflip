    "            except ValueError:\n",
    "                if val in df.columns:\n",
    "                    df = df.set_index(val)\n",
    "                    \n",
    "        pdates_w = self._adv_widgets.get(\"parse_dates\")\n",
    "        if pdates_w and pdates_w.value:\n",
