    "# ============================================================\n",
    "# CELLULE 4 — NETTOYAGE DES DONNÉES (Valeurs Manquantes & Outliers)\n",
    "# ============================================================\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, HTML, clear_output\n",
    "\n",
    "class AdvancedCleaner:\n",
    "    missing_descriptions = {\n",
    "        'none': 'Conserve les valeurs manquantes telles quelles.',\n",
    "        'drop_rows': 'Supprime toute ligne contenant au moins une valeur manquante dans les colonnes ciblées. Peut causer une forte perte d\\'observations.',\n",
    "        'drop_cols': 'Supprime intégralement du jeu de données les colonnes sélectionnées.',\n",
    "        'mean': 'Remplace les manques par la moyenne. Réservé aux variables numériques. Rapide mais sensible aux valeurs extrêmes.',\n",
    "        'median': 'Remplace les manques par la médiane. Idéal et robuste pour les variables numériques asymétriques.',\n",
    "        'mode': 'Remplace les manques par la valeur la plus fréquente de la colonne. Spécialement adapté aux données catégorielles.',\n",
    "        'constant_str': 'Remplace les espaces vides par un texte fixe (pour marquer explicitement l\\'absence d\\'information).',\n",
    "        'constant_num': 'Remplace les manques par une valeur numérique fixe déterminée par l\\'utilisateur.',\n",
    "        'ffill': 'Propagation de la dernière chronologie valide connue. Utilisé majoritairement sur les séries temporelles.',\n",
    "        'bfill': 'Propagation de la valeur valide suivante. Également destiné aux séries temporelles.'\n",
    "    }\n",
    "\n",
    "    missing_short = {\n",
    "        'drop_rows': 'Suppr. NA (Lignes)',\n",
    "        'drop_cols': 'Supprimée',\n",
    "        'mean': 'NaN -> Moyenne',\n",
    "        'median': 'NaN -> Médiane',\n",
    "        'mode': 'NaN -> Mode',\n",
    "        'constant_str': 'NaN -> Texte',\n",
    "        'constant_num': 'NaN -> Num',\n",
    "        'ffill': 'Propag. Avant',\n",
    "        'bfill': 'Propag. Arrière'\n",
    "    }\n",
    "\n",
    "    outlier_descriptions = {\n",
    "        'none': 'Aucun traitement des valeurs extrêmes. Préservation des extrêmes originaux.',\n",
    "        'clip_iqr': 'Écrêtage : Plafonne les valeurs extrêmes en utilisant la norme de l\\'écart interquartile (Q1-1.5*IQR et Q3+1.5*IQR).',\n",
    "        'clip_percentile': 'Écrêtage : Ramène les valeurs inférieures au 1er percentile et celles supérieures au 99e percentile à ces bornes strictes.',\n",
    "        'drop_iqr': 'Suppression : Élimine les lignes entières dont la valeur sort des limites IQR classiques.',\n",
    "        'drop_zscore': 'Suppression : Élimine les lignes écartées de plus de 3 écarts-types de la moyenne.'\n",
    "    }\n",
    "\n",
    "    outlier_short = {\n",
    "        'clip_iqr': 'Écrêt. IQR',\n",
    "        'clip_percentile': 'Écrêt. %ile',\n",
    "        'drop_iqr': 'Suppr. IQR',\n",
    "        'drop_zscore': 'Suppr. Z'\n",
    "    }\n",
    "\n",
    "    def __init__(self, raw_datasets, meta):\n",
    "        self.original_datasets = {k: v.copy() for k, v in raw_datasets.items() if isinstance(v, pd.DataFrame)}\n",
    "        self.current_datasets = {k: v.copy() for k, v in self.original_datasets.items()}\n",
    "        import collections\n",
    "        self.history = {k: collections.defaultdict(lambda: {'missing': [], 'outlier': []}) for k in self.original_datasets.keys()}\n",
    "        self.meta = meta\n",
    "        self.current_ds = None\n",
    "        self._build_ui()\n",
    "        \n",
    "    @property\n",
    "    def results(self):\n",
    "        return self.current_datasets\n",
    "        \n",
    "    def _build_ui(self):\n",
    "        if not self.original_datasets:\n",
    "            self.ui = widgets.HTML(\"<div style='padding:12px; border-left:4px solid #ef4444; background:#fef2f2; color:#b91c1c;'>Aucun DataFrame détecté pour le nettoyage.</div>\")\n",
    "            return\n",
    "            \n",
    "        self.ds_selector = widgets.Dropdown(options=list(self.original_datasets.keys()), description='<b>Dataset:</b>', layout=widgets.Layout(width='350px'), style={'description_width': 'initial'})\n",
    "        self.ds_selector.observe(self.on_ds_change, names='value')\n",
    "        self.current_ds = self.ds_selector.value\n",
    "        \n",
    "        # UI Elements : Columns\n",
    "        self.btn_all_cols = widgets.Button(description='Toutes', layout=widgets.Layout(width='auto', padding='0 10px'))\n",
    "        self.btn_num_cols = widgets.Button(description='Numériques', layout=widgets.Layout(width='auto', padding='0 10px'))\n",
    "        self.btn_cat_cols = widgets.Button(description='Catégorielles', layout=widgets.Layout(width='auto', padding='0 10px'))\n",
    "        self.btn_none_cols = widgets.Button(description='Aucune', layout=widgets.Layout(width='auto', padding='0 10px'))\n",
    "        self.cols_checkboxes = widgets.VBox([], layout=widgets.Layout(max_height='160px', overflow_y='auto', border='1px solid #cbd5e1', padding='8px', border_radius='4px', background='#ffffff'))\n",
    "        \n",
    "        self.btn_all_cols.on_click(lambda b: self._select_cols('all'))\n",
    "        self.btn_num_cols.on_click(lambda b: self._select_cols('num'))\n",
    "        self.btn_cat_cols.on_click(lambda b: self._select_cols('cat'))\n",
    "        self.btn_none_cols.on_click(lambda b: self._select_cols('none'))\n",
    "        \n",
    "        cols_ui = widgets.VBox([\n",
    "            widgets.HTML(\"<div style='display:flex; align-items:center; font-size:14px; font-weight:600; color:#1e293b; margin-bottom:12px;'><span style='background:#3b82f6; color:white; border-radius:50%; width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center; margin-right:8px; font-size:12px;'>1</span> Sélection des Variables Cibles</div>\"),\n",
    "            widgets.HBox([self.btn_all_cols, self.btn_num_cols, self.btn_cat_cols, self.btn_none_cols], layout=widgets.Layout(margin='0 0 12px 0', gap='8px', flex_wrap='wrap')),\n",
    "            self.cols_checkboxes\n",
    "        ], layout=widgets.Layout(margin='0 0 16px 0', padding='16px', border='1px solid #e2e8f0', border_radius='8px', background='#f8fafc', box_shadow='0 1px 2px 0 rgba(0, 0, 0, 0.05)'))\n",
    "        \n",
    "        # Missing values\n",
    "        self.missing_method = widgets.Dropdown(options=[\n",
    "            ('Ne rien faire', 'none'),\n",
    "            ('Supprimer lignes (dropna)', 'drop_rows'),\n",
    "            ('Supprimer colonnes complètes', 'drop_cols'),\n",
    "            ('Remplacer : Moyenne', 'mean'),\n",
    "            ('Remplacer : Médiane', 'median'),\n",
    "            ('Remplacer : Mode (Valeur max fréquence)', 'mode'),\n",
    "            ('Remplacer : Constante Texto', 'constant_str'),\n",
    "            ('Remplacer : Constante Numérique', 'constant_num'),\n",
    "            ('Propagation : Avant (ffill)', 'ffill'),\n",
    "            ('Propagation : Arrière (bfill)', 'bfill')\n",
    "        ], description='Stratégie:', style={'description_width': '80px'}, layout=widgets.Layout(width='100%'))\n",
    "        \n",
    "        self.missing_desc = widgets.HTML(f\"<div style='color:#64748b; font-size:12px; margin-top:8px; padding:8px; background:#f1f5f9; border-radius:4px;'><i>{self.missing_descriptions['none']}</i></div>\")\n",
    "        self.missing_method.observe(self._update_missing_desc, names='value')\n",
    "        self.missing_param_str = widgets.Text(description='Texte:', value='Inconnu', layout=widgets.Layout(display='none', margin='8px 0 0 0', width='100%'))\n",
    "        self.missing_param_num = widgets.FloatText(description='Valeur:', value=0.0, layout=widgets.Layout(display='none', margin='8px 0 0 0', width='100%'))\n",
    "        \n",
    "        missing_ui = widgets.VBox([\n",
    "            widgets.HTML(\"<div style='display:flex; align-items:center; font-size:14px; font-weight:600; color:#1e293b; margin-bottom:12px;'><span style='background:#3b82f6; color:white; border-radius:50%; width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center; margin-right:8px; font-size:12px;'>2</span> Valeurs Manquantes</div>\"),\n",
    "            self.missing_method,\n",
    "            self.missing_param_str,\n",
    "            self.missing_param_num,\n",
    "            self.missing_desc\n",
    "        ], layout=widgets.Layout(margin='0 0 16px 0', padding='16px', border='1px solid #e2e8f0', border_radius='8px', background='#f8fafc', box_shadow='0 1px 2px 0 rgba(0, 0, 0, 0.05)'))\n",
    "        \n",
    "        # Outliers\n",
    "        self.outlier_method = widgets.Dropdown(options=[\n",
    "            ('Ne rien faire', 'none'),\n",
    "            ('Écrêtage IQR (Interquartile Range)', 'clip_iqr'),\n",
    "            ('Écrêtage Percentiles (1% - 99%)', 'clip_percentile'),\n",
    "            ('Supprimer lignes avec IQR > limites', 'drop_iqr'),\n",
    "            ('Supprimer lignes avec Z-Score > 3', 'drop_zscore')\n",
    "        ], description='Stratégie:', style={'description_width': '80px'}, layout=widgets.Layout(width='100%'))\n",
    "        \n",
    "        self.outlier_desc = widgets.HTML(f\"<div style='color:#64748b; font-size:12px; margin-top:8px; padding:8px; background:#f1f5f9; border-radius:4px;'><i>{self.outlier_descriptions['none']}</i></div>\")\n",
    "        self.outlier_method.observe(self._update_outlier_desc, names='value')\n",
    "        \n",
    "        outlier_ui = widgets.VBox([\n",
    "            widgets.HTML(\"<div style='display:flex; align-items:center; font-size:14px; font-weight:600; color:#1e293b; margin-bottom:12px;'><span style='background:#f59e0b; color:white; border-radius:50%; width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center; margin-right:8px; font-size:12px;'>3</span> Valeurs Extrêmes (Numériques)</div>\"),\n",
    "            self.outlier_method,\n",
    "            self.outlier_desc\n",
    "        ], layout=widgets.Layout(margin='0 0 16px 0', padding='16px', border='1px solid #e2e8f0', border_radius='8px', background='#f8fafc', box_shadow='0 1px 2px 0 rgba(0, 0, 0, 0.05)'))\n",
    "        \n",
    "        # Actions\n",
    "        self.btn_preview = widgets.Button(description='Prévisualiser', icon='eye', button_style='info', layout=widgets.Layout(width='auto', padding='0 24px', height='36px'))\n",
    "        self.btn_apply = widgets.Button(description='Appliquer', icon='check', button_style='success', layout=widgets.Layout(width='auto', padding='0 24px', height='36px'))\n",
    "        self.btn_reset = widgets.Button(description='Restaurer', icon='undo', button_style='warning', layout=widgets.Layout(width='auto', padding='0 24px', height='36px'))\n",
    "        \n",
    "        self.btn_preview.on_click(lambda b: self._execute_cleaning(simulate=True))\n",
    "        self.btn_apply.on_click(lambda b: self._execute_cleaning(simulate=False))\n",
    "        self.btn_reset.on_click(self.reset_dataset)\n",
    "        \n",
    "        actions_ui = widgets.HBox([self.btn_preview, self.btn_apply, self.btn_reset], layout=widgets.Layout(margin='0 0 16px 0', gap='12px', flex_wrap='wrap'))\n",
    "        \n",
    "        self.out_logs = widgets.Output()\n",
    "        self.out_status = widgets.Output()\n",
    "        \n",
    "        control_panel = widgets.VBox([cols_ui, missing_ui, outlier_ui, actions_ui], layout=widgets.Layout(width='45%', padding='0 16px 0 0'))\n",
    "        status_panel = widgets.VBox([self.out_logs, self.out_status], layout=widgets.Layout(width='55%', padding='0 0 0 16px', border_left='1px solid #e2e8f0'))\n",
    "        \n",
    "        self.ui = widgets.VBox([\n",
    "            widgets.HTML(\"<div style='border-bottom: 2px solid #e2e8f0; margin-bottom: 20px; padding-bottom: 12px; display:flex; align-items:center;'><svg style='width:24px; height:24px; margin-right:8px; color:#3b82f6;' fill='none' stroke='currentColor' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10'></path></svg><h2 style='font-size:20px; color:#0f172a; margin:0; font-weight:600;'>Nettoyage Expert & Réglages Avancés</h2></div>\"),\n",
    "            self.ds_selector,\n",
    "            widgets.HTML(\"<div style='height:8px;'></div>\"),\n",
    "            widgets.HBox([control_panel, status_panel])\n",
    "        ], layout=widgets.Layout(width='100%', padding='16px', background='white', border_radius='8px'))\n",
    "        \n",
    "        self.on_ds_change(None)\n",
    "\n",
    "    def on_ds_change(self, change):\n",
    "        if change: self.current_ds = change.new\n",
    "        df = self.current_datasets[self.current_ds]\n",
    "        self.cols_checkboxes.children = [widgets.Checkbox(description=c, value=False, indent=False, layout=widgets.Layout(margin='0', width='auto')) for c in df.columns]\n",
    "        self._update_status_table()\n",
    "\n",
    "    def _select_cols(self, mode):\n",
    "        df = self.current_datasets[self.current_ds]\n",
    "        for cb in self.cols_checkboxes.children:\n",
    "            col = cb.description\n",
    "            if col in df.columns:\n",
    "                if mode == 'all': cb.value = True\n",
    "                elif mode == 'none': cb.value = False\n",
    "                elif mode == 'num': cb.value = pd.api.types.is_numeric_dtype(df[col])\n",
    "                elif mode == 'cat': cb.value = not pd.api.types.is_numeric_dtype(df[col])\n",
    "\n",
    "    def _update_missing_desc(self, change):\n",
    "        val = change.new\n",
    "        self.missing_desc.value = f\"<div style='color:#64748b; font-size:12px; margin-top:8px; padding:8px; background:#f1f5f9; border-radius:4px;'><i>{self.missing_descriptions.get(val, '')}</i></div>\"\n",
    "        if val == 'constant_str':\n",
    "            self.missing_param_str.layout.display = 'flex'\n",
    "            self.missing_param_num.layout.display = 'none'\n",
    "        elif val == 'constant_num':\n",
    "            self.missing_param_str.layout.display = 'none'\n",
    "            self.missing_param_num.layout.display = 'flex'\n",
    "        else:\n",
    "            self.missing_param_str.layout.display = 'none'\n",
    "            self.missing_param_num.layout.display = 'none'\n",
    "\n",
    "    def _update_outlier_desc(self, change):\n",
    "        val = change.new\n",
    "        self.outlier_desc.value = f\"<div style='color:#64748b; font-size:12px; margin-top:8px; padding:8px; background:#f1f5f9; border-radius:4px;'><i>{self.outlier_descriptions.get(val, '')}</i></div>\"\n",
    "\n",
    "    def _execute_cleaning(self, simulate=False):\n",
    "        with self.out_logs:\n",
    "            clear_output()\n",
    "            df = self.current_datasets[self.current_ds].copy() if simulate else self.current_datasets[self.current_ds]\n",
    "            \n",
    "            import copy\n",
    "            history_ref = copy.deepcopy(self.history[self.current_ds]) if simulate else self.history[self.current_ds]\n",
    "            \n",
    "            selected_cols = [cb.description for cb in self.cols_checkboxes.children if cb.value]\n",
    "            \n",
    "            if not selected_cols:\n",
    "                display(HTML(\"<div style='padding:12px; background:#fef2f2; border-left:4px solid #ef4444; color:#991b1b;'>Action ignorée : Aucune colonne sélectionnée.</div>\"))\n",
    "                return\n",
    "                \n",
    "            miss_method = self.missing_method.value\n",
    "            outl_method = self.outlier_method.value\n",
    "            \n",
    "            if miss_method == 'none' and outl_method == 'none':\n",
    "                display(HTML(\"<div style='padding:12px; background:#fefce8; border-left:4px solid #eab308; color:#854d0e;'>Action ignorée : Aucun traitement sélectionné.</div>\"))\n",
    "                return\n",
    "                \n",
    "            df_before = df.copy()\n",
    "            rows_before = len(df)\n",
    "            cols_before = len(df.columns)\n",
    "            valid_cols_before = [c for c in selected_cols if c in df.columns]\n",
    "            missing_before = df[valid_cols_before].isna().sum().sum() if valid_cols_before else 0\n",
    "            \n",
    "            messages = []\n",
    "            \n",
    "            # Application Missings\n",
    "            if miss_method != 'none':\n",
    "                if miss_method == 'drop_rows':\n",
    "                    rows_with_na = df_before[valid_cols_before].isna().any(axis=1)\n",
    "                    df.dropna(subset=valid_cols_before, inplace=True)\n",
    "                    messages.append(\"Suppression des lignes comportant des valeurs manquantes dans les colonnes choisies.\")\n",
    "                    for c in valid_cols_before:\n",
    "                        if rows_with_na.any() and df_before.loc[rows_with_na, c].isna().any():\n",
    "                            history_ref[c]['missing'].append(self.missing_short[miss_method])\n",
    "                elif miss_method == 'drop_cols':\n",
    "                    df.drop(columns=valid_cols_before, inplace=True)\n",
    "                    messages.append(\"Suppression totale des colonnes sélectionnées.\")\n",
    "                    for c in valid_cols_before:\n",
    "                        history_ref[c]['missing'].append(self.missing_short[miss_method])\n",
    "                else:\n",
    "                    for col in valid_cols_before:\n",
    "                        if df_before[col].isna().sum() == 0: continue\n",
    "                        changed = False\n",
    "                        if miss_method == 'mean':\n",
    "                            if pd.api.types.is_numeric_dtype(df[col]):\n",
    "                                df[col] = df[col].fillna(df[col].mean())\n",
    "                                changed = True\n",
    "                            else: messages.append(f\"Statut ignoré : {col} n'est pas numérique (Moyenne impossible).\")\n",
    "                        elif miss_method == 'median':\n",
    "                            if pd.api.types.is_numeric_dtype(df[col]):\n",
    "                                df[col] = df[col].fillna(df[col].median())\n",
    "                                changed = True\n",
    "                            else: messages.append(f\"Statut ignoré : {col} n'est pas numérique (Médiane impossible).\")\n",
    "                        elif miss_method == 'mode':\n",
    "                            m = df[col].mode()\n",
    "                            if not m.empty:\n",
    "                                df[col] = df[col].fillna(m.iloc[0])\n",
    "                                changed = True\n",
    "                        elif miss_method == 'constant_str':\n",
    "                            df[col] = df[col].fillna(self.missing_param_str.value)\n",
    "                            changed = True\n",
    "                        elif miss_method == 'constant_num':\n",
    "                            df[col] = df[col].fillna(self.missing_param_num.value)\n",
    "                            changed = True\n",
    "                        elif miss_method == 'ffill':\n",
    "                            df[col] = df[col].ffill()\n",
    "                            changed = True\n",
    "                        elif miss_method == 'bfill':\n",
    "                            df[col] = df[col].bfill()\n",
    "                            changed = True\n",
    "\n",
    "                        if changed and not df_before[col].equals(df[col]):\n",
    "                            history_ref[col]['missing'].append(self.missing_short[miss_method])\n",
    "\n",
    "            # Application Outliers\n",
    "            if outl_method != 'none' and miss_method != 'drop_cols':\n",
    "                numeric_selected = [c for c in selected_cols if c in df.columns and pd.api.types.is_numeric_dtype(df[c])]\n",
    "                if not numeric_selected:\n",
    "                    messages.append(\"Le ciblage des valeurs extrêmes requiert des champs numériques. Annulé.\")\n",
    "                else:\n",
    "                    messages.append(f\"Traitement des valeurs extrêmes appliqué sur {len(numeric_selected)} colonne(s) numérique(s).\")\n",
    "                    for col in numeric_selected:\n",
    "                        df_col_before_outl = df[col].copy()\n",
    "                        if outl_method == 'clip_iqr':\n",
    "                            q1, q3 = df[col].quantile(0.25), df[col].quantile(0.75)\n",
    "                            iqr = q3 - q1\n",
    "                            df[col] = df[col].clip(lower=q1 - 1.5*iqr, upper=q3 + 1.5*iqr)\n",
    "                        elif outl_method == 'clip_percentile':\n",
    "                            df[col] = df[col].clip(lower=df[col].quantile(0.01), upper=df[col].quantile(0.99))\n",
    "                        elif outl_method == 'drop_iqr':\n",
    "                            q1, q3 = df[col].quantile(0.25), df[col].quantile(0.75)\n",
    "                            iqr = q3 - q1\n",
    "                            df = df[(df[col] >= q1 - 1.5*iqr) & (df[col] <= q3 + 1.5*iqr)].copy()\n",
    "                        elif outl_method == 'drop_zscore':\n",
    "                            std = df[col].std()\n",
    "                            if std > 0:\n",
    "                                df = df[((df[col] - df[col].mean()) / std).abs() <= 3].copy()\n",
    "                                \n",
    "                        if len(df) != len(df_col_before_outl):\n",
    "                            history_ref[col]['outlier'].append(self.outlier_short[outl_method])\n",
    "                        else:\n",
    "                            if not df[col].equals(df_col_before_outl):\n",
    "                                history_ref[col]['outlier'].append(self.outlier_short[outl_method])\n",
    "\n",
    "            if not simulate:\n",
    "                self.current_datasets[self.current_ds] = df\n",
    "                self.history[self.current_ds] = history_ref\n",
    "                \n",
    "            valid_cols_after = [c for c in selected_cols if c in df.columns]\n",
    "            missing_after = df[valid_cols_after].isna().sum().sum() if valid_cols_after else 0\n",
    "            rows_after = len(df)\n",
    "            cols_after = len(df.columns)\n",
    "            \n",
    "            msg_bg = '#f0fdf4' if not simulate else '#eff6ff'\n",
    "            msg_border = '#16a34a' if not simulate else '#3b82f6'\n",
    "            msg_color = '#14532d' if not simulate else '#1e3a8a'\n",
    "            msg_icon_bg = '#bbf7d0' if not simulate else '#bfdbfe'\n",
    "            msg_title = \"Succès : Profil de données mis à jour définitivement.\" if not simulate else \"Mode Prévisualisation Actif\"\n",
    "            \n",
    "            msg_html = f\"<div style='padding:12px; background:{msg_bg}; border:1px solid {msg_border}; border-radius:6px; margin-bottom:16px;'>\"\n",
    "            msg_html += f\"<div style='display:flex; align-items:center;'><svg style='width:20px; height:20px; margin-right:8px; color:{msg_border};' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'></path></svg><b style='color:{msg_color}; font-size:15px;'>{msg_title}</b></div>\"\n",
    "            if simulate: msg_html += f\"<div style='color:{msg_color}; margin-top:8px; font-size:13px;'>Le tableau ci-dessous reflète vos changements simulés. Appliquez pour confirmer.</div>\"\n",
    "            \n",
    "            msg_html += f\"<ul style='margin-top:12px; margin-bottom:12px; color:{msg_color}; font-size:13px;'>\"\n",
    "            if rows_before != rows_after: msg_html += f\"<li><b>Volume</b> : {rows_before:,} -> {rows_after:,} lignes <span style='color:#dc2626;'>({rows_after - rows_before:,})</span></li>\"\n",
    "            if cols_before != cols_after: msg_html += f\"<li><b>Structure</b> : {cols_before} -> {cols_after} colonnes <span style='color:#dc2626;'>({cols_after - cols_before})</span></li>\"\n",
    "            if missing_before != missing_after: msg_html += f\"<li><b>Trous réparés</b> : {missing_before:,} manques restants (auparavant {missing_after:,}).</li>\"\n",
    "            msg_html += \"</ul>\"\n",
    "            if messages: msg_html += f\"<ul style='color:{msg_color}; font-size:12.5px; border-top:1px solid {msg_icon_bg}; padding-top:8px; margin:0;'><li>\" + \"</li><li>\".join(messages) + \"</li></ul>\"\n",
    "            msg_html += \"</div>\"\n",
    "            display(HTML(msg_html))\n",
    "            \n",
    "            # Update the status table even in simulation!\n",
    "            self._update_status_table(df=df, history_ref=history_ref, is_simulate=simulate)\n",
    "\n",
    "    def reset_dataset(self, b):\n",
    "        with self.out_logs:\n",
    "            clear_output()\n",
    "            self.current_datasets[self.current_ds] = self.original_datasets[self.current_ds].copy()\n",
    "            import collections\n",
    "            self.history[self.current_ds] = collections.defaultdict(lambda: {'missing': [], 'outlier': []})\n",
    "            display(HTML(\"<div style='padding:16px; background:#fffbeb; border:1px solid #d97706; border-radius:6px; margin-top:8px;'><b style='color:#92400e; font-size:15px;'>Dataset Rechargé :</b> L'historique des modifications de cette architecture a été réinitialisé au fichier de base.</div>\"))\n",
    "            self.on_ds_change(None)\n",
    "\n",
    "    def _update_status_table(self, df=None, history_ref=None, is_simulate=False):\n",
    "        with self.out_status:\n",
    "            clear_output()\n",
    "            if df is None: df = self.current_datasets[self.current_ds]\n",
    "            if history_ref is None: history_ref = self.history[self.current_ds]\n",
    "            \n",
    "            if len(df.columns) == 0:\n",
    "                display(HTML(\"<div style='color:#64748b; font-style:italic;'>Données entièrement nettoyées... ou effacées complétement (0 colonne).</div>\"))\n",
    "                return\n",
    "                \n",
    "            missing_series = df.isna().sum()\n",
    "            missing_pct = (missing_series / len(df)) * 100 if len(df) > 0 else missing_series * 0\n",
    "            \n",
    "            simul_badge = \"<span style='margin-left:8px; background:#3b82f6; color:white; font-size:11px; padding:2px 8px; border-radius:12px; font-weight:bold; vertical-align:middle;'>PRÉVISUALISATION</span>\" if is_simulate else \"\"\n",
    "            html = f\"<div style='display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;'><h4 style='margin:0; color:#1e293b; font-size:16px;'>Résumé d'Intégrité {simul_badge}</h4><div style='color:#64748b; font-weight:500; font-size:13px; background:#f1f5f9; padding:4px 10px; border-radius:20px;'>{len(df):,} Lignes × {len(df.columns)} Colonnes</div></div>\"\n",
    "            \n",
    "            html += \"<div style='max-height:600px; width:100%; border:1px solid #cbd5e1; border-radius:6px; overflow:hidden;'><div style='width:100%; height:100%; overflow:auto;'><table style='width:max-content; min-width:100%; border-collapse: collapse; text-align:left; font-size:12.5px; margin:0;'>\"\n",
    "            html += \"<thead style='position:sticky; top:0; z-index:10; box-shadow:0 1px 2px rgba(0,0,0,0.05);'><tr style='background:#f8fafc; border-bottom:1px solid #cbd5e1;'><th style='padding:10px 12px; color:#334155;'>Colonne</th><th style='padding:10px 12px; color:#334155;'>Vide(s)</th><th style='padding:10px 12px; color:#334155;'>% Manquant</th><th style='padding:10px 12px; color:#334155; width:90px;'>Jauge</th><th style='padding:10px 12px; color:#334155;'>Action NAs</th><th style='padding:10px 12px; color:#334155;'>Action Extrêmes</th></tr></thead><tbody>\"\n",
    "            \n",
    "            cols_to_show = list(df.columns)\n",
    "            # Priority to missing or modified, but show all if possible\n",
    "            if len(cols_to_show) > 100:\n",
    "                show_mask = (missing_series > 0)\n",
    "                modified_cols = [c for c in cols_to_show if self.history[self.current_ds].get(c, {}).get('missing', []) or self.history[self.current_ds].get(c, {}).get('outlier', [])]\n",
    "                priority_cols = list(set(list(df.columns[show_mask]) + modified_cols))\n",
    "                others = [c for c in cols_to_show if c not in priority_cols]\n",
    "                cols_to_show = priority_cols + others[:max(0, 20 - len(priority_cols))]\n",
    "                html += f\"<tr><td colspan='6' style='padding:8px; color:#64748b; background:#f8fafc; text-align:center;'>Affichage circonscrit ({len(cols_to_show)} affichées, focus anomalie & modifications)</td></tr>\"\n",
    "\n",
    "            for i, c in enumerate(cols_to_show):\n",
    "                m = missing_series[c]\n",
    "                p = missing_pct[c]\n",
    "                \n",
    "                # Bar computation\n",
    "                bar_w = min(100, max(1, int(p))) if p > 0 else 0\n",
    "                bar_color = '#ef4444' if p > 20 else ('#eab308' if p > 0 else '#22c55e')\n",
    "                bar_html = f\"<div style='width:100%; max-width:80px; background:#e2e8f0; height:6px; border-radius:3px; overflow:hidden;'><div style='width:{bar_w}%; background:{bar_color}; height:100%;'></div></div>\"\n",
    "                \n",
    "                hist = history_ref.get(c, {'missing': [], 'outlier': []})\n",
    "                hist_missing = hist.get('missing', [])\n",
    "                hist_outlier = hist.get('outlier', [])\n",
    "                \n",
    "                if hist_missing:\n",
    "                    badges_missing = \"\".join([f\"<span style='display:inline-block; font-size:10.5px; padding:2px 8px; margin:2px; background:#eff6ff; color:#1e40af; border:1px solid #bfdbfe; border-radius:12px; font-weight:500;'>{lbl}</span>\" for lbl in hist_missing])\n",
    "                else:\n",
    "                    badges_missing = \"<span style='color:#94a3b8; font-style:italic; font-size:12px;'>-</span>\"\n",
    "                    \n",
    "                if hist_outlier:\n",
    "                    badges_outlier = \"\".join([f\"<span style='display:inline-block; font-size:10.5px; padding:2px 8px; margin:2px; background:#fdf2f8; color:#9d174d; border:1px solid #fbcfe8; border-radius:12px; font-weight:500;'>{lbl}</span>\" for lbl in hist_outlier])\n",
    "                else:\n",
    "                    badges_outlier = \"<span style='color:#94a3b8; font-style:italic; font-size:12px;'>-</span>\"\n",
    "                \n",
    "                bg_tr = '#ffffff' if i % 2 == 0 else '#f8fafc'\n",
    "                if is_simulate and (hist_missing or hist_outlier): bg_tr = '#f0fdf4'\n",
    "                \n",
    "                html += f\"<tr style='border-bottom:1px solid #f1f5f9; background:{bg_tr}; transition: background 0.2s;'>\"\n",
    "                val_color = '#b91c1c' if m > 0 else '#475569'\n",
    "                html += f\"<td style='padding:10px 12px; font-weight:600; color:{val_color}; max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;' title='{c}'>{c}</td>\"\n",
    "                html += f\"<td style='padding:10px 12px; color:{val_color};'>{m:,}</td>\"\n",
    "                html += f\"<td style='padding:10px 12px; color:{val_color};'>{p:.1f}%</td>\"\n",
    "                html += f\"<td style='padding:10px 12px;'>{bar_html}</td>\"\n",
    "                html += f\"<td style='padding:10px 12px;'>{badges_missing}</td>\"\n",
    "                html += f\"<td style='padding:10px 12px;'>{badges_outlier}</td>\"\n",
    "                html += \"</tr>\"\n",
    "                \n",
    "            deleted_cols = [c for c in self.original_datasets[self.current_ds].columns if c not in df.columns]\n",
