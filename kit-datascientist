    "\n",
    "    # -------------------------------------------------------\n",
    "    # HELPERS — read option widget values\n",
    "    # -------------------------------------------------------\n",
    "\n",
    "    def _get_tabular_kwargs(self):\n",
    "        kwargs = {}\n",
    "        if self._sep is not None:\n",
    "            kwargs[\"sep\"] = self._sep.value or \",\"\n",
    "        if self._dec is not None:\n",
    "            kwargs[\"decimal\"] = self._dec.value or \".\"\n",
    "        if self._thou is not None and self._thou.value:\n",
    "            kwargs[\"thousands\"] = self._thou.value\n",
    "        if self._enc is not None:\n",
    "            kwargs[\"encoding\"] = self._enc.value\n",
    "        if self._header is not None:\n",
    "            kwargs[\"header\"] = 0 if self._header.value else None\n",
    "        if self._na is not None and self._na.value:\n",
    "            kwargs[\"na_values\"] = [v.strip() for v in self._na.value.split(\",\")]\n",
    "        if self._sheet is not None:\n",
    "            try:\n",
    "                kwargs[\"sheet_name\"] = int(self._sheet.value)\n",
    "            except ValueError:\n",
    "                kwargs[\"sheet_name\"] = self._sheet.value\n",
    "        if self._img_mode is not None:\n",
    "            kwargs[\"image_mode\"] = self._img_mode.value\n",
    "        if self._img_resize is not None and self._img_resize.value:\n",
    "            kwargs[\"image_target_size\"] = (self._img_w.value, self._img_h.value)\n",
    "        if self._graph_fmt is not None:\n",
    "            kwargs[\"graph_format\"] = self._graph_fmt.value\n",
    "        if self._text_enc is not None:\n",
    "            kwargs[\"text_encoding\"] = self._text_enc.value\n",
    "        return kwargs\n",
    "\n",
    "    def _prefix(self, slot_name, idx=None):\n",
    "        base = (self._label_prefix.value.strip() + \"_\" if self._label_prefix.value.strip() else \"\")\n",
    "        sfx = \"\" if idx is None else f\"_{idx}\"\n",
    "        return base + slot_name + sfx\n",
    "\n",
    "    def _postprocess_timeseries(self, df):\n",
    "        \"\"\"Apply time-series specific transformations.\"\"\"\n",
    "        if self._ts_col is None:\n",
    "            return df\n",
    "        col = self._ts_col.value.strip()\n",
    "        if col and col in df.columns:\n",
    "            df[col] = pd.to_datetime(df[col], errors=\"coerce\")\n",
    "            freq = self._ts_freq.value if self._ts_freq else \"(auto)\"\n",
    "            if freq not in (\"\", \"(auto)\") and self._ts_index and self._ts_index.value:\n",
    "                df = df.set_index(col)\n",
    "                df = df.resample(freq).mean()\n",
    "            elif self._ts_index and self._ts_index.value:\n",
    "                df = df.set_index(col)\n",
    "            if self._ts_sort and self._ts_sort.value:\n",
    "                df = df.sort_index()\n",
    "        return df\n",
    "\n",
    "    # -------------------------------------------------------\n",
    "    # LOAD HANDLER\n",
    "    # -------------------------------------------------------\n",
    "\n",
    "    def _on_load(self, _):\n",
