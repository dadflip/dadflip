    "                         ha=\"center\", va=\"center\", transform=axes[1].transAxes,\n",
    "                         fontsize=11, color=PALETTE[\"muted\"])\n",
    "            axes[1].axis(\"off\")\n",
    "\n",
    "        fig.text(0.5, -0.04,\n",
    "                 \"💡 L'importance native peut être biaisée vers les features à haute cardinalité. \"\n",
    "                 \"L'importance par permutation est plus fiable et model-agnostic.\",\n",
    "                 ha=\"center\", fontsize=9, color=PALETTE[\"muted\"], style=\"italic\")\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    @staticmethod\n",
    "    def plot_learning_curves(model, X, y, problem_type, model_name, cv=5):\n",
    "        \"\"\"Courbes d'apprentissage : biais vs variance.\"\"\"\n",
    "        scoring = \"accuracy\" if problem_type == \"classification\" else \"r2\"\n",
    "        train_sizes, train_scores, val_scores = learning_curve(\n",
    "            model, X, y, cv=cv, scoring=scoring,\n",
    "            train_sizes=np.linspace(0.1, 1.0, 10), n_jobs=-1\n",
    "        )\n",
    "        train_mean = train_scores.mean(axis=1)\n",
    "        train_std  = train_scores.std(axis=1)\n",
    "        val_mean   = val_scores.mean(axis=1)\n",
    "        val_std    = val_scores.std(axis=1)\n",
    "\n",
    "        fig, ax = plt.subplots(figsize=(8, 5))\n",
    "        ax.plot(train_sizes, train_mean, \"o-\", color=PALETTE[\"primary\"], linewidth=2, label=\"Train\")\n",
    "        ax.fill_between(train_sizes, train_mean - train_std, train_mean + train_std,\n",
    "                        alpha=0.15, color=PALETTE[\"primary\"])\n",
    "        ax.plot(train_sizes, val_mean, \"s-\", color=PALETTE[\"success\"], linewidth=2, label=\"Validation\")\n",
    "        ax.fill_between(train_sizes, val_mean - val_std, val_mean + val_std,\n",
    "                        alpha=0.15, color=PALETTE[\"success\"])\n",
    "\n",
    "        ax.set_title(f\"Courbes d'apprentissage — {model_name}\", fontsize=12, fontweight=\"bold\")\n",
    "        ax.set_xlabel(\"Taille du jeu d'entraînement\")\n",
    "        ax.set_ylabel(scoring.upper())\n",
    "        ax.legend()\n",
    "\n",
    "        # Diagnostic biais/variance\n",
    "        gap = train_mean[-1] - val_mean[-1]\n",
    "        if gap > 0.1:\n",
    "            diag = \"⚠ Surapprentissage (overfitting) détecté : écart train/val élevé. Régularisez ou augmentez les données.\"\n",
    "            color = PALETTE[\"danger\"]\n",
    "        elif val_mean[-1] < 0.65:\n",
    "            diag = \"⚠ Sous-apprentissage (underfitting) : score validation faible. Modèle trop simple ou données insuffisantes.\"\n",
    "            color = PALETTE[\"warning\"]\n",
    "        else:\n",
    "            diag = \"✔ Bon ajustement : faible écart entre train et validation.\"\n",
    "            color = PALETTE[\"success\"]\n",
    "\n",
    "        ax.text(0.5, -0.18, diag, ha=\"center\", transform=ax.transAxes,\n",
    "                fontsize=9, color=color, style=\"italic\")\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    @staticmethod\n",
    "    def plot_residuals(metrics, model_name):\n",
    "        \"\"\"Analyse complète des résidus pour la régression.\"\"\"\n",
    "        y_true = np.array(metrics[\"y_true\"])\n",
    "        y_pred = np.array(metrics[\"y_pred\"])\n",
    "        residuals = np.array(metrics[\"residuals\"])\n",
    "\n",
    "        fig = plt.figure(figsize=(14, 5))\n",
    "        gs = gridspec.GridSpec(1, 3, figure=fig, wspace=0.35)\n",
    "        fig.suptitle(f\"Analyse des Résidus — {model_name}\", fontsize=12,\n",
    "                     fontweight=\"bold\", color=PALETTE[\"text\"])\n",
    "\n",
    "        # 1. Résidus vs prédictions\n",
    "        ax1 = fig.add_subplot(gs[0])\n",
    "        ax1.scatter(y_pred, residuals, alpha=0.5, color=PALETTE[\"primary\"], s=20)\n",
    "        ax1.axhline(0, color=PALETTE[\"danger\"], linewidth=1.5, linestyle=\"--\")\n",
    "        ax1.set_xlabel(\"Valeurs Prédites\"); ax1.set_ylabel(\"Résidus\")\n",
    "        ax1.set_title(\"Résidus vs Prédictions\")\n",
    "\n",
    "        # 2. Histogram des résidus\n",
    "        ax2 = fig.add_subplot(gs[1])\n",
    "        ax2.hist(residuals, bins=30, color=PALETTE[\"primary\"], alpha=0.8, edgecolor=\"white\")\n",
    "        ax2.axvline(0, color=PALETTE[\"danger\"], linewidth=1.5, linestyle=\"--\")\n",
    "        ax2.set_xlabel(\"Résidu\"); ax2.set_ylabel(\"Fréquence\")\n",
    "        ax2.set_title(\"Distribution des Résidus\")\n",
    "        # Normalité (skewness)\n",
    "        from scipy import stats as sp_stats\n",
    "        sk = sp_stats.skew(residuals)\n",
    "        ax2.text(0.97, 0.95, f\"Skewness = {sk:.2f}\", transform=ax2.transAxes,\n",
    "                 ha=\"right\", va=\"top\", fontsize=9, color=PALETTE[\"muted\"])\n",
    "\n",
    "        # 3. Q-Q plot\n",
    "        ax3 = fig.add_subplot(gs[2])\n",
    "        sp_stats.probplot(residuals, dist=\"norm\", plot=ax3)\n",
    "        ax3.set_title(\"Q-Q Plot (Normalité des Résidus)\")\n",
    "        ax3.get_lines()[0].set(color=PALETTE[\"primary\"], alpha=0.6, markersize=4)\n",
    "        ax3.get_lines()[1].set(color=PALETTE[\"danger\"], linewidth=1.5)\n",
    "\n",
    "        insight = (\n",
    "            \"💡 Résidus centrés en 0 et distribution symétrique = hypothèses satisfaites. \"\n",
    "            \"Un pattern dans le plot résidus/prédictions révèle une non-linéarité résiduelle.\"\n",
    "        )\n",
    "        fig.text(0.5, -0.06, insight, ha=\"center\", fontsize=9,\n",
    "                 color=PALETTE[\"muted\"], style=\"italic\")\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    @staticmethod\n",
    "    def plot_comparative_bar(results_dict, problem_type):\n",
    "        \"\"\"Graphique comparatif multi-modèles en barres groupées.\"\"\"\n",
    "        if problem_type == \"classification\":\n",
    "            metrics_keys = [\"accuracy\", \"precision\", \"recall\", \"f1\"]\n",
    "            labels = [\"Accuracy\", \"Précision\", \"Rappel\", \"F1-Score\"]\n",
    "        else:\n",
    "            metrics_keys = [\"r2\", \"mae\", \"rmse\"]\n",
    "            labels = [\"R²\", \"MAE\", \"RMSE\"]\n",
    "\n",
    "        model_names = list(results_dict.keys())\n",
    "        n_models = len(model_names)\n",
    "        n_metrics = len(metrics_keys)\n",
    "\n",
    "        data = np.array([\n",
    "            [results_dict[m][\"metrics\"].get(k, 0) for k in metrics_keys]\n",
    "            for m in model_names\n",
    "        ])\n",
    "\n",
    "        x = np.arange(n_metrics)\n",
    "        width = 0.8 / n_models\n",
    "\n",
    "        fig, ax = plt.subplots(figsize=(max(10, n_models * 1.5), 5))\n",
    "        fig.suptitle(\"Comparaison des Modèles — Toutes Métriques\",\n",
    "                     fontsize=12, fontweight=\"bold\", color=PALETTE[\"text\"])\n",
    "\n",
    "        for i, (name, row) in enumerate(zip(model_names, data)):\n",
    "            offset = (i - n_models / 2 + 0.5) * width\n",
    "            bars = ax.bar(x + offset, row, width * 0.9,\n",
    "                          label=name, color=MODEL_COLORS[i % len(MODEL_COLORS)],\n",
    "                          edgecolor=\"white\", linewidth=0.8)\n",
    "            for bar, val in zip(bars, row):\n",
    "                ax.text(bar.get_x() + bar.get_width() / 2,\n",
    "                        bar.get_height() + 0.005, f\"{val:.3f}\",\n",
    "                        ha=\"center\", va=\"bottom\", fontsize=7, rotation=90 if n_models > 4 else 0)\n",
    "\n",
    "        ax.set_xticks(x); ax.set_xticklabels(labels, fontsize=10)\n",
    "        ax.set_ylabel(\"Score\"); ax.set_ylim(0, 1.12 if problem_type == \"classification\" else None)\n",
    "        ax.legend(loc=\"upper right\", fontsize=8, framealpha=0.9,\n",
    "                  ncol=max(1, n_models // 4))\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    @staticmethod\n",
    "    def plot_radar(results_dict, problem_type):\n",
    "        \"\"\"Graphique radar pour comparer les modèles sur plusieurs métriques.\"\"\"\n",
    "        if problem_type != \"classification\":\n",
    "            return\n",
    "        metrics_keys = [\"accuracy\", \"precision\", \"recall\", \"f1\"]\n",
    "        labels_r     = [\"Accuracy\", \"Précision\", \"Rappel\", \"F1-Score\"]\n",
    "        N = len(metrics_keys)\n",
    "        angles = np.linspace(0, 2 * np.pi, N, endpoint=False).tolist()\n",
    "        angles += angles[:1]\n",
    "\n",
    "        fig, ax = plt.subplots(figsize=(6, 6), subplot_kw={\"polar\": True})\n",
    "        ax.set_title(\"Radar — Comparaison Multi-Métriques\",\n",
    "                     fontsize=12, fontweight=\"bold\", y=1.08)\n",
    "\n",
    "        for i, (name, result) in enumerate(results_dict.items()):\n",
    "            vals = [result[\"metrics\"].get(k, 0) for k in metrics_keys]\n",
    "            vals += vals[:1]\n",
    "            ax.plot(angles, vals, \"o-\", linewidth=2,\n",
    "                    color=MODEL_COLORS[i % len(MODEL_COLORS)], label=name)\n",
    "            ax.fill(angles, vals, alpha=0.08, color=MODEL_COLORS[i % len(MODEL_COLORS)])\n",
    "\n",
    "        ax.set_xticks(angles[:-1])\n",
    "        ax.set_xticklabels(labels_r, fontsize=10)\n",
    "        ax.set_ylim(0, 1)\n",
    "        ax.yaxis.set_major_formatter(mticker.FormatStrFormatter(\"%.1f\"))\n",
    "        ax.legend(loc=\"upper right\", bbox_to_anchor=(1.35, 1.1), fontsize=9)\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    @staticmethod\n",
    "    def plot_prediction_vs_actual(results_dict):\n",
    "        \"\"\"Prédictions vs réelles pour tous les modèles de régression.\"\"\"\n",
    "        n = len(results_dict)\n",
    "        ncols = min(3, n)\n",
    "        nrows = (n + ncols - 1) // ncols\n",
    "        fig, axes = plt.subplots(nrows, ncols, figsize=(6 * ncols, 5 * nrows))\n",
    "        if n == 1:\n",
    "            axes = [axes]\n",
    "        else:\n",
    "            axes = axes.flatten() if nrows > 1 else axes\n",
    "\n",
    "        for i, (name, result) in enumerate(results_dict.items()):\n",
    "            ax = axes[i]\n",
    "            m = result[\"metrics\"]\n",
    "            y_true = np.array(m[\"y_true\"])\n",
    "            y_pred = np.array(m[\"y_pred\"])\n",
    "            lo, hi = min(y_true.min(), y_pred.min()), max(y_true.max(), y_pred.max())\n",
    "\n",
    "            ax.scatter(y_true, y_pred, alpha=0.4, color=MODEL_COLORS[i % len(MODEL_COLORS)], s=20)\n",
    "            ax.plot([lo, hi], [lo, hi], \"r--\", linewidth=1.5, label=\"Parfait\")\n",
    "            ax.set_xlabel(\"Valeurs Réelles\"); ax.set_ylabel(\"Prédictions\")\n",
    "            ax.set_title(name, fontsize=10, fontweight=\"bold\")\n",
    "            r2 = m.get(\"r2\", 0); rmse = m.get(\"rmse\", 0)\n",
    "            ax.text(0.05, 0.93, f\"R²={r2:.3f}  RMSE={rmse:.3f}\",\n",
    "                    transform=ax.transAxes, fontsize=8.5, color=PALETTE[\"text\"])\n",
    "            ax.legend(fontsize=8)\n",
    "\n",
    "        for j in range(i + 1, len(axes)):\n",
    "            axes[j].axis(\"off\")\n",
    "\n",
    "        fig.suptitle(\"Prédictions vs Valeurs Réelles\", fontsize=12, fontweight=\"bold\")\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# 5. INTERFACE DE SÉLECTION DES MODÈLES\n",
    "# ================================================================\n",
    "class ModelSelectionUI:\n",
    "    def __init__(self, df, target_col, problem_info, feature_names,\n",
    "                 non_tabular_data=None, test_size=0.2,\n",
    "                 cell6_state=None):\n",
    "        \"\"\"\n",
    "        Paramètres\n",
    "        ----------\n",
    "        df              : DataFrame complet (déjà rééquilibré si cell6 a agi)\n",
    "        target_col      : colonne cible\n",
    "        problem_info    : dict issu de detect_problem_type()\n",
    "        feature_names   : liste des colonnes features\n",
    "        non_tabular_data: dict données non tabulaires\n",
    "        test_size       : ratio test (utilisé seulement si cell6_state est None)\n",
    "        cell6_state     : dict transmis par la cellule 6, peut contenir :\n",
    "                            - \"X_train\", \"X_test\", \"y_train\", \"y_test\" (arrays scalés)\n",
    "                            - \"scaler\"                                  (StandardScaler fitté)\n",
    "                            - \"label_encoder\"                           (LabelEncoder fitté ou None)\n",
    "                            - \"rebalancing_method\"                      (str)\n",
    "                            - \"rebalanced_cols\"                         (liste de colonnes)\n",
    "                            - \"test_size\"                               (float)\n",
    "        \"\"\"\n",
    "        self.df = df\n",
    "        self.target_col = target_col\n",
    "        self.problem_info = problem_info\n",
    "        self.feature_names = feature_names\n",
    "        self.non_tabular_data = non_tabular_data or {}\n",
    "        self.test_size = test_size\n",
    "        self.cell6_state = cell6_state or {}\n",
    "        self.results = {}\n",
    "        self.label_encoder = None\n",
    "        self._prepare_data()\n",
    "        self._build_ui()\n",
    "\n",
    "    def _prepare_data(self):\n",
    "        \"\"\"\n",
    "        Prépare X, y, train/test split.\n",
    "\n",
    "        Priorité :\n",
    "          1. Si cell6_state contient un split déjà effectué → on le réutilise\n",
    "             directement (pas de re-split, on honore le travail de la cellule 6).\n",
    "          2. Sinon on effectue le split ici avec le test_size fourni.\n",
    "\n",
    "        Dans les deux cas on encode la cible si besoin et on conserve\n",
    "        X_all / y_all pour les courbes d'apprentissage.\n",
    "        \"\"\"\n",
    "        s = self.cell6_state\n",
    "\n",
    "        # ── Récupération du label_encoder de cell6 ────────────────\n",
    "        if s.get(\"label_encoder\") is not None:\n",
    "            self.label_encoder = s[\"label_encoder\"]\n",
    "\n",
    "        # ── CAS 1 : split déjà disponible depuis cell6 ────────────\n",
    "        if all(k in s for k in (\"X_train\", \"X_test\", \"y_train\", \"y_test\")):\n",
    "            self.X_train = s[\"X_train\"]\n",
    "            self.X_test  = s[\"X_test\"]\n",
    "            self.y_train = s[\"y_train\"]\n",
    "            self.y_test  = s[\"y_test\"]\n",
    "\n",
    "            # Reconstituer X_all / y_all (concaténation train + test)\n",
    "            self.X_all = np.vstack([self.X_train, self.X_test])\n",
    "            self.y_all = pd.concat(\n",
    "                [pd.Series(self.y_train), pd.Series(self.y_test)]\n",
    "            ).reset_index(drop=True)\n",
    "\n",
    "            # Encoder la cible si pas déjà fait\n",
    "            if self.problem_info[\"problem_type\"] == \"classification\":\n",
    "                if self.label_encoder is None and not pd.api.types.is_numeric_dtype(self.y_all):\n",
    "                    self.label_encoder = LabelEncoder()\n",
    "                    self.y_all   = pd.Series(self.label_encoder.fit_transform(self.y_all))\n",
    "                    n_train      = len(self.y_train)\n",
    "                    self.y_train = self.y_all.iloc[:n_train].values\n",
    "                    self.y_test  = self.y_all.iloc[n_train:].values\n",
    "                self.classes_ = np.unique(self.y_all)\n",
    "            else:\n",
    "                self.classes_ = None\n",
    "\n",
    "            self._data_origin = \"cell6\"  # flag pour l'UI\n",
    "            return\n",
    "\n",
    "        # ── CAS 2 : pas de split disponible → on le fait ──────────\n",
    "        X_raw = self.df.drop(columns=[self.target_col])\n",
    "        y_raw = self.df[self.target_col]\n",
    "\n",
    "        if self.problem_info[\"problem_type\"] == \"classification\":\n",
    "            if not pd.api.types.is_numeric_dtype(y_raw):\n",
    "                if self.label_encoder is None:\n",
    "                    self.label_encoder = LabelEncoder()\n",
    "                y_raw = pd.Series(self.label_encoder.fit_transform(y_raw))\n",
    "            self.classes_ = np.unique(y_raw)\n",
    "        else:\n",
    "            self.classes_ = None\n",
    "\n",
    "        scaler = s.get(\"scaler\") or StandardScaler()\n",
    "        X_scaled = scaler.fit_transform(X_raw) if \"scaler\" not in s else scaler.transform(X_raw)\n",
    "\n",
    "        ts = s.get(\"test_size\", self.test_size)\n",
    "        self.X_train, self.X_test, self.y_train, self.y_test = train_test_split(\n",
    "            X_scaled, y_raw, test_size=ts, random_state=42,\n",
    "            stratify=y_raw if self.problem_info[\"problem_type\"] == \"classification\" else None\n",
    "        )\n",
    "        self.X_all = X_scaled\n",
    "        self.y_all = y_raw\n",
    "        self._data_origin = \"cell7\"\n",
    "\n",
    "    def _build_ui(self):\n",
    "        prob  = self.problem_info[\"problem_type\"]\n",
    "        ttype = self.problem_info[\"target_type\"]\n",
    "        s     = self.cell6_state\n",
    "\n",
    "        # ── Bandeau provenance des données ────────────────────────\n",
    "        if self._data_origin == \"cell6\":\n",
    "            reb_method = s.get(\"rebalancing_method\", \"none\")\n",
    "            reb_cols   = s.get(\"rebalanced_cols\", [])\n",
    "            reb_label  = (\n",
    "                f\"Rééquilibrage : <b>{reb_method}</b> sur {reb_cols}\"\n",
    "                if reb_method and reb_method != \"none\"\n",
    "                else \"Aucun rééquilibrage appliqué\"\n",
    "            )\n",
    "            origin_badge = f\"\"\"\n",
    "            <div style='background:#f0fdf4; border:1px solid #bbf7d0; border-radius:6px;\n",
    "                        padding:8px 14px; margin-bottom:10px; font-size:12px; color:#166534;'>\n",
    "              ✅ <b>Données héritées de la Cellule 6</b> — split train/test réutilisé sans re-découpage.<br>\n",
    "              {reb_label} ·\n",
    "              Train : <b>{len(self.X_train):,}</b> · Test : <b>{len(self.X_test):,}</b> ·\n",
    "              Features : <b>{len(self.feature_names)}</b>\n",
    "            </div>\"\"\"\n",
    "        else:\n",
    "            origin_badge = f\"\"\"\n",
    "            <div style='background:#eff6ff; border:1px solid #bfdbfe; border-radius:6px;\n",
    "                        padding:8px 14px; margin-bottom:10px; font-size:12px; color:#1e40af;'>\n",
    "              ℹ <b>Split effectué dans cette cellule</b> (Cellule 6 non détectée ou sans split).<br>\n",
    "              Train : <b>{len(self.X_train):,}</b> · Test : <b>{len(self.X_test):,}</b> ·\n",
    "              Features : <b>{len(self.feature_names)}</b>\n",
    "            </div>\"\"\"\n",
    "\n",
    "        # En-tête\n",
    "        header = widgets.HTML(f\"\"\"\n",
    "        <div style='border-left:4px solid {PALETTE[\"primary\"]}; padding:10px 16px;\n",
    "                    background:{PALETTE[\"light\"]}; border-radius:4px; margin-bottom:8px;'>\n",
    "          <h3 style='margin:0; color:{PALETTE[\"text\"]}; font-size:17px;'>\n",
    "            🤖 Sélection & Entraînement des Modèles\n",
    "          </h3>\n",
    "          <p style='margin:4px 0 0 0; color:{PALETTE[\"muted\"]}; font-size:13px;'>\n",
    "            Tâche détectée : <b>{prob.capitalize()}</b> ({ttype}) — Cible : <code>{self.target_col}</code>\n",
    "          </p>\n",
    "        </div>\n",
    "        {origin_badge}\n",
    "        \"\"\")\n",
    "\n",
    "        # Catalogue de modèles avec checkboxes\n",
    "        catalog = MODELS_CATALOG[prob][ttype]\n",
    "        self._model_checkboxes = {}\n",
    "\n",
    "        rows = []\n",
    "        for name, cls, mod, params in catalog:\n",
    "            cb = widgets.Checkbox(value=False, description=name, indent=False,\n",
    "                                  layout=widgets.Layout(width=\"260px\", margin=\"2px 0\"))\n",
    "            self._model_checkboxes[name] = {\"checkbox\": cb, \"class_name\": cls,\n",
    "                                             \"module\": mod, \"params\": params}\n",
    "            rows.append(cb)\n",
    "\n",
    "        # Grille 3 colonnes\n",
    "        cols = [widgets.VBox(rows[i::3]) for i in range(3)]\n",
    "        model_grid = widgets.HBox(cols, layout=widgets.Layout(flex_wrap=\"wrap\"))\n",
    "        model_box = widgets.VBox([\n",
    "            widgets.HTML(f\"<b style='color:{PALETTE['text']}'>Modèles disponibles :</b>\"),\n",
    "            model_grid,\n",
    "        ])\n",
    "\n",
    "        # Options avancées\n",
    "        self._test_size_slider = widgets.FloatSlider(\n",
    "            value=self.test_size, min=0.1, max=0.5, step=0.05,\n",
    "            description=\"Test size:\", style={\"description_width\": \"initial\"},\n",
    "            layout=widgets.Layout(width=\"350px\")\n",
    "        )\n",
    "        self._cv_slider = widgets.IntSlider(\n",
    "            value=5, min=3, max=10, step=1, description=\"CV folds:\",\n",
    "            style={\"description_width\": \"initial\"},\n",
    "            layout=widgets.Layout(width=\"300px\")\n",
    "        )\n",
    "        self._show_lc = widgets.Checkbox(value=True, description=\"Courbes d'apprentissage\",\n",
    "                                          indent=False)\n",
    "        self._show_fi = widgets.Checkbox(value=True, description=\"Importance des features\",\n",
    "                                          indent=False)\n",
    "        self._show_roc = widgets.Checkbox(value=True, description=\"Courbes ROC / PR\",\n",
    "                                           indent=False)\n",
    "\n",
    "        adv_box = widgets.Accordion([\n",
    "            widgets.VBox([\n",
    "                self._test_size_slider,\n",
    "                self._cv_slider,\n",
    "                widgets.HTML(\"<b>Graphiques à tracer :</b>\"),\n",
    "                self._show_lc, self._show_fi, self._show_roc,\n",
    "            ])\n",
    "        ])\n",
    "        adv_box.set_title(0, \"⚙ Options avancées\")\n",
    "\n",
    "        # Bouton entraîner\n",
    "        self._select_all_btn = widgets.Button(description=\"Tout sélectionner\",\n",
    "                                               button_style=\"\", layout=widgets.Layout(width=\"160px\"))\n",
    "        self._clear_btn = widgets.Button(description=\"Tout désélectionner\",\n",
    "                                          button_style=\"\", layout=widgets.Layout(width=\"160px\"))\n",
    "        self._train_btn = widgets.Button(\n",
    "            description=\"▶ Entraîner les modèles sélectionnés\",\n",
    "            button_style=\"primary\", layout=widgets.Layout(width=\"320px\", height=\"38px\")\n",
    "        )\n",
    "        self._select_all_btn.on_click(lambda b: [cb[\"checkbox\"].__setattr__(\"value\", True)\n",
    "                                                  for cb in self._model_checkboxes.values()])\n",
    "        self._clear_btn.on_click(lambda b: [cb[\"checkbox\"].__setattr__(\"value\", False)\n",
    "                                             for cb in self._model_checkboxes.values()])\n",
    "        self._train_btn.on_click(self._run_training)\n",
    "        btn_row = widgets.HBox([self._select_all_btn, self._clear_btn, self._train_btn],\n",
    "                                layout=widgets.Layout(gap=\"10px\", margin=\"12px 0\"))\n",
    "\n",
    "        self.output = widgets.Output()\n",
    "        self.ui = widgets.VBox([header, model_box, adv_box, btn_row, self.output],\n",
    "                                layout=widgets.Layout(padding=\"16px\"))\n",
    "\n",
    "        # Données non tabulaires\n",
    "        if self.non_tabular_data:\n",
    "            self._add_non_tabular_section()\n",
    "\n",
    "    def _add_non_tabular_section(self):\n",
    "        nt_html = widgets.HTML(f\"\"\"\n",
    "        <div style='margin-top:20px; border-top:1px dashed {PALETTE[\"border\"]}; padding-top:14px;'>\n",
    "          <h4 style='color:{PALETTE[\"text\"]}'>Données Non-Tabulaires Détectées</h4>\n",
    "        </div>\n",
    "        \"\"\")\n",
    "        self.ui.children += (nt_html,)\n",
    "        for key, val in self.non_tabular_data.items():\n",
    "            dtype = \"image\" if \"image\" in key.lower() else (\n",
    "                    \"audio\" if \"audio\" in key.lower() else (\n",
    "                    \"graph\" if \"graph\" in key.lower() else \"text\"))\n",
    "            if dtype in NON_TABULAR_MODELS:\n",
    "                box = widgets.VBox([\n",
    "                    widgets.HTML(f\"<b>{key}</b> (type inféré : {dtype})\"),\n",
    "                    *[widgets.Checkbox(description=m, value=False, indent=False)\n",
    "                      for m in NON_TABULAR_MODELS[dtype]],\n",
    "                    widgets.HTML(\n",
    "                        f\"<i style='color:{PALETTE['warning']}; font-size:11px;'>\"\n",
    "                        \"⚠ Modèles non tabulaires non entraînable ici — \"\n",
    "                        \"consultez la section dédiée ci-dessous.</i>\"\n",
    "                    )\n",
    "                ])\n",
    "                self.ui.children += (box,)\n",
    "\n",
    "    def _run_training(self, b):\n",
    "        self._train_btn.disabled = True\n",
    "        self._train_btn.description = \"⏳ Entraînement en cours...\"\n",
    "\n",
    "        with self.output:\n",
    "            clear_output(wait=True)\n",
    "            selected = {n: info for n, info in self._model_checkboxes.items()\n",
    "                        if info[\"checkbox\"].value}\n",
    "\n",
    "            if not selected:\n",
    "                display(HTML(f\"<div style='color:{PALETTE['danger']};'>Aucun modèle sélectionné.</div>\"))\n",
    "                self._train_btn.disabled = False\n",
    "                self._train_btn.description = \"▶ Entraîner les modèles sélectionnés\"\n",
    "                return\n",
    "\n",
    "            prob  = self.problem_info[\"problem_type\"]\n",
    "            ttype = self.problem_info[\"target_type\"]\n",
    "\n",
    "            # Affichage distribution cible\n",
    "            display(HTML(\"<h4 style='color:#1e293b; margin-bottom:4px;'>📊 Distribution de la cible</h4>\"))\n",
    "            ModelVisualizer.plot_target_distribution(self.df, self.target_col, self.problem_info)\n",
    "\n",
    "            self.results = {}\n",
    "            progress = widgets.IntProgress(value=0, min=0, max=len(selected),\n",
    "                                           description=\"Progression :\",\n",
    "                                           style={\"bar_color\": PALETTE[\"primary\"]},\n",
    "                                           layout=widgets.Layout(width=\"80%\"))\n",
    "            display(progress)\n",
    "\n",
    "            for idx, (name, info) in enumerate(selected.items()):\n",
    "                t0 = time.time()\n",
    "                display(HTML(\n",
    "                    f\"<div style='padding:8px; background:{PALETTE['light']}; \"\n",
    "                    f\"border-left:3px solid {PALETTE['primary']}; border-radius:3px; margin:6px 0;'>\"\n",
    "                    f\"🔄 Entraînement de <b>{name}</b>...</div>\"\n",
    "                ))\n",
    "                try:\n",
    "                    model = _instantiate_model(info[\"module\"], info[\"class_name\"], info[\"params\"])\n",
    "                    model.fit(self.X_train, self.y_train)\n",
    "                    elapsed = time.time() - t0\n",
    "\n",
    "                    metrics = evaluate_model(\n",
    "                        model, self.X_test, self.y_test, prob, ttype, self.label_encoder\n",
    "                    )\n",
    "                    self.results[name] = {\n",
    "                        \"model\": model, \"metrics\": metrics,\n",
    "                        \"X_test\": self.X_test, \"y_test\": self.y_test,\n",
    "                        \"train_time\": elapsed,\n",
    "                    }\n",
    "\n",
    "                    # ── Affichage résultats modèle ──────────────────────\n",
    "                    self._display_single_result(name, metrics, elapsed, prob, ttype)\n",
    "\n",
    "                    # Courbes d'apprentissage\n",
    "                    if self._show_lc.value:\n",
    "                        display(HTML(\"<b>📈 Courbes d'Apprentissage</b>\"))\n",
    "                        ModelVisualizer.plot_learning_curves(\n",
    "                            model, self.X_all, self.y_all, prob, name,\n",
    "                            cv=self._cv_slider.value\n",
    "                        )\n",
    "\n",
    "                    # Importance des features\n",
    "                    if self._show_fi.value:\n",
    "                        display(HTML(\"<b>🔍 Importance des Features</b>\"))\n",
    "                        ModelVisualizer.plot_feature_importance(\n",
    "                            model, self.feature_names, name,\n",
    "                            X_test=self.X_test, y_test=self.y_test, top_n=20\n",
    "                        )\n",
    "\n",
    "                    # Analyse résidus (régression)\n",
    "                    if prob == \"regression\":\n",
    "                        display(HTML(\"<b>📉 Analyse des Résidus</b>\"))\n",
    "                        ModelVisualizer.plot_residuals(metrics, name)\n",
    "\n",
    "                except ImportError as e:\n",
    "                    display(HTML(\n",
    "                        f\"<div style='padding:8px; background:#fef2f2; border:1px solid {PALETTE['danger']}; \"\n",
    "                        f\"border-radius:4px; color:{PALETTE['danger']}; margin-bottom:8px;'>\"\n",
    "                        f\"❌ Module manquant pour <b>{name}</b> : {e}<br>\"\n",
    "                        f\"<code>pip install {info['module'].split('.')[0]}</code></div>\"\n",
    "                    ))\n",
    "                except Exception as e:\n",
    "                    display(HTML(\n",
    "                        f\"<div style='padding:8px; background:#fef2f2; border:1px solid {PALETTE['danger']}; \"\n",
    "                        f\"border-radius:4px; color:{PALETTE['danger']}; margin-bottom:8px;'>\"\n",
    "                        f\"❌ Erreur pour <b>{name}</b> : {str(e)}</div>\"\n",
    "                    ))\n",
    "                    traceback.print_exc()\n",
    "\n",
    "                progress.value = idx + 1\n",
    "\n",
    "            # ── Résumé comparatif ───────────────────────────────────────\n",
    "            if len(self.results) > 1:\n",
    "                display(HTML(\n",
    "                    f\"<hr><h3 style='color:{PALETTE['text']}; margin-top:20px;'>\"\n",
    "                    \"📊 Résumé Comparatif de tous les Modèles</h3>\"\n",
    "                ))\n",
    "                self._display_comparative_summary()\n",
    "\n",
    "                if self._show_roc.value:\n",
    "                    ModelVisualizer.plot_roc_pr_curves(self.results, prob, ttype)\n",
    "\n",
    "                ModelVisualizer.plot_comparative_bar(self.results, prob)\n",
    "                if prob == \"classification\":\n",
    "                    ModelVisualizer.plot_radar(self.results, prob)\n",
    "                else:\n",
    "                    ModelVisualizer.plot_prediction_vs_actual(self.results)\n",
    "\n",
    "            # Persistance pour cellule 8\n",
    "            import builtins\n",
    "            builtins.__dict__[\"modeling_results\"] = self.results\n",
    "            builtins.__dict__[\"modeling_problem_info\"] = self.problem_info\n",
    "            builtins.__dict__[\"modeling_feature_names\"] = self.feature_names\n",
    "\n",
    "            display(HTML(\n",
    "                f\"<div style='padding:12px; background:#f0fdf4; border-left:4px solid {PALETTE['success']}; \"\n",
    "                f\"border-radius:4px; margin-top:16px; color:#166534;'>\"\n",
    "                f\"✅ Entraînement terminé. Les résultats sont accessibles via <code>modeling_results</code>.<br>\"\n",
    "                f\"Passez à la <b>Cellule 8</b> pour la validation croisée et l'évaluation finale.</div>\"\n",
    "            ))\n",
    "\n",
    "        self._train_btn.disabled = False\n",
    "        self._train_btn.description = \"▶ Entraîner les modèles sélectionnés\"\n",
    "\n",
    "    def _display_single_result(self, model_name, metrics, elapsed, prob, ttype):\n",
    "        \"\"\"Affiche les métriques + visuels pour un seul modèle.\"\"\"\n",
    "        if prob == \"classification\":\n",
    "            acc  = metrics.get(\"accuracy\", 0)\n",
    "            f1   = metrics.get(\"f1\", 0)\n",
    "            prec = metrics.get(\"precision\", 0)\n",
    "            rec  = metrics.get(\"recall\", 0)\n",
    "            auc  = metrics.get(\"roc_auc\", np.nan)\n",
    "            auc_str = f\"{auc:.4f}\" if not np.isnan(auc) else \"N/A\"\n",
    "            color_acc = PALETTE[\"success\"] if acc > 0.8 else (PALETTE[\"warning\"] if acc > 0.65 else PALETTE[\"danger\"])\n",
    "\n",
    "            html = f\"\"\"\n",
    "            <div style='border:1px solid {PALETTE[\"border\"]}; border-radius:8px;\n",
    "                        padding:14px; background:{PALETTE[\"card\"]}; margin:10px 0;'>\n",
    "              <div style='display:flex; align-items:center; gap:10px; margin-bottom:10px;'>\n",
    "                <span style='font-size:18px; font-weight:700; color:{PALETTE[\"text\"]};'>✅ {model_name}</span>\n",
    "                <span style='font-size:12px; color:{PALETTE[\"muted\"]};'>({elapsed:.1f}s)</span>\n",
    "              </div>\n",
    "              <div style='display:grid; grid-template-columns:repeat(5,1fr); gap:8px;'>\n",
    "                {_metric_card(\"Accuracy\",  f\"{acc:.4f}\",  color_acc)}\n",
    "                {_metric_card(\"Précision\", f\"{prec:.4f}\", PALETTE[\"primary\"])}\n",
    "                {_metric_card(\"Rappel\",    f\"{rec:.4f}\",  PALETTE[\"info\"])}\n",
    "                {_metric_card(\"F1-Score\",  f\"{f1:.4f}\",   PALETTE[\"success\"])}\n",
    "                {_metric_card(\"ROC AUC\",   auc_str,       PALETTE[\"warning\"])}\n",
    "              </div>\n",
    "            </div>\n",
    "            \"\"\"\n",
    "            display(HTML(html))\n",
    "\n",
    "            # Confusion matrix\n",
    "            if \"confusion_matrix\" in metrics:\n",
    "                cn = (self.label_encoder.classes_.tolist()\n",
    "                      if self.label_encoder is not None else None)\n",
    "                ModelVisualizer.plot_confusion_matrix(metrics[\"confusion_matrix\"], model_name, cn)\n",
    "\n",
    "            # Rapport classification\n",
    "            if \"report\" in metrics:\n",
    "                _display_classification_report(metrics[\"report\"])\n",
    "\n",
    "        else:  # regression\n",
    "            r2  = metrics.get(\"r2\", 0)\n",
    "            mae = metrics.get(\"mae\", 0)\n",
    "            mse = metrics.get(\"mse\", 0)\n",
    "            rmse = metrics.get(\"rmse\", 0)\n",
    "            mape = metrics.get(\"mape\", 0)\n",
    "            color_r2 = PALETTE[\"success\"] if r2 > 0.8 else (PALETTE[\"warning\"] if r2 > 0.5 else PALETTE[\"danger\"])\n",
    "\n",
    "            html = f\"\"\"\n",
    "            <div style='border:1px solid {PALETTE[\"border\"]}; border-radius:8px;\n",
    "                        padding:14px; background:{PALETTE[\"card\"]}; margin:10px 0;'>\n",
    "              <div style='font-size:18px; font-weight:700; color:{PALETTE[\"text\"]}; margin-bottom:10px;'>\n",
    "                ✅ {model_name} <span style='font-size:12px; color:{PALETTE[\"muted\"]};'>({elapsed:.1f}s)</span>\n",
    "              </div>\n",
    "              <div style='display:grid; grid-template-columns:repeat(5,1fr); gap:8px;'>\n",
    "                {_metric_card(\"R²\",   f\"{r2:.4f}\",   color_r2)}\n",
    "                {_metric_card(\"MAE\",  f\"{mae:.4f}\",  PALETTE[\"primary\"])}\n",
    "                {_metric_card(\"MSE\",  f\"{mse:.4f}\",  PALETTE[\"info\"])}\n",
    "                {_metric_card(\"RMSE\", f\"{rmse:.4f}\", PALETTE[\"warning\"])}\n",
    "                {_metric_card(\"MAPE\", f\"{mape:.2f}%\",PALETTE[\"danger\"])}\n",
    "              </div>\n",
    "            </div>\n",
    "            \"\"\"\n",
    "            display(HTML(html))\n",
    "\n",
    "    def _display_comparative_summary(self):\n",
    "        \"\"\"Tableau comparatif stylisé.\"\"\"\n",
    "        prob = self.problem_info[\"problem_type\"]\n",
    "        rows = []\n",
    "        for name, res in self.results.items():\n",
    "            m = res[\"metrics\"]\n",
    "            row = {\"Modèle\": name, \"Temps (s)\": f\"{res['train_time']:.1f}\"}\n",
    "            if prob == \"classification\":\n",
    "                row.update({\n",
    "                    \"Accuracy\":  round(m.get(\"accuracy\", 0), 4),\n",
    "                    \"Précision\": round(m.get(\"precision\", 0), 4),\n",
    "                    \"Rappel\":    round(m.get(\"recall\", 0), 4),\n",
    "                    \"F1-Score\":  round(m.get(\"f1\", 0), 4),\n",
    "                    \"ROC AUC\":   round(m.get(\"roc_auc\", 0) if not np.isnan(m.get(\"roc_auc\", 0)) else 0, 4),\n",
    "                })\n",
    "            else:\n",
    "                row.update({\n",
    "                    \"R²\":   round(m.get(\"r2\", 0), 4),\n",
    "                    \"MAE\":  round(m.get(\"mae\", 0), 4),\n",
    "                    \"RMSE\": round(m.get(\"rmse\", 0), 4),\n",
    "                    \"MAPE\": f\"{m.get('mape', 0):.2f}%\",\n",
    "                })\n",
    "            rows.append(row)\n",
    "\n",
    "        df_summary = pd.DataFrame(rows)\n",
    "        num_cols = [c for c in df_summary.columns if c not in [\"Modèle\", \"Temps (s)\", \"MAPE\"]]\n",
    "        styled = (\n",
    "            df_summary.style\n",
    "            .set_table_styles([\n",
    "                {\"selector\": \"thead th\", \"props\": [(\"background\", PALETTE[\"primary\"]),\n",
    "                                                    (\"color\", \"white\"),\n",
    "                                                    (\"font-weight\", \"bold\"),\n",
    "                                                    (\"padding\", \"8px 12px\")]},\n",
    "                {\"selector\": \"tbody tr:hover\", \"props\": [(\"background\", \"#F0F9FF\")]},\n",
    "                {\"selector\": \"tbody td\", \"props\": [(\"padding\", \"6px 12px\")]},\n",
    "            ])\n",
    "            .highlight_max(subset=num_cols, color=\"#BBF7D0\")\n",
    "            .highlight_min(subset=[c for c in num_cols if c in [\"MAE\", \"RMSE\"]], color=\"#FEE2E2\")\n",
    "            .set_caption(\"🏆 Tableau comparatif — meilleur en vert, pire en rouge\")\n",
    "        )\n",
    "        display(styled)\n",
    "\n",
    "        # Insight meilleur modèle\n",
    "        if prob == \"classification\":\n",
    "            best = max(self.results, key=lambda n: self.results[n][\"metrics\"].get(\"f1\", 0))\n",
    "            metric_str = f\"F1-Score = {self.results[best]['metrics'].get('f1', 0):.4f}\"\n",
    "        else:\n",
    "            best = max(self.results, key=lambda n: self.results[n][\"metrics\"].get(\"r2\", 0))\n",
    "            metric_str = f\"R² = {self.results[best]['metrics'].get('r2', 0):.4f}\"\n",
    "\n",
    "        display(HTML(\n",
    "            f\"<div style='padding:10px 14px; background:#f0fdf4; border:1px solid #bbf7d0; \"\n",
    "            f\"border-radius:6px; margin-top:10px; color:#166534;'>\"\n",
    "            f\"🏆 <b>Meilleur modèle :</b> {best} ({metric_str})\"\n",
    "            f\"</div>\"\n",
    "        ))\n",
    "\n",
    "# ================================================================\n",
    "# 6. HELPERS UI\n",
    "# ================================================================\n",
    "def _metric_card(label, value, color):\n",
    "    return (\n",
    "        f\"<div style='background:{color}15; border:1px solid {color}40; border-radius:6px; \"\n",
    "        f\"padding:10px 8px; text-align:center;'>\"\n",
    "        f\"<div style='font-size:18px; font-weight:700; color:{color};'>{value}</div>\"\n",
    "        f\"<div style='font-size:11px; color:#64748b; margin-top:2px;'>{label}</div>\"\n",
    "        f\"</div>\"\n",
    "    )\n",
    "\n",
    "def _display_classification_report(report_dict):\n",
    "    rows = []\n",
    "    for label, vals in report_dict.items():\n",
    "        if label in (\"accuracy\", \"macro avg\", \"weighted avg\"):\n",
    "            continue\n",
    "        if isinstance(vals, dict):\n",
    "            rows.append({\n",
    "                \"Classe\": str(label),\n",
    "                \"Précision\": round(vals.get(\"precision\", 0), 3),\n",
    "                \"Rappel\":    round(vals.get(\"recall\", 0), 3),\n",
    "                \"F1-Score\":  round(vals.get(\"f1-score\", 0), 3),\n",
    "                \"Support\":   int(vals.get(\"support\", 0)),\n",
    "            })\n",
    "    if rows:\n",
    "        df_r = pd.DataFrame(rows)\n",
    "        display(HTML(\"<b style='font-size:13px;'>Rapport de classification détaillé :</b>\"))\n",
    "        display(df_r.style.background_gradient(cmap=\"RdYlGn\", subset=[\"Précision\",\"Rappel\",\"F1-Score\"])\n",
    "                          .set_table_styles([{\"selector\": \"td,th\", \"props\": [(\"padding\",\"5px 10px\")]}]))\n",
    "\n",
    "# ================================================================\n",
    "# 7. INTERFACE PRINCIPALE\n",
    "# ================================================================\n",
    "class ModelingUI:\n",
    "    def __init__(self, encoder_results: dict):\n",
    "        self.encoder_results = encoder_results\n",
    "        self.dfs = {k: v for k, v in encoder_results.items() if isinstance(v, pd.DataFrame)}\n",
    "        self.non_tabular = {k: v for k, v in encoder_results.items() if not isinstance(v, pd.DataFrame)}\n",
    "        self._build_ui()\n",
    "\n",
    "    def _build_ui(self):\n",
    "        if not self.dfs and not self.non_tabular:\n",
    "            self.ui = widgets.HTML(\n",
    "                f\"<div style='padding:12px; background:#fef2f2; border-left:4px solid {PALETTE['danger']}; \"\n",
    "                f\"color:{PALETTE['danger']}; border-radius:4px;'>\"\n",
    "                \"Aucune donnée dans <code>encoder.results</code>. Exécutez les cellules précédentes.</div>\"\n",
    "            )\n",
    "            return\n",
    "\n",
    "        self.ds_selector = widgets.Dropdown(\n",
    "            options=list(self.dfs.keys()),\n",
    "            description=\"Dataset :\", style={\"description_width\": \"initial\"},\n",
    "            layout=widgets.Layout(width=\"420px\")\n",
    "        )\n",
    "        potential_targets = detect_potential_targets(self.dfs[self.ds_selector.value]) if self.dfs else []\n",
    "        target_opts = [c for c, _ in potential_targets]\n",
    "\n",
    "        self.target_selector = widgets.Dropdown(\n",
    "            options=target_opts,\n",
    "            value=target_opts[0] if target_opts else None,\n",
    "            description=\"Cible :\", style={\"description_width\": \"initial\"},\n",
    "            layout=widgets.Layout(width=\"420px\")\n",
    "        )\n",
    "        self.ds_selector.observe(self._on_ds_change, names=\"value\")\n",
    "\n",
    "        self.test_size_slider = widgets.FloatSlider(\n",
    "            value=0.2, min=0.1, max=0.5, step=0.05,\n",
    "            description=\"Test split :\", style={\"description_width\": \"initial\"},\n",
    "            layout=widgets.Layout(width=\"360px\")\n",
    "        )\n",
    "\n",
    "        self.detect_btn = widgets.Button(\n",
    "            description=\"🔍 Analyser & Détecter le Problème\",\n",
    "            button_style=\"primary\", layout=widgets.Layout(width=\"320px\", height=\"36px\")\n",
    "        )\n",
    "        self.detect_btn.on_click(self._detect_and_launch)\n",
    "\n",
    "        self.output = widgets.Output()\n",
    "        self.ui = widgets.VBox([\n",
    "            widgets.HTML(f\"\"\"\n",
    "            <div style='border-bottom:2px solid {PALETTE[\"border\"]}; margin-bottom:14px; padding-bottom:10px;'>\n",
    "              <h2 style='font-size:22px; color:{PALETTE[\"text\"]}; margin:0;'>\n",
    "                🧠 Cellule 7 — Modélisation Automatique\n",
    "              </h2>\n",
    "              <p style='color:{PALETTE[\"muted\"]}; font-size:13px; margin:6px 0 0 0;'>\n",
    "                Détection automatique du type de problème · Sélection des modèles ·\n",
    "                Entraînement · Métriques · Graphiques avancés · Insights\n",
    "              </p>\n",
    "            </div>\n",
    "            \"\"\"),\n",
    "            self.ds_selector, self.target_selector, self.test_size_slider,\n",
    "            self.detect_btn, self.output,\n",
    "        ], layout=widgets.Layout(padding=\"20px\"))\n",
    "\n",
    "    def _on_ds_change(self, change):\n",
    "        if change[\"new\"] in self.dfs:\n",
    "            pt = detect_potential_targets(self.dfs[change[\"new\"]])\n",
    "            self.target_selector.options = [c for c, _ in pt]\n",
    "\n",
    "    def _detect_and_launch(self, b):\n",
    "        with self.output:\n",
    "            clear_output(wait=True)\n",
    "            ds_key    = self.ds_selector.value\n",
    "            target    = self.target_selector.value\n",
    "            if not ds_key or not target:\n",
    "                display(HTML(f\"<div style='color:{PALETTE['danger']};'>Sélectionnez un dataset et une cible.</div>\"))\n",
    "                return\n",
    "\n",
    "            df = self.dfs[ds_key]\n",
    "            problem_info = detect_problem_type(df, target)\n",
    "            if \"error\" in problem_info:\n",
    "                display(HTML(f\"<div style='color:{PALETTE['danger']};'>{problem_info['error']}</div>\"))\n",
    "                return\n",
    "\n",
    "            # Afficher diagnostic\n",
    "            _display_problem_card(problem_info, target, df)\n",
    "\n",
    "            # Features\n",
    "            X_raw = df.drop(columns=[target])\n",
    "            feature_names = list(X_raw.columns)\n",
    "\n",
    "            # Lancer UI de sélection\n",
    "            sel_ui = ModelSelectionUI(\n",
    "                df=df, target_col=target, problem_info=problem_info,\n",
    "                feature_names=feature_names, non_tabular_data=self.non_tabular,\n",
    "                test_size=self.test_size_slider.value,\n",
    "            )\n",
    "            display(sel_ui.ui)\n",
    "\n",
    "    def show(self):\n",
    "        display(self.ui)\n",
    "\n",
    "def _display_problem_card(info, target_col, df):\n",
    "    prob  = info[\"problem_type\"]\n",
    "    ttype = info[\"target_type\"]\n",
    "    color = PALETTE[\"success\"] if prob == \"classification\" else PALETTE[\"info\"]\n",
    "    icon  = \"🎯\" if prob == \"classification\" else \"📈\"\n",
    "\n",
    "    details = \"\"\n",
    "    if prob == \"classification\":\n",
    "        n_cls = info.get(\"n_classes\", \"?\")\n",
    "        ir    = info.get(\"imbalance_ratio\", \"?\")\n",
    "        details = (\n",
    "            f\"<li><b>Classes :</b> {n_cls}</li>\"\n",
    "            f\"<li><b>Ratio de déséquilibre :</b> {ir}x \"\n",
    "            + (\"⚠ Déséquilibre fort\" if isinstance(ir, (int,float)) and ir > 3 else \"✔ OK\")\n",
    "            + \"</li>\"\n",
    "        )\n",
    "    else:\n",
    "        st = info.get(\"target_stats\", {})\n",
    "        details = (\n",
    "            f\"<li><b>Moyenne :</b> {st.get('mean', '?')}</li>\"\n",
    "            f\"<li><b>Écart-type :</b> {st.get('std', '?')}</li>\"\n",
    "            f\"<li><b>Min/Max :</b> {st.get('min', '?')} / {st.get('max', '?')}</li>\"\n",
    "        )\n",
    "\n",
    "    display(HTML(f\"\"\"\n",
    "    <div style='border:1px solid {color}40; background:{color}10; border-radius:8px;\n",
    "                padding:14px 18px; margin:10px 0;'>\n",
    "      <h4 style='margin:0 0 8px 0; color:{PALETTE[\"text\"]};'>\n",
    "        {icon} Problème détecté : <b>{prob.capitalize()}</b> ({ttype})\n",
    "      </h4>\n",
    "      <ul style='margin:0; color:{PALETTE[\"muted\"]}; font-size:13px; line-height:1.7;'>\n",
    "        <li><b>Colonne cible :</b> <code>{target_col}</code></li>\n",
    "        <li><b>Lignes :</b> {len(df):,} · <b>Features :</b> {len(df.columns)-1}</li>\n",
    "        {details}\n",
    "      </ul>\n",
    "    </div>\n",
    "    \"\"\"))\n",
    "\n",
    "# ================================================================\n",
    "# 8. INSTANCIATION\n",
    "# ================================================================\n",
    "if \"encoder\" in locals() and hasattr(encoder, \"results\") and encoder.results:\n",
    "    modeling_ui = ModelingUI(encoder.results)\n",
    "    modeling_ui.show()\n",
    "else:\n",
    "    display(HTML(\n",
    "        f\"<div style='padding:12px; background:#fef2f2; border-left:4px solid {PALETTE['danger']}; \"\n",
    "        f\"color:{PALETTE['danger']}; border-radius:4px;'>\"\n",
    "        \"⚠ <code>encoder.results</code> introuvable. Exécutez les cellules précédentes.</div>\"\n",
    "    ))"
   ]
  },
