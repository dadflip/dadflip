{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"datasetVersion","sourceId":16017627,"datasetId":10273461,"databundleVersionId":16982174}],"dockerImageVersionId":31328,"isInternetEnabled":false,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# ============================================================\n# CELLULE 0 — Installation & Imports\n# ============================================================\n!pip install pandas numpy matplotlib seaborn scikit-learn ipywidgets openpyxl xlrd pyarrow -q\n\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport matplotlib.ticker as ticker\nimport seaborn as sns\nimport warnings\nimport io, os, json\nfrom IPython.display import display, HTML, clear_output\nimport ipywidgets as widgets\nfrom sklearn.preprocessing import (LabelEncoder, OrdinalEncoder,\n                                   OneHotEncoder, TargetEncoder,\n                                   StandardScaler)\n\nwarnings.filterwarnings('ignore')\npd.set_option('display.max_columns', 50)\npd.set_option('display.float_format', '{:.4f}'.format)\n\nprint(\"Environnement prêt.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-30T08:59:38.430018Z","iopub.execute_input":"2026-04-30T08:59:38.430355Z","iopub.status.idle":"2026-04-30T08:59:44.238970Z","shell.execute_reply.started":"2026-04-30T08:59:38.430326Z","shell.execute_reply":"2026-04-30T08:59:44.238225Z"}},"outputs":[{"name":"stdout","text":"Environnement prêt.\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# ============================================================\n# CELLULE 1 — IMPORT UNIVERSEL DES DONNEES\n# Supporte : CSV, TSV, Excel, JSON, Parquet, URL, texte colle\n# Mode simple (un fichier) ou multi-fichiers (train / test / autre)\n# ============================================================\n\nimport io\nimport pandas as pd\nimport ipywidgets as widgets\nfrom IPython.display import display, clear_output\n\n\ndef _read_file_bytes(raw_bytes: bytes, filename: str,\n                     sep: str, enc: str, header) -> pd.DataFrame:\n    \"\"\"Lire un contenu binaire selon l'extension du fichier.\"\"\"\n    ext = filename.rsplit('.', 1)[-1].lower() if '.' in filename else 'csv'\n    buf = io.BytesIO(raw_bytes)\n    if ext == 'csv':\n        return pd.read_csv(buf, sep=sep, encoding=enc, header=header)\n    elif ext == 'tsv':\n        return pd.read_csv(buf, sep='\\t', encoding=enc, header=header)\n    elif ext in ('xls', 'xlsx'):\n        return pd.read_excel(buf, header=header)\n    elif ext == 'json':\n        return pd.read_json(buf)\n    elif ext == 'parquet':\n        return pd.read_parquet(buf)\n    else:\n        return pd.read_csv(buf, sep=sep, encoding=enc, header=header)\n\n\ndef _sample_df(df: pd.DataFrame, pct: int) -> pd.DataFrame:\n    \"\"\"\n    Retourne un sous-échantillon du DataFrame selon le pourcentage choisi.\n    - pct == 100 : retourne le DataFrame complet (pas de copie)\n    - pct <  100 : échantillon aléatoire reproductible (seed=42)\n    \"\"\"\n    if pct >= 100:\n        return df\n    n = max(1, int(len(df) * pct / 100))\n    return df.sample(n=n, random_state=42).reset_index(drop=True)\n\n\ndef _extract_from_upload(upload_widget):\n    \"\"\"\n    Compatibilité multi-versions ipywidgets.\n    - v7  : upload_widget.value est un dict  {filename: {content, ...}}\n    - v8+ : upload_widget.value est un tuple de UploadedFile\n    Retourne une liste de (filename, bytes).\n    \"\"\"\n    val = upload_widget.value\n    results = []\n\n    if isinstance(val, dict):\n        for fname, info in val.items():\n            results.append((fname, bytes(info['content'])))\n\n    elif isinstance(val, (list, tuple)):\n        for item in val:\n            if hasattr(item, 'content'):\n                name = getattr(item, 'name', 'fichier.csv')\n                content = item.content\n                if hasattr(content, 'tobytes'):\n                    content = content.tobytes()\n                results.append((name, bytes(content)))\n            elif isinstance(item, dict):\n                results.append((item.get('name', 'fichier.csv'),\n                                bytes(item.get('content', b''))))\n    return results\n\n\nclass DataLoader:\n    \"\"\"\n    Chargement universel et interactif d'un ou plusieurs datasets.\n\n    Modes :\n        - Fichier unique  : df = loader.get()\n        - Multi-fichiers  : datasets = loader.get_all()\n                            -> dict {label: DataFrame}\n    \"\"\"\n\n    SUPPORTED = {\n        'CSV (.csv)'         : 'csv',\n        'TSV (.tsv)'         : 'tsv',\n        'Excel (.xlsx/.xls)' : 'excel',\n        'JSON (.json)'       : 'json',\n        'Parquet (.parquet)' : 'parquet',\n        'URL directe'        : 'url',\n        'Coller du texte CSV': 'paste',\n    }\n\n    SLOT_LABELS = ['Fichier principal', 'Train', 'Test', 'Validation',\n                   'Fichier supplementaire']\n\n    def __init__(self):\n        self.datasets = {}\n        self._build_ui()\n\n    # ------------------------------------------------------------------\n    # Construction de l'interface\n    # ------------------------------------------------------------------\n    def _build_ui(self):\n\n        title = widgets.HTML(\n            \"<h3 style='margin:0 0 12px'>Chargement du Dataset</h3>\")\n\n        self.mode_toggle = widgets.ToggleButtons(\n            options=['Fichier unique', 'Multi-fichiers (train/test/...)'],\n            value='Fichier unique',\n            button_style='',\n            layout=widgets.Layout(margin='0 0 12px 0')\n        )\n\n        self.source_dd = widgets.Dropdown(\n            options=list(self.SUPPORTED.keys()),\n            description='Source :',\n            style={'description_width': '80px'},\n            layout=widgets.Layout(width='300px')\n        )\n\n        # Options avancées CSV\n        self.sep_input = widgets.Text(\n            value=',', description='Separateur :',\n            style={'description_width': '90px'},\n            layout=widgets.Layout(width='180px')\n        )\n        self.enc_input = widgets.Text(\n            value='utf-8', description='Encodage :',\n            style={'description_width': '90px'},\n            layout=widgets.Layout(width='180px')\n        )\n        self.header_cb = widgets.Checkbox(\n            value=True, description='Premiere ligne = en-tetes', indent=False)\n\n        adv = widgets.Accordion(children=[\n            widgets.HBox([self.sep_input, self.enc_input, self.header_cb])\n        ])\n        adv.set_title(0, 'Options avancees (CSV/TSV)')\n        adv.selected_index = None\n\n        # --- Curseur % des données à utiliser\n        self.sample_slider = widgets.IntSlider(\n            value=100, min=1, max=100, step=1,\n            description='Utiliser :',\n            style={'description_width': '70px'},\n            layout=widgets.Layout(width='340px'),\n            readout=False,        # on affiche nous-mêmes le label\n        )\n        self._sample_label = widgets.HTML(\n            value=self._slider_label(100),\n            layout=widgets.Layout(width='160px')\n        )\n        self.sample_slider.observe(\n            lambda c: setattr(self._sample_label, 'value',\n                              self._slider_label(c['new'])),\n            names='value'\n        )\n        sample_row = widgets.HBox(\n            [self.sample_slider, self._sample_label],\n            layout=widgets.Layout(align_items='center', margin='6px 0')\n        )\n\n        # Zone dynamique\n        self.dynamic_box = widgets.VBox([])\n\n        # Boutons\n        self.load_btn = widgets.Button(\n            description='Charger',\n            button_style='primary',\n            layout=widgets.Layout(width='160px', height='36px')\n        )\n        self.status = widgets.Output()\n\n        self.source_dd.observe(self._refresh_dynamic, names='value')\n        self.mode_toggle.observe(self._refresh_dynamic, names='value')\n        self.load_btn.on_click(self._on_load)\n\n        self.ui = widgets.VBox([\n            title,\n            self.mode_toggle,\n            self.source_dd,\n            self.dynamic_box,\n            adv,\n            sample_row,\n            self.load_btn,\n            self.status\n        ])\n\n        self._refresh_dynamic(None)\n\n    @staticmethod\n    def _slider_label(pct: int) -> str:\n        if pct == 100:\n            return \"<span style='color:#2e7d32;font-size:.88em'>▶ 100 % — données complètes</span>\"\n        color = '#e65100' if pct < 25 else '#1565c0'\n        return (f\"<span style='color:{color};font-size:.88em'>\"\n                f\"▶ {pct} % de l'échantillon</span>\")\n\n    def _make_upload_slot(self, label: str) -> tuple:\n        lbl = widgets.Label(\n            value=label,\n            layout=widgets.Layout(width='160px')\n        )\n        btn = widgets.FileUpload(\n            accept='.csv,.tsv,.xlsx,.xls,.json,.parquet',\n            multiple=False,\n            description='Choisir',\n            layout=widgets.Layout(width='220px')\n        )\n        return lbl, btn\n\n    def _refresh_dynamic(self, _):\n        src   = self.SUPPORTED[self.source_dd.value]\n        multi = (self.mode_toggle.value != 'Fichier unique')\n        children = []\n\n        if src in ('csv', 'tsv', 'excel', 'json', 'parquet'):\n            if not multi:\n                lbl, btn = self._make_upload_slot('Fichier :')\n                self._slots = [('Donnees', btn)]\n                children.append(widgets.HBox([lbl, btn]))\n            else:\n                self._slots = []\n                rows = []\n                for sname in self.SLOT_LABELS:\n                    lbl, btn = self._make_upload_slot(f'{sname} :')\n                    self._slots.append((sname, btn))\n                    note = widgets.Label(\n                        '(optionnel)' if 'Train' not in sname else '',\n                        layout=widgets.Layout(width='80px')\n                    )\n                    rows.append(widgets.HBox([lbl, btn, note]))\n                note_box = widgets.HTML(\n                    \"<small style='color:#666'>Laissez vide les slots \"\n                    \"non utilises.</small>\")\n                children = rows + [note_box]\n\n        elif src == 'url':\n            if not multi:\n                self._url_inputs = [('Donnees', widgets.Text(\n                    placeholder='https://...', description='URL :',\n                    style={'description_width': '50px'},\n                    layout=widgets.Layout(width='520px')))]\n                children = [self._url_inputs[0][1]]\n            else:\n                self._url_inputs = []\n                for sname in self.SLOT_LABELS:\n                    inp = widgets.Text(\n                        placeholder='https://...',\n                        description=f'{sname} :',\n                        style={'description_width': '130px'},\n                        layout=widgets.Layout(width='560px'))\n                    self._url_inputs.append((sname, inp))\n                    children.append(inp)\n\n        elif src == 'paste':\n            self._paste_area = widgets.Textarea(\n                placeholder='Collez ici votre CSV brut...',\n                layout=widgets.Layout(width='520px', height='130px'))\n            children = [self._paste_area]\n\n        self.dynamic_box.children = children\n\n    # ------------------------------------------------------------------\n    # Chargement\n    # ------------------------------------------------------------------\n    def _on_load(self, _):\n        with self.status:\n            clear_output()\n            try:\n                src    = self.SUPPORTED[self.source_dd.value]\n                sep    = self.sep_input.value or ','\n                enc    = self.enc_input.value or 'utf-8'\n                header = 0 if self.header_cb.value else None\n                pct    = self.sample_slider.value\n                self.datasets = {}\n\n                def _apply_sample(df: pd.DataFrame, label: str,\n                                  fname: str) -> pd.DataFrame:\n                    \"\"\"Échantillonne et affiche le résumé.\"\"\"\n                    df_s = _sample_df(df, pct)\n                    suffix = (f\"  [{pct} % → {df_s.shape[0]:,} lignes]\"\n                              if pct < 100 else \"\")\n                    print(f\"[{label}]  '{fname}'  \"\n                          f\"→ {df.shape[0]:,} lignes × \"\n                          f\"{df.shape[1]:,} colonnes{suffix}\")\n                    return df_s\n\n                # --- Fichiers uploadés\n                if src in ('csv', 'tsv', 'excel', 'json', 'parquet'):\n                    for label, btn in self._slots:\n                        files = _extract_from_upload(btn)\n                        if not files:\n                            continue\n                        fname, raw = files[0]\n                        df = _read_file_bytes(raw, fname, sep, enc, header)\n                        self.datasets[label] = _apply_sample(df, label, fname)\n\n                # --- URL\n                elif src == 'url':\n                    for label, inp in self._url_inputs:\n                        url = inp.value.strip()\n                        if not url:\n                            continue\n                        ext = url.split('?')[0].rsplit('.', 1)[-1].lower()\n                        if ext == 'parquet':\n                            df = pd.read_parquet(url)\n                        elif ext in ('xls', 'xlsx'):\n                            df = pd.read_excel(url, header=header)\n                        elif ext == 'json':\n                            df = pd.read_json(url)\n                        else:\n                            df = pd.read_csv(url, sep=sep,\n                                             encoding=enc, header=header)\n                        self.datasets[label] = _apply_sample(\n                            df, label, url.split('/')[-1] or url)\n\n                # --- Texte collé\n                elif src == 'paste':\n                    text = self._paste_area.value.strip()\n                    if not text:\n                        print(\"Collez du contenu CSV avant de charger.\")\n                        return\n                    df = pd.read_csv(io.StringIO(text), sep=sep, header=header)\n                    self.datasets['Donnees'] = _apply_sample(\n                        df, 'Donnees', 'texte colle')\n\n                if not self.datasets:\n                    print(\"Aucun fichier charge. \"\n                          \"Verifiez la selection ou les champs.\")\n                    return\n\n                print(f\"\\nDatasets disponibles : {list(self.datasets.keys())}\")\n                print(\"Utilisez  loader.get()       pour le premier dataset\")\n                print(\"Utilisez  loader.get_all()   pour tous les datasets\")\n\n            except Exception as e:\n                import traceback\n                print(f\"Erreur : {e}\")\n                traceback.print_exc()\n\n    # ------------------------------------------------------------------\n    # Accesseurs\n    # ------------------------------------------------------------------\n    def show(self):\n        display(self.ui)\n\n    def get(self) -> pd.DataFrame:\n        \"\"\"Retourne le premier dataset charge.\"\"\"\n        if not self.datasets:\n            print(\"Aucun dataset charge.\")\n            return None\n        return next(iter(self.datasets.values()))\n\n    def get_all(self) -> dict:\n        \"\"\"Retourne tous les datasets sous forme de dict {label: DataFrame}.\"\"\"\n        return self.datasets\n\n\n# ── Lancement ──────────────────────────────────────────────────────────\nloader = DataLoader()\nloader.show()\n\n# ── Apres chargement ──────────────────────────────────────────────────\n# Fichier unique :\n#   df = loader.get()\n#\n# Multi-fichiers :\n#   datasets = loader.get_all()    # {'Train': df_train, 'Test': df_test, ...}\n#   df_train = datasets['Train']\n#   df_test  = datasets['Test']","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-30T09:56:28.994415Z","iopub.execute_input":"2026-04-30T09:56:28.994682Z","iopub.status.idle":"2026-04-30T09:56:29.049210Z","shell.execute_reply.started":"2026-04-30T09:56:28.994661Z","shell.execute_reply":"2026-04-30T09:56:29.048477Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"VBox(children=(HTML(value=\"<h3 style='margin:0 0 12px'>Chargement du Dataset</h3>\"), ToggleButtons(layout=Layo…","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"6b0be31fb98a43068606edea1b502b53"}},"metadata":{}}],"execution_count":18},{"cell_type":"code","source":"# ============================================================\n# CELLULE 2 — EXPLORATION INITIALE\n# Compatible mode simple et multi-fichiers (train/test/...)\n# ============================================================\n\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport matplotlib.gridspec as gridspec\nimport seaborn as sns\nfrom IPython.display import display, HTML, clear_output\nimport ipywidgets as widgets\nimport warnings\nwarnings.filterwarnings('ignore')\n\n\nclass DataExplorer:\n    \"\"\"\n    Exploration complète et visuelle d'un ou plusieurs DataFrames.\n\n    Usage :\n        explorer = DataExplorer(loader.get_all())\n        explorer.show()\n\n    Si un seul DataFrame :\n        explorer = DataExplorer({'Donnees': df})\n    \"\"\"\n\n    # ------------------------------------------------------------------\n    # Types semantiques\n    # ------------------------------------------------------------------\n    KIND_COLOR = {\n        'numeric'    : '#bbdefb',\n        'categorical': '#c8e6c9',\n        'binary'     : '#ffe0b2',\n        'datetime'   : '#e1bee7',\n        'text'       : '#fce4ec',\n        'id_like'    : '#f0f0f0',\n    }\n\n    def __init__(self, datasets: dict):\n        if isinstance(datasets, pd.DataFrame):\n            datasets = {'Donnees': datasets}\n        self.datasets = datasets\n        self.meta = {}          # label -> {col -> meta_dict}\n        for label, df in datasets.items():\n            self.meta[label] = self._infer_types(df)\n\n    # ------------------------------------------------------------------\n    # Inference des types semantiques\n    # ------------------------------------------------------------------\n    @staticmethod\n    def _infer_types(df: pd.DataFrame) -> dict:\n        col_meta = {}\n        for col in df.columns:\n            s        = df[col]\n            n_unique = s.nunique()\n            n_total  = max(len(s.dropna()), 1)\n            dtype    = s.dtype\n\n            if pd.api.types.is_datetime64_any_dtype(s):\n                kind = 'datetime'\n            elif pd.api.types.is_bool_dtype(s):\n                kind = 'binary'\n            elif pd.api.types.is_numeric_dtype(s):\n                if n_unique == 2:\n                    kind = 'binary'\n                elif n_unique / n_total > 0.95 and n_unique > 50:\n                    kind = 'id_like'\n                else:\n                    kind = 'numeric'\n            else:\n                avg_len = s.dropna().astype(str).str.len().mean()\n                if n_unique == 2:\n                    kind = 'binary'\n                elif n_unique / n_total > 0.90 and avg_len > 20:\n                    kind = 'text'\n                elif n_unique / n_total > 0.95 and n_unique > 50:\n                    kind = 'id_like'\n                else:\n                    kind = 'categorical'\n\n            col_meta[col] = {\n                'kind'    : kind,\n                'n_unique': n_unique,\n                'dtype'   : str(dtype),\n                'missing' : int(s.isna().sum()),\n                'pct_miss': float(s.isna().mean() * 100),\n            }\n        return col_meta\n\n    # ------------------------------------------------------------------\n    # Interface principale\n    # ------------------------------------------------------------------\n    def show(self):\n        if len(self.datasets) == 1:\n            label = next(iter(self.datasets))\n            self._show_dataset(label)\n        else:\n            # Onglets par dataset\n            tabs = []\n            tab_labels = []\n            for label in self.datasets:\n                out = widgets.Output()\n                with out:\n                    self._show_dataset(label)\n                tabs.append(out)\n                tab_labels.append(label)\n\n            tab_widget = widgets.Tab(children=tabs)\n            for i, lbl in enumerate(tab_labels):\n                tab_widget.set_title(i, lbl)\n\n            display(HTML(\n                \"<h3 style='margin:0 0 10px'>Exploration des Datasets</h3>\"))\n            display(tab_widget)\n\n            # Comparaison si train+test\n            if len(self.datasets) >= 2:\n                self._show_comparison()\n\n    # ------------------------------------------------------------------\n    # Affichage d'un seul dataset\n    # ------------------------------------------------------------------\n    def _show_dataset(self, label: str):\n        df       = self.datasets[label]\n        col_meta = self.meta[label]\n\n        # -- KPIs\n        n_rows, n_cols = df.shape\n        n_dup    = int(df.duplicated().sum())\n        n_miss   = int(df.isna().sum().sum())\n        pct_miss = n_miss / max(n_rows * n_cols, 1) * 100\n        mem_mb   = df.memory_usage(deep=True).sum() / 1e6\n\n        kpis = [\n            ('#e3f2fd', '#1565c0', f'{n_rows:,}',      'Lignes'),\n            ('#e3f2fd', '#1565c0', f'{n_cols:,}',       'Colonnes'),\n            ('#fce4ec', '#c62828', f'{n_dup:,}',         'Doublons'),\n            ('#fff8e1', '#e65100', f'{pct_miss:.1f}%',  '% Manquants'),\n            ('#f3e5f5', '#6a1b9a', f'{mem_mb:.2f} MB',  'Memoire'),\n        ]\n        kpi_html = \"<div style='display:flex;gap:10px;flex-wrap:wrap;margin:12px 0'>\"\n        for bg, fc, val, lbl in kpis:\n            kpi_html += (\n                f\"<div style='background:{bg};border-radius:8px;\"\n                f\"padding:10px 18px;text-align:center;min-width:120px;\"\n                f\"box-shadow:0 1px 4px rgba(0,0,0,.1)'>\"\n                f\"<div style='font-size:1.6em;font-weight:700;color:{fc}'>{val}</div>\"\n                f\"<div style='font-size:.8em;color:#555;margin-top:3px'>{lbl}</div>\"\n                f\"</div>\"\n            )\n        kpi_html += \"</div>\"\n        display(HTML(kpi_html))\n\n        # -- Apercu\n        display(HTML(\"<b>Apercu (5 premieres lignes)</b>\"))\n        display(df.head())\n\n        # -- Tableau résumé colonnes\n        display(HTML(\"<b style='display:block;margin-top:14px'>\"\n                     \"Resume des colonnes</b>\"))\n        display(self._summary_table(df, col_meta))\n\n        # -- Stats descriptives numériques\n        num_cols = [c for c, m in col_meta.items() if m['kind'] == 'numeric']\n        if num_cols:\n            display(HTML(\"<b style='display:block;margin-top:14px'>\"\n                         \"Statistiques descriptives — variables numeriques</b>\"))\n            desc = df[num_cols].describe().T\n            display(desc.style.background_gradient(cmap='Blues', axis=1)\n                              .format(precision=4))\n\n        # -- Top valeurs catégorielles\n        cat_cols = [c for c, m in col_meta.items() if m['kind'] == 'categorical']\n        if cat_cols:\n            display(HTML(\"<b style='display:block;margin-top:14px'>\"\n                         \"Variables categorielles — top valeurs</b>\"))\n            rows = []\n            for col in cat_cols:\n                top = df[col].value_counts().head(5)\n                rows.append({\n                    'Colonne'      : col,\n                    'Top 1'        : f\"{top.index[0]} ({top.iloc[0]})\" if len(top) > 0 else '-',\n                    'Top 2'        : f\"{top.index[1]} ({top.iloc[1]})\" if len(top) > 1 else '-',\n                    'Top 3'        : f\"{top.index[2]} ({top.iloc[2]})\" if len(top) > 2 else '-',\n                    'Nb modalites' : df[col].nunique(),\n                })\n            display(pd.DataFrame(rows).set_index('Colonne'))\n\n        # -- Visualisations\n        self._plot_distributions(df, col_meta, label)\n        self._plot_missing(df, label)\n        self._plot_correlation(df, num_cols, label)\n\n    # ------------------------------------------------------------------\n    # Tableau résumé stylee\n    # ------------------------------------------------------------------\n    def _summary_table(self, df, col_meta):\n        rows = []\n        for col, m in col_meta.items():\n            bg = self.KIND_COLOR.get(m['kind'], '#fff')\n            rows.append({\n                'Colonne'  : col,\n                'Type inf.': m['kind'],\n                'dtype'    : m['dtype'],\n                'Uniques'  : m['n_unique'],\n                'Manquants': m['missing'],\n                '% Manq.'  : m['pct_miss'],\n            })\n        df_s = pd.DataFrame(rows).set_index('Colonne')\n\n        def color_miss(val):\n            if val == 0:    return 'background-color:#d4edda'\n            if val < 5:     return 'background-color:#fff3cd'\n            if val < 20:    return 'background-color:#ffe0b2'\n            return 'background-color:#f8d7da'\n\n        def color_kind(val):\n            return f\"background-color:{self.KIND_COLOR.get(val,'#fff')}\"\n\n        return (df_s.style\n                    .applymap(color_miss, subset=['% Manq.'])\n                    .applymap(color_kind, subset=['Type inf.'])\n                    .format({'% Manq.': '{:.1f}%'}))\n\n    # ------------------------------------------------------------------\n    # Graphiques distributions\n    # ------------------------------------------------------------------\n    def _plot_distributions(self, df, col_meta, label):\n        num_cols = [c for c, m in col_meta.items() if m['kind'] == 'numeric']\n        cat_cols = [c for c, m in col_meta.items() if m['kind'] == 'categorical']\n\n        sns.set_style('whitegrid')\n        palette = sns.color_palette('muted')\n\n        def _grid(cols, nmax=12, ncols_grid=4):\n            cols = cols[:nmax]\n            n = len(cols)\n            if n == 0:\n                return\n            nc = min(ncols_grid, n)\n            nr = (n + nc - 1) // nc\n            return cols, nr, nc\n\n        if num_cols:\n            res = _grid(num_cols)\n            if res:\n                cols, nr, nc = res\n                fig, axes = plt.subplots(nr, nc,\n                                         figsize=(5 * nc, 3.5 * nr))\n                axes = np.array(axes).flatten()\n                for i, col in enumerate(cols):\n                    sns.histplot(df[col].dropna(), ax=axes[i], kde=True,\n                                 color=palette[i % len(palette)],\n                                 edgecolor='white', linewidth=.4)\n                    axes[i].set_title(col, fontsize=9, fontweight='bold')\n                    axes[i].set_xlabel('')\n                for j in range(len(cols), len(axes)):\n                    axes[j].set_visible(False)\n                fig.suptitle(f'[{label}]  Distributions — variables numeriques',\n                             fontsize=12, fontweight='bold', y=1.01)\n                plt.tight_layout()\n                plt.show()\n\n        if cat_cols:\n            res = _grid(cat_cols, nmax=8)\n            if res:\n                cols, nr, nc = res\n                fig, axes = plt.subplots(nr, nc,\n                                         figsize=(5 * nc, 3.5 * nr))\n                axes = np.array(axes).flatten()\n                for i, col in enumerate(cols):\n                    top = df[col].value_counts().head(10)\n                    sns.barplot(x=top.values, y=top.index.astype(str),\n                                ax=axes[i], palette='viridis')\n                    axes[i].set_title(col, fontsize=9, fontweight='bold')\n                    axes[i].set_xlabel('Frequence')\n                for j in range(len(cols), len(axes)):\n                    axes[j].set_visible(False)\n                fig.suptitle(f'[{label}]  Frequences — variables categorielles',\n                             fontsize=12, fontweight='bold', y=1.01)\n                plt.tight_layout()\n                plt.show()\n\n    # ------------------------------------------------------------------\n    # Graphique valeurs manquantes\n    # ------------------------------------------------------------------\n    def _plot_missing(self, df, label):\n        miss_pct = df.isnull().mean() * 100\n        miss_pct = miss_pct[miss_pct > 0].sort_values(ascending=False)\n\n        if miss_pct.empty:\n            display(HTML(\n                \"<div style='background:#d4edda;border-left:4px solid #28a745;\"\n                \"padding:10px 14px;border-radius:4px;margin:8px 0'>\"\n                \"Aucune valeur manquante dans ce dataset.</div>\"))\n            return\n\n        fig, ax = plt.subplots(figsize=(max(6, len(miss_pct) * 0.55 + 2), 3.5))\n        colors = ['#e74c3c' if v > 20 else '#f39c12' if v > 5\n                  else '#f1c40f' for v in miss_pct.values]\n        ax.bar(miss_pct.index, miss_pct.values, color=colors)\n        ax.set_ylabel('% Manquants')\n        ax.set_title(f'[{label}]  Valeurs manquantes par colonne',\n                     fontweight='bold')\n        ax.axhline(5,  color='#e67e22', linestyle='--', alpha=.6, label='seuil 5%')\n        ax.axhline(20, color='#e74c3c', linestyle='--', alpha=.6, label='seuil 20%')\n        ax.legend(fontsize=8)\n        plt.xticks(rotation=45, ha='right', fontsize=8)\n        plt.tight_layout()\n        plt.show()\n\n    # ------------------------------------------------------------------\n    # Matrice de correlation\n    # ------------------------------------------------------------------\n    def _plot_correlation(self, df, num_cols, label):\n        if len(num_cols) < 2:\n            return\n        corr = df[num_cols].corr()\n        size = max(6, min(16, len(num_cols)))\n        fig, ax = plt.subplots(figsize=(size, size * 0.8))\n        mask = np.triu(np.ones_like(corr, dtype=bool))\n        sns.heatmap(corr, mask=mask, annot=len(num_cols) <= 20,\n                    fmt='.2f', cmap='coolwarm', center=0,\n                    linewidths=.3, ax=ax,\n                    annot_kws={'size': 7})\n        ax.set_title(f'[{label}]  Matrice de correlation',\n                     fontweight='bold')\n        plt.tight_layout()\n        plt.show()\n\n    # ------------------------------------------------------------------\n    # Comparaison train / test (si multi-fichiers)\n    # ------------------------------------------------------------------\n    def _show_comparison(self):\n        labels = list(self.datasets.keys())\n        dfs    = list(self.datasets.values())\n\n        display(HTML(\n            \"<h4 style='margin:20px 0 8px;border-top:2px solid #ddd;\"\n            \"padding-top:14px'>Comparaison des datasets</h4>\"))\n\n        # Dimensions\n        rows = []\n        for lbl, df in zip(labels, dfs):\n            rows.append({\n                'Dataset'  : lbl,\n                'Lignes'   : df.shape[0],\n                'Colonnes' : df.shape[1],\n                'Manquants': f\"{df.isna().mean().mean()*100:.2f}%\",\n                'Doublons' : df.duplicated().sum(),\n            })\n        display(pd.DataFrame(rows).set_index('Dataset'))\n\n        # Colonnes communes / divergentes\n        sets = [set(df.columns) for df in dfs]\n        common = set.intersection(*sets)\n        only_in = {}\n        for lbl, df in zip(labels, dfs):\n            diff = set(df.columns) - common\n            if diff:\n                only_in[lbl] = sorted(diff)\n\n        display(HTML(\n            f\"<p><b>Colonnes communes :</b> {len(common)} &nbsp;|&nbsp; \"\n            + \" &nbsp;|&nbsp; \".join(\n                f\"<b>Uniquement dans {k} :</b> {v}\"\n                for k, v in only_in.items())\n            + \"</p>\"))\n\n        # Distribution comparee des variables numeriques communes\n        num_common = [\n            c for c in common\n            if all(pd.api.types.is_numeric_dtype(df[c]) for df in dfs)\n        ][:8]\n\n        if num_common:\n            nc = min(4, len(num_common))\n            nr = (len(num_common) + nc - 1) // nc\n            fig, axes = plt.subplots(nr, nc,\n                                     figsize=(5 * nc, 3.5 * nr))\n            axes = np.array(axes).flatten()\n            colors = sns.color_palette('Set2', len(dfs))\n            for i, col in enumerate(num_common):\n                for j, (lbl, df) in enumerate(zip(labels, dfs)):\n                    if col in df.columns:\n                        sns.kdeplot(df[col].dropna(), ax=axes[i],\n                                    label=lbl, color=colors[j], fill=True,\n                                    alpha=.25)\n                axes[i].set_title(col, fontsize=9, fontweight='bold')\n                axes[i].legend(fontsize=7)\n                axes[i].set_xlabel('')\n            for j in range(len(num_common), len(axes)):\n                axes[j].set_visible(False)\n            fig.suptitle('Comparaison des distributions numeriques communes',\n                         fontsize=12, fontweight='bold', y=1.01)\n            plt.tight_layout()\n            plt.show()\n\n\n# ── Lancement ─────────────────────────────────────────────────────────\n# Passer loader.get_all() pour multi-fichiers, ou loader.get() pour un seul\n\ndatasets = loader.get_all()   # dict {label: DataFrame}\n\nif datasets:\n    explorer = DataExplorer(datasets)\n    explorer.show()\nelse:\n    print(\"Aucun dataset charge. Executez d'abord la cellule 1.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-30T09:57:30.976119Z","iopub.execute_input":"2026-04-30T09:57:30.976379Z","iopub.status.idle":"2026-04-30T09:57:58.081796Z","shell.execute_reply.started":"2026-04-30T09:57:30.976358Z","shell.execute_reply":"2026-04-30T09:57:58.081097Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"<h3 style='margin:0 0 10px'>Exploration des Datasets</h3>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Tab(children=(Output(), Output()), selected_index=0, titles=('Train', 'Test'))","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"d4cd719c23a94c2ba484314a4ac6955c"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"<h4 style='margin:20px 0 8px;border-top:2px solid #ddd;padding-top:14px'>Comparaison des datasets</h4>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"         Lignes  Colonnes Manquants  Doublons\nDataset                                      \nTrain    187500        18     0.00%         0\nTest      62500        17     0.00%         0","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Lignes</th>\n      <th>Colonnes</th>\n      <th>Manquants</th>\n      <th>Doublons</th>\n    </tr>\n    <tr>\n      <th>Dataset</th>\n      <th></th>\n      <th></th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Train</th>\n      <td>187500</td>\n      <td>18</td>\n      <td>0.00%</td>\n      <td>0</td>\n    </tr>\n    <tr>\n      <th>Test</th>\n      <td>62500</td>\n      <td>17</td>\n      <td>0.00%</td>\n      <td>0</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"<p><b>Colonnes communes :</b> 17 &nbsp;|&nbsp; <b>Uniquement dans Train :</b> ['y']</p>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 2000x700 with 8 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":19},{"cell_type":"code","source":"# ============================================================\n# CELLULE 3 — ENCODAGE INTERACTIF DES VARIABLES\n# Auto-detection + selection manuelle par colonne\n# Compatible mode simple et multi-fichiers\n# ============================================================\n\nimport pandas as pd\nimport numpy as np\nfrom IPython.display import display, HTML, clear_output\nimport ipywidgets as widgets\nfrom sklearn.preprocessing import (LabelEncoder, OrdinalEncoder,\n                                   StandardScaler, MinMaxScaler,\n                                   RobustScaler)\nimport warnings\nwarnings.filterwarnings('ignore')\n\n\n# ------------------------------------------------------------------\n# Methodes disponibles par type semantique\n# ------------------------------------------------------------------\nENCODING_OPTIONS = {\n    'numeric'    : ['Passthrough', 'StandardScaler', 'MinMaxScaler',\n                    'RobustScaler', 'Log1p', 'Drop'],\n    'categorical': ['OneHotEncoder', 'LabelEncoder', 'OrdinalEncoder',\n                    'FrequencyEncoder', 'BinaryEncoder', 'Drop'],\n    'binary'     : ['Binary(0/1)', 'LabelEncoder', 'Drop'],\n    'datetime'   : ['Extraire composantes', 'Drop'],\n    'text'       : ['Garder brut', 'Drop'],\n    'id_like'    : ['Drop', 'Garder brut'],\n}\n\nENCODING_DESC = {\n    'OneHotEncoder'        : 'N colonnes binaires — ideal <= 15 modalites',\n    'LabelEncoder'         : 'Entiers 0..N-1 — ordre arbitraire',\n    'OrdinalEncoder'       : 'Entiers selon ordre detecte automatiquement',\n    'FrequencyEncoder'     : \"Remplace par la frequence d'apparition\",\n    'BinaryEncoder'        : 'Encodage binaire bit a bit — efficace > 15 modalites',\n    'Drop'                 : 'Supprime la colonne',\n    'Passthrough'          : 'Aucune transformation',\n    'StandardScaler'       : 'Centrage-reduction (mu=0, sigma=1)',\n    'MinMaxScaler'         : 'Normalisation dans [0, 1]',\n    'RobustScaler'         : 'Robuste aux outliers (base IQR)',\n    'Log1p'                : 'log(1+x) — pour distributions asymetriques',\n    'Binary(0/1)'          : 'Convertit True/False ou Yes/No en 0/1',\n    'Extraire composantes' : 'Extrait annee, mois, jour, jour_semaine',\n    'Garder brut'          : 'Conserve la colonne sans transformation',\n}\n\nKIND_COLOR = {\n    'numeric'    : '#bbdefb',\n    'categorical': '#c8e6c9',\n    'binary'     : '#ffe0b2',\n    'datetime'   : '#e1bee7',\n    'text'       : '#fce4ec',\n    'id_like'    : '#f0f0f0',\n}\n\n# Injection CSS globale — désactive le clipping imposé par ipywidgets\n_WIDGET_CSS = widgets.HTML(\"\"\"\n<style>\n  .encoder-outer .widget-vbox,\n  .encoder-outer .widget-hbox {\n      min-width: 0 !important;\n      overflow: visible !important;\n  }\n  .encoder-scroll-box {\n      overflow-x: auto !important;\n      overflow-y: auto !important;\n      display: block !important;\n  }\n</style>\n\"\"\")\n\n\n# ------------------------------------------------------------------\n# Application de l'encodage sur un DataFrame\n# ------------------------------------------------------------------\ndef apply_encoding(df: pd.DataFrame,\n                   selections: dict,\n                   col_meta: dict) -> tuple:\n    df_enc = df.copy()\n    report = []\n\n    for col, method in selections.items():\n        if col not in df_enc.columns:\n            continue\n        s = df_enc[col]\n\n        if method == 'Drop':\n            df_enc.drop(columns=[col], inplace=True)\n            report.append((col, method, '—'))\n\n        elif method in ('Passthrough', 'Garder brut'):\n            report.append((col, method, col))\n\n        elif method == 'OneHotEncoder':\n            dummies = pd.get_dummies(s, prefix=col,\n                                     drop_first=False, dtype=int)\n            df_enc.drop(columns=[col], inplace=True)\n            df_enc = pd.concat([df_enc, dummies], axis=1)\n            cols_str = ', '.join(dummies.columns[:4].tolist())\n            if len(dummies.columns) > 4:\n                cols_str += f' ... (+{len(dummies.columns)-4})'\n            report.append((col, method, cols_str))\n\n        elif method == 'LabelEncoder':\n            le = LabelEncoder()\n            df_enc[col] = le.fit_transform(s.astype(str))\n            report.append((col, method, col))\n\n        elif method == 'OrdinalEncoder':\n            cats = sorted(s.dropna().unique().tolist(), key=str)\n            oe = OrdinalEncoder(categories=[cats])\n            df_enc[col] = oe.fit_transform(\n                s.values.reshape(-1, 1)).astype(int)\n            report.append((col, method, col))\n\n        elif method == 'FrequencyEncoder':\n            freq = s.value_counts(normalize=True)\n            df_enc[col] = s.map(freq)\n            report.append((col, method, col))\n\n        elif method == 'BinaryEncoder':\n            le = LabelEncoder()\n            labels = le.fit_transform(s.astype(str))\n            n_bits = max(1, int(np.ceil(np.log2(s.nunique() + 1))))\n            for bit in range(n_bits):\n                df_enc[f\"{col}_b{bit}\"] = (labels >> bit) & 1\n            df_enc.drop(columns=[col], inplace=True)\n            report.append((col, method,\n                           f\"{col}_b0 ... {col}_b{n_bits-1}\"))\n\n        elif method == 'Binary(0/1)':\n            df_enc[col] = s.map(\n                lambda x: 1 if str(x).strip().lower()\n                in ('true', 'yes', 'oui', '1', 'y', 'vrai') else 0\n            )\n            report.append((col, method, col))\n\n        elif method == 'StandardScaler':\n            df_enc[col] = StandardScaler().fit_transform(\n                s.values.reshape(-1, 1)).flatten()\n            report.append((col, method, col))\n\n        elif method == 'MinMaxScaler':\n            df_enc[col] = MinMaxScaler().fit_transform(\n                s.values.reshape(-1, 1)).flatten()\n            report.append((col, method, col))\n\n        elif method == 'RobustScaler':\n            df_enc[col] = RobustScaler().fit_transform(\n                s.values.reshape(-1, 1)).flatten()\n            report.append((col, method, col))\n\n        elif method == 'Log1p':\n            df_enc[col] = np.log1p(s.clip(lower=0))\n            report.append((col, method, col))\n\n        elif method == 'Extraire composantes':\n            s_dt = pd.to_datetime(s, errors='coerce')\n            df_enc[f\"{col}_annee\"]        = s_dt.dt.year\n            df_enc[f\"{col}_mois\"]         = s_dt.dt.month\n            df_enc[f\"{col}_jour\"]         = s_dt.dt.day\n            df_enc[f\"{col}_jour_semaine\"] = s_dt.dt.weekday\n            df_enc.drop(columns=[col], inplace=True)\n            report.append((col, method,\n                           f\"{col}_annee / _mois / _jour / _jour_semaine\"))\n\n    return df_enc, report\n\n\n# ------------------------------------------------------------------\n# Widget d'encodage pour UN dataset\n# ------------------------------------------------------------------\nclass _SingleEncoderWidget:\n\n    def __init__(self, label: str, df: pd.DataFrame, col_meta: dict,\n                 on_apply_callback=None):\n        self.label      = label\n        self.df         = df\n        self.col_meta   = col_meta\n        self.selections = {col: ENCODING_OPTIONS.get(m['kind'],\n                           ['Passthrough'])[0]\n                           for col, m in col_meta.items()}\n        self._callback  = on_apply_callback\n        self.df_encoded = None\n        self.out        = widgets.Output()\n        self.widget     = self._build()\n\n    def _build(self):\n        rows           = []\n        self._dds      = {}\n        self._tooltips = {}\n\n        # En-tête rendu en HTML pur — hors du système de layout ipywidgets\n        header_html = widgets.HTML(\n            \"<div style='\"\n            \"display:flex;gap:10px;font-weight:bold;font-size:.82em;\"\n            \"color:#555;padding:4px 10px;border-bottom:2px solid #ddd;\"\n            \"margin-bottom:4px;min-width:1050px;box-sizing:border-box'>\"\n            \"<span style='min-width:300px;flex-shrink:0;white-space:nowrap'>\"\n            \"Colonne</span>\"\n            \"<span style='min-width:100px;flex-shrink:0'>Type</span>\"\n            \"<span style='min-width:55px;flex-shrink:0'>Manq.</span>\"\n            \"<span style='min-width:210px;flex-shrink:0'>Méthode</span>\"\n            \"<span style='flex:1;min-width:180px'>Description</span>\"\n            \"</div>\"\n        )\n\n        for col, meta in self.col_meta.items():\n            kind    = meta['kind']\n            options = ENCODING_OPTIONS.get(kind, ['Passthrough', 'Drop'])\n            default = options[0]\n\n            dd = widgets.Dropdown(\n                options=options, value=default,\n                layout=widgets.Layout(width='210px', flex_shrink='0')\n            )\n            self._dds[col] = dd\n\n            tip = widgets.HTML(\n                value=self._tip_html(default),\n                layout=widgets.Layout(min_width='200px', flex='1')\n            )\n            self._tooltips[col] = tip\n\n            def _make_obs(c, t):\n                def obs(change):\n                    t.value = self._tip_html(change['new'])\n                    self.selections[c] = change['new']\n                return obs\n            dd.observe(_make_obs(col, tip), names='value')\n\n            bg_col = KIND_COLOR.get(kind, '#eee')\n            badge = widgets.HTML(\n                f\"<div style='background:{bg_col};border-radius:4px;\"\n                f\"padding:2px 8px;font-size:.78em;text-align:center;\"\n                f\"min-width:90px;flex-shrink:0'>{kind}</div>\"\n            )\n\n            pct = meta['pct_miss']\n            miss_color = ('#c62828' if pct > 20\n                          else '#e65100' if pct > 5\n                          else '#2e7d32')\n            miss_w = widgets.HTML(\n                f\"<span style='color:{miss_color};font-size:.82em;\"\n                f\"min-width:55px;flex-shrink:0;\"\n                f\"display:inline-block'>{pct:.1f}%</span>\"\n            )\n\n            # Nom de colonne — rendu HTML pur, nowrap strict\n            col_lbl = widgets.HTML(\n                f\"<div style='min-width:300px;max-width:none;flex-shrink:0;\"\n                f\"white-space:nowrap;overflow:visible;box-sizing:border-box'>\"\n                f\"<b style='font-family:monospace;font-size:.88em;\"\n                f\"white-space:nowrap'>{col}</b><br>\"\n                f\"<span style='font-size:.73em;color:#777;white-space:nowrap'>\"\n                f\"nunique={meta['n_unique']} | {meta['dtype']}</span></div>\"\n            )\n\n            row = widgets.HBox(\n                [col_lbl, badge, miss_w, dd, tip],\n                layout=widgets.Layout(\n                    align_items='center',\n                    gap='10px',\n                    padding='5px 10px',\n                    border='1px solid #e8e8e8',\n                    border_radius='5px',\n                    margin='2px 0',\n                    min_width='1050px',\n                    flex_wrap='nowrap',\n                    overflow='visible',\n                )\n            )\n            rows.append(row)\n\n        btn_apply = widgets.Button(\n            description=\"Appliquer l'encodage\",\n            button_style='success',\n            layout=widgets.Layout(width='230px', height='36px')\n        )\n        btn_reset = widgets.Button(\n            description='Reinitialiser',\n            button_style='warning',\n            layout=widgets.Layout(width='160px', height='36px')\n        )\n        btn_preview = widgets.Button(\n            description='Apercu rapide',\n            button_style='info',\n            layout=widgets.Layout(width='160px', height='36px')\n        )\n        btn_apply.on_click(self._on_apply)\n        btn_reset.on_click(self._on_reset)\n        btn_preview.on_click(self._on_preview)\n\n        # Conteneur interne scrollable\n        rows_box = widgets.VBox(\n            rows,\n            layout=widgets.Layout(\n                min_width='1050px',\n                overflow_x='auto',\n                overflow_y='auto',\n                max_height='500px',\n            )\n        )\n\n        # Wrapper HTML pour forcer le scroll horizontal au niveau du DOM\n        scroll_box = widgets.Box(\n            [header_html, rows_box],\n            layout=widgets.Layout(\n                overflow_x='auto',\n                overflow_y='visible',\n                width='100%',\n                display='block',\n            )\n        )\n\n        return widgets.VBox(\n            [_WIDGET_CSS,\n             scroll_box,\n             widgets.HBox([btn_apply, btn_preview, btn_reset],\n                          layout=widgets.Layout(margin='10px 0', gap='8px')),\n             self.out],\n            layout=widgets.Layout(width='100%', overflow_x='auto')\n        )\n\n    @staticmethod\n    def _tip_html(method):\n        desc = ENCODING_DESC.get(method, '')\n        return (f\"<span style='font-size:.78em;color:#555;\"\n                f\"font-style:italic'>{desc}</span>\")\n\n    def _on_reset(self, _):\n        for col, dd in self._dds.items():\n            kind = self.col_meta[col]['kind']\n            dd.value = ENCODING_OPTIONS.get(kind, ['Passthrough'])[0]\n\n    def _on_preview(self, _):\n        with self.out:\n            clear_output()\n            summary = [(col, meth)\n                       for col, meth in self.selections.items()\n                       if meth != 'Passthrough']\n            if not summary:\n                print(\"Toutes les colonnes sont en Passthrough.\")\n                return\n            df_prev = pd.DataFrame(summary,\n                                   columns=['Colonne', 'Methode choisie'])\n            display(HTML(\"<b>Methodes selectionnees (hors Passthrough) :</b>\"))\n            display(df_prev.set_index('Colonne'))\n\n    def _on_apply(self, _):\n        with self.out:\n            clear_output()\n            try:\n                df_enc, report = apply_encoding(\n                    self.df, self.selections, self.col_meta)\n                self.df_encoded = df_enc\n\n                rdf = pd.DataFrame(\n                    report,\n                    columns=['Colonne originale',\n                             'Methode', 'Colonne(s) resultante(s)']\n                )\n                display(HTML(\n                    \"<div style='background:#d4edda;\"\n                    \"border-left:4px solid #28a745;\"\n                    \"padding:10px 14px;border-radius:4px;margin-bottom:8px'>\"\n                    f\"<b>Encodage applique — [{self.label}]</b><br>\"\n                    f\"Shape avant : {self.df.shape}  ->  \"\n                    f\"apres : {df_enc.shape}\"\n                    \"</div>\"))\n                display(rdf.style.set_properties(\n                    **{'font-size': '.85em', 'text-align': 'left'}))\n\n                if self._callback:\n                    self._callback(self.label, df_enc)\n\n            except Exception as e:\n                import traceback\n                display(HTML(\n                    f\"<div style='background:#f8d7da;\"\n                    \"border-left:4px solid #dc3545;\"\n                    f\"padding:10px;border-radius:4px'>Erreur : {e}</div>\"))\n                traceback.print_exc()\n\n\n# ------------------------------------------------------------------\n# EncodingManager — gere un ou plusieurs datasets\n# ------------------------------------------------------------------\nclass EncodingManager:\n    \"\"\"\n    Interface d'encodage interactif pour un ou plusieurs datasets.\n\n    Usage :\n        encoder = EncodingManager(loader.get_all(), explorer.meta)\n        encoder.show()\n\n        # Apres encodage :\n        df_enc      = encoder.get('Train')\n        all_encoded = encoder.get_all()\n    \"\"\"\n\n    def __init__(self, datasets: dict, meta: dict):\n        if isinstance(datasets, pd.DataFrame):\n            datasets = {'Donnees': datasets}\n        self.datasets  = datasets\n        self.meta      = meta\n        self._encoded  = {}\n        self._widgets  = {}\n\n    def _on_encoded(self, label, df_enc):\n        self._encoded[label] = df_enc\n\n    def show(self):\n        display(HTML(\n            \"<h3 style='margin:0 0 4px'>Encodage des Variables</h3>\"\n            \"<p style='color:#555;font-size:.88em;margin:0 0 12px'>\"\n            \"Les types sont auto-detectes. Modifiez colonne par colonne \"\n            \"si necessaire, puis cliquez sur <b>Appliquer l'encodage</b>.\"\n            \"</p>\"\n        ))\n\n        legend_parts = ''.join(\n            f\"<span style='background:{bg};padding:2px 8px;\"\n            f\"border-radius:3px;font-size:.8em'>{kind}</span>\"\n            for kind, bg in KIND_COLOR.items()\n        )\n        display(HTML(\n            f\"<div style='display:flex;gap:8px;flex-wrap:wrap;\"\n            f\"margin-bottom:12px;align-items:center'>\"\n            f\"<b style='font-size:.85em'>Legende :</b> {legend_parts}</div>\"\n        ))\n\n        if len(self.datasets) == 1:\n            label    = next(iter(self.datasets))\n            df       = self.datasets[label]\n            col_meta = self.meta.get(label, {})\n            w = _SingleEncoderWidget(label, df, col_meta,\n                                     on_apply_callback=self._on_encoded)\n            self._widgets[label] = w\n            display(w.widget)\n\n        else:\n            tab_children = []\n            tab_labels   = []\n            for label, df in self.datasets.items():\n                col_meta = self.meta.get(label, {})\n                w = _SingleEncoderWidget(label, df, col_meta,\n                                         on_apply_callback=self._on_encoded)\n                self._widgets[label] = w\n                out = widgets.Output()\n                with out:\n                    display(w.widget)\n                tab_children.append(out)\n                tab_labels.append(label)\n\n            tab = widgets.Tab(children=tab_children)\n            for i, lbl in enumerate(tab_labels):\n                tab.set_title(i, lbl)\n            display(tab)\n\n            btn_all = widgets.Button(\n                description='Appliquer tous les encodages',\n                button_style='primary',\n                layout=widgets.Layout(width='280px', height='38px',\n                                      margin='12px 0')\n            )\n            out_all = widgets.Output()\n\n            def _apply_all(_):\n                with out_all:\n                    clear_output()\n                    for lbl, w in self._widgets.items():\n                        w._on_apply(None)\n                    print(\"\\nTous les encodages appliques.\")\n                    print(\"Utilisez encoder.get_all() pour recuperer les DataFrames.\")\n\n            btn_all.on_click(_apply_all)\n            display(btn_all)\n            display(out_all)\n\n    # ------------------------------------------------------------------\n    # Accesseurs\n    # ------------------------------------------------------------------\n    def get(self, label: str = None) -> pd.DataFrame:\n        \"\"\"Retourne le DataFrame encode pour un label donne.\n        Si label=None, retourne le premier.\"\"\"\n        if not self._encoded:\n            print(\"Aucun encodage applique. Cliquez sur 'Appliquer l'encodage'.\")\n            return None\n        if label is None:\n            return next(iter(self._encoded.values()))\n        return self._encoded.get(label)\n\n    def get_all(self) -> dict:\n        \"\"\"Retourne tous les DataFrames encodes : {label: DataFrame}.\"\"\"\n        return self._encoded\n\n\n# ── Lancement ─────────────────────────────────────────────────────────\ndatasets = loader.get_all()\nmeta     = explorer.meta\n\nif datasets and meta:\n    encoder = EncodingManager(datasets, meta)\n    encoder.show()\nelse:\n    print(\"Executez d'abord les cellules 1 et 2.\")\n\n# ── Recuperation apres encodage ───────────────────────────────────────\n# Fichier unique :\n#   df_enc = encoder.get()\n#\n# Multi-fichiers :\n#   all_enc  = encoder.get_all()\n#   df_train = encoder.get('Train')\n#   df_test  = encoder.get('Test')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-30T10:01:42.621487Z","iopub.execute_input":"2026-04-30T10:01:42.621824Z","iopub.status.idle":"2026-04-30T10:01:43.181569Z","shell.execute_reply.started":"2026-04-30T10:01:42.621796Z","shell.execute_reply":"2026-04-30T10:01:43.178760Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"<h3 style='margin:0 0 4px'>Encodage des Variables</h3><p style='color:#555;font-size:.88em;margin:0 0 12px'>Les types sont auto-detectes. Modifiez colonne par colonne si necessaire, puis cliquez sur <b>Appliquer l'encodage</b>.</p>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"<div style='display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;align-items:center'><b style='font-size:.85em'>Legende :</b> <span style='background:#bbdefb;padding:2px 8px;border-radius:3px;font-size:.8em'>numeric</span><span style='background:#c8e6c9;padding:2px 8px;border-radius:3px;font-size:.8em'>categorical</span><span style='background:#ffe0b2;padding:2px 8px;border-radius:3px;font-size:.8em'>binary</span><span style='background:#e1bee7;padding:2px 8px;border-radius:3px;font-size:.8em'>datetime</span><span style='background:#fce4ec;padding:2px 8px;border-radius:3px;font-size:.8em'>text</span><span style='background:#f0f0f0;padding:2px 8px;border-radius:3px;font-size:.8em'>id_like</span></div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Tab(children=(Output(), Output()), selected_index=0, titles=('Train', 'Test'))","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"9c68c9bad32d48c2b0f5c6ab95dcdba5"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Button(button_style='primary', description='Appliquer tous les encodages', layout=Layout(height='38px', margin…","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"9037b0db46f94904ba82ccabd96e7e23"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Output()","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"1dd3f49bc49046839730808bdaef0c6b"}},"metadata":{}}],"execution_count":21},{"cell_type":"code","source":"# ============================================================\n# CELLULE 4 — EDA AVANCE\n# Analyses univariees, bivariees, multivariees\n# Visualisations interactives par onglets\n# Compatible mode simple et multi-fichiers\n# ============================================================\n\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport matplotlib.patches as mpatches\nimport matplotlib.gridspec as gridspec\nimport seaborn as sns\nfrom scipy import stats\nfrom scipy.stats import chi2_contingency, f_oneway, kruskal, shapiro, kstest\nfrom IPython.display import display, HTML, clear_output\nimport ipywidgets as widgets\nimport warnings\nwarnings.filterwarnings('ignore')\n\nsns.set_style('whitegrid')\nsns.set_palette('muted')\nPALETTE    = sns.color_palette('muted')\nPALETTE_D  = sns.color_palette('deep')\n\n\n# ══════════════════════════════════════════════════════════════\n# Utilitaires partagés\n# ══════════════════════════════════════════════════════════════\n\ndef _num_cols(df, col_meta):\n    return [c for c, m in col_meta.items()\n            if m['kind'] in ('numeric', 'binary') and c in df.columns]\n\ndef _cat_cols(df, col_meta):\n    return [c for c, m in col_meta.items()\n            if m['kind'] in ('categorical', 'binary') and c in df.columns]\n\ndef _make_grid(n, ncols=4, w=5, h=3.8):\n    nc = min(ncols, n)\n    nr = (n + nc - 1) // nc\n    fig, axes = plt.subplots(nr, nc, figsize=(w * nc, h * nr))\n    axes = np.array(axes).flatten()\n    for j in range(n, len(axes)):\n        axes[j].set_visible(False)\n    return fig, axes\n\ndef _section(title):\n    display(HTML(\n        f\"<div style='background:#f5f5f5;border-left:4px solid #1565c0;\"\n        f\"padding:8px 14px;border-radius:0 4px 4px 0;margin:18px 0 10px'>\"\n        f\"<b style='font-size:1em;color:#1565c0'>{title}</b></div>\"\n    ))\n\ndef _stat_badge(label, value, color='#1565c0', bg='#e3f2fd'):\n    return (f\"<div style='background:{bg};border-radius:6px;\"\n            f\"padding:8px 14px;text-align:center;min-width:110px'>\"\n            f\"<div style='font-size:1.3em;font-weight:700;color:{color}'>{value}</div>\"\n            f\"<div style='font-size:.78em;color:#555;margin-top:2px'>{label}</div></div>\")\n\n\n# ══════════════════════════════════════════════════════════════\n# MODULE 1 — Analyse univariee\n# ══════════════════════════════════════════════════════════════\n\nclass UnivariateAnalysis:\n\n    def __init__(self, df, col_meta):\n        self.df       = df\n        self.col_meta = col_meta\n\n    def show(self):\n        _section(\"1.1  Distribution des variables numeriques\")\n        self._numeric_distributions()\n\n        _section(\"1.2  Tests de normalite\")\n        self._normality_tests()\n\n        _section(\"1.3  Boites a moustaches — detection d'outliers\")\n        self._boxplots()\n\n        _section(\"1.4  Distribution des variables categorielles\")\n        self._categorical_distributions()\n\n        _section(\"1.5  Analyse des variables binaires\")\n        self._binary_analysis()\n\n    # ── 1.1 distributions numériques enrichies ──────────────\n    def _numeric_distributions(self):\n        cols = _num_cols(self.df, self.col_meta)\n        cols = [c for c in cols if self.col_meta[c]['kind'] == 'numeric']\n        if not cols:\n            print(\"Aucune variable numerique.\")\n            return\n\n        fig, axes = _make_grid(len(cols))\n        for i, col in enumerate(cols):\n            ax  = axes[i]\n            dat = self.df[col].dropna()\n\n            # histogramme + KDE\n            ax.hist(dat, bins='auto', color=PALETTE[i % len(PALETTE)],\n                    alpha=.65, edgecolor='white', density=True, linewidth=.4)\n            dat.plot.kde(ax=ax, color='#1a237e', linewidth=1.6)\n\n            # ligne mediane et moyenne\n            ax.axvline(dat.mean(),   color='#e53935', linestyle='--',\n                       linewidth=1.2, label=f'Moy={dat.mean():.2f}')\n            ax.axvline(dat.median(), color='#43a047', linestyle=':',\n                       linewidth=1.2, label=f'Med={dat.median():.2f}')\n\n            sk = dat.skew()\n            ku = dat.kurt()\n            ax.set_title(col, fontsize=9, fontweight='bold')\n            ax.set_xlabel('')\n            ax.legend(fontsize=6.5, loc='upper right')\n            ax.text(.02, .97, f'Skew={sk:.2f}\\nKurt={ku:.2f}',\n                    transform=ax.transAxes, fontsize=7,\n                    va='top', color='#555',\n                    bbox=dict(boxstyle='round,pad=.3', fc='white', alpha=.7))\n\n        plt.suptitle('Distributions — Variables numeriques',\n                     fontsize=12, fontweight='bold', y=1.01)\n        plt.tight_layout()\n        plt.show()\n\n    # ── 1.2 tests de normalité ───────────────────────────────\n    def _normality_tests(self):\n        cols = [c for c in _num_cols(self.df, self.col_meta)\n                if self.col_meta[c]['kind'] == 'numeric']\n        if not cols:\n            return\n\n        rows = []\n        for col in cols:\n            dat = self.df[col].dropna()\n            n   = len(dat)\n            # Shapiro-Wilk si n <= 5000, KS sinon\n            if n <= 5000:\n                stat, p = shapiro(dat)\n                test = 'Shapiro-Wilk'\n            else:\n                stat, p = kstest(dat, 'norm',\n                                 args=(dat.mean(), dat.std()))\n                test = 'KS (norm)'\n\n            rows.append({\n                'Colonne'   : col,\n                'Test'      : test,\n                'n'         : n,\n                'Statistique': f'{stat:.4f}',\n                'p-value'   : f'{p:.4f}',\n                'Normale ?'  : 'Oui (p>.05)' if p > .05 else 'Non (p<=.05)',\n                'Skewness'  : f'{self.df[col].skew():.3f}',\n                'Kurtosis'  : f'{self.df[col].kurt():.3f}',\n            })\n\n        df_r = pd.DataFrame(rows).set_index('Colonne')\n\n        def color_normal(val):\n            if 'Oui' in str(val):  return 'background-color:#d4edda;color:#155724'\n            if 'Non' in str(val):  return 'background-color:#f8d7da;color:#721c24'\n            return ''\n\n        display(df_r.style.applymap(color_normal, subset=['Normale ?']))\n\n        # QQ-plots\n        fig, axes = _make_grid(len(cols), ncols=4, h=3.5)\n        for i, col in enumerate(cols):\n            dat = self.df[col].dropna()\n            stats.probplot(dat, dist='norm', plot=axes[i])\n            axes[i].set_title(col, fontsize=9, fontweight='bold')\n            axes[i].get_lines()[0].set(markersize=2, alpha=.5,\n                                       color=PALETTE[i % len(PALETTE)])\n            axes[i].get_lines()[1].set(color='#e53935', linewidth=1.2)\n        plt.suptitle('QQ-Plots (normalite)', fontsize=12,\n                     fontweight='bold', y=1.01)\n        plt.tight_layout()\n        plt.show()\n\n    # ── 1.3 boxplots ─────────────────────────────────────────\n    def _boxplots(self):\n        cols = [c for c in _num_cols(self.df, self.col_meta)\n                if self.col_meta[c]['kind'] == 'numeric']\n        if not cols:\n            return\n\n        fig, axes = _make_grid(len(cols), ncols=4, h=3.2)\n        outlier_report = []\n\n        for i, col in enumerate(cols):\n            ax  = axes[i]\n            dat = self.df[col].dropna()\n            q1, q3 = dat.quantile(.25), dat.quantile(.75)\n            iqr    = q3 - q1\n            lo, hi = q1 - 1.5 * iqr, q3 + 1.5 * iqr\n            n_out  = int(((dat < lo) | (dat > hi)).sum())\n\n            bp = ax.boxplot(dat, patch_artist=True, vert=True,\n                            widths=.5,\n                            medianprops=dict(color='#e53935', linewidth=2),\n                            boxprops=dict(facecolor=PALETTE[i % len(PALETTE)],\n                                          alpha=.6),\n                            flierprops=dict(marker='o', markersize=3,\n                                            color='#e53935', alpha=.5))\n            ax.set_title(col, fontsize=9, fontweight='bold')\n            ax.set_xlabel('')\n            ax.text(.98, .97, f'Outliers: {n_out}',\n                    transform=ax.transAxes, fontsize=7.5,\n                    ha='right', va='top',\n                    color='#e53935' if n_out > 0 else '#2e7d32',\n                    bbox=dict(boxstyle='round,pad=.3', fc='white', alpha=.8))\n            outlier_report.append({\n                'Colonne'    : col,\n                'Q1'         : f'{q1:.3f}',\n                'Q3'         : f'{q3:.3f}',\n                'IQR'        : f'{iqr:.3f}',\n                'Borne basse': f'{lo:.3f}',\n                'Borne haute': f'{hi:.3f}',\n                'Nb outliers': n_out,\n                '% outliers' : f'{n_out/len(dat)*100:.1f}%',\n            })\n\n        plt.suptitle('Boxplots + outliers (methode IQR)',\n                     fontsize=12, fontweight='bold', y=1.01)\n        plt.tight_layout()\n        plt.show()\n\n        df_out = pd.DataFrame(outlier_report).set_index('Colonne')\n        def color_out(val):\n            try:\n                n = int(val)\n                if n == 0:  return 'color:#2e7d32'\n                if n < 10:  return 'color:#e65100'\n                return 'color:#c62828;font-weight:bold'\n            except:\n                return ''\n        display(df_out.style.applymap(color_out, subset=['Nb outliers']))\n\n    # ── 1.4 catégorielles ────────────────────────────────────\n    def _categorical_distributions(self):\n        cols = [c for c in _cat_cols(self.df, self.col_meta)\n                if self.col_meta[c]['kind'] == 'categorical'][:10]\n        if not cols:\n            print(\"Aucune variable categorielle.\")\n            return\n\n        fig, axes = _make_grid(len(cols), ncols=3, w=5.5, h=4)\n        for i, col in enumerate(cols):\n            ax  = axes[i]\n            vc  = self.df[col].value_counts().head(15)\n            colors = sns.color_palette('viridis', len(vc))\n            bars = ax.barh(vc.index.astype(str)[::-1],\n                           vc.values[::-1], color=colors[::-1])\n            # annotations\n            for bar, val in zip(bars, vc.values[::-1]):\n                ax.text(bar.get_width() + .5, bar.get_y() + bar.get_height()/2,\n                        f'{val:,}', va='center', fontsize=7)\n            ax.set_title(col, fontsize=9, fontweight='bold')\n            ax.set_xlabel('Frequence')\n        plt.suptitle('Distributions — Variables categorielles (top 15)',\n                     fontsize=12, fontweight='bold', y=1.01)\n        plt.tight_layout()\n        plt.show()\n\n        # Pie charts pour les colonnes <= 8 modalités\n        pie_cols = [c for c in cols if self.df[c].nunique() <= 8]\n        if pie_cols:\n            fig, axes = _make_grid(len(pie_cols), ncols=4, h=3.5)\n            for i, col in enumerate(pie_cols):\n                vc = self.df[col].value_counts().head(8)\n                axes[i].pie(vc.values, labels=vc.index.astype(str),\n                            autopct='%1.1f%%', startangle=90,\n                            colors=sns.color_palette('pastel', len(vc)),\n                            wedgeprops=dict(edgecolor='white', linewidth=1.5))\n                axes[i].set_title(col, fontsize=9, fontweight='bold')\n            plt.suptitle('Repartition proportionnelle (cat. <= 8 modalites)',\n                         fontsize=12, fontweight='bold', y=1.01)\n            plt.tight_layout()\n            plt.show()\n\n    # ── 1.5 binaires ─────────────────────────────────────────\n    def _binary_analysis(self):\n        cols = [c for c in self.col_meta\n                if self.col_meta[c]['kind'] == 'binary' and c in self.df.columns]\n        if not cols:\n            return\n\n        rows = []\n        for col in cols:\n            vc = self.df[col].value_counts(normalize=True)\n            rows.append({\n                'Colonne'    : col,\n                'Valeur 0/A' : vc.index[0] if len(vc) > 0 else '-',\n                '%'          : f'{vc.iloc[0]*100:.1f}%' if len(vc) > 0 else '-',\n                'Valeur 1/B' : vc.index[1] if len(vc) > 1 else '-',\n                '% '         : f'{vc.iloc[1]*100:.1f}%' if len(vc) > 1 else '-',\n                'Desequilibre': 'Oui' if len(vc) > 1 and max(vc.iloc[:2]) > .8 else 'Non',\n            })\n        df_b = pd.DataFrame(rows).set_index('Colonne')\n\n        def color_imb(val):\n            return ('background-color:#f8d7da' if val == 'Oui'\n                    else 'background-color:#d4edda')\n        display(df_b.style.applymap(color_imb, subset=['Desequilibre']))\n\n\n# ══════════════════════════════════════════════════════════════\n# MODULE 2 — Analyse bivariée\n# ══════════════════════════════════════════════════════════════\n\nclass BivariateAnalysis:\n\n    def __init__(self, df, col_meta):\n        self.df       = df\n        self.col_meta = col_meta\n        self._num     = [c for c in _num_cols(df, col_meta)\n                         if col_meta[c]['kind'] == 'numeric']\n        self._cat     = [c for c in _cat_cols(df, col_meta)\n                         if col_meta[c]['kind'] == 'categorical']\n        self._target  = None\n        self._out     = widgets.Output()\n\n    def show(self):\n        _section(\"2.0  Selection de la variable cible (optionnel)\")\n        self._target_selector()\n\n        _section(\"2.1  Matrice de correlation (numeriques)\")\n        self._correlation_matrix()\n\n        _section(\"2.2  Pairplot — relations deux a deux\")\n        self._pairplot()\n\n        _section(\"2.3  Analyse categorielle x categorielle (Cramer V)\")\n        self._cat_cat()\n\n        _section(\"2.4  Analyse numerique x categorielle\")\n        self._num_cat_interactive()\n\n        _section(\"2.5  Scatterplot interactif\")\n        self._scatter_interactive()\n\n        display(self._out)\n\n    # ── Sélecteur de target ──────────────────────────────────\n    def _target_selector(self):\n        all_cols = list(self.df.columns)\n        dd = widgets.Dropdown(\n            options=['(aucune)'] + all_cols,\n            value='(aucune)',\n            description='Cible :',\n            style={'description_width': '50px'},\n            layout=widgets.Layout(width='300px')\n        )\n        info = widgets.HTML('')\n\n        def on_change(change):\n            self._target = None if change['new'] == '(aucune)' else change['new']\n            kind = self.col_meta.get(self._target, {}).get('kind', '?') \\\n                   if self._target else ''\n            info.value = (f\"<span style='font-size:.85em;color:#555'>\"\n                          f\"Type detecte : <b>{kind}</b></span>\"\n                          if self._target else '')\n        dd.observe(on_change, names='value')\n        display(widgets.HBox([dd, info]))\n\n    # ── 2.1 Heatmap corrélation ──────────────────────────────\n    def _correlation_matrix(self):\n        if len(self._num) < 2:\n            print(\"Moins de 2 variables numeriques.\")\n            return\n\n        corr = self.df[self._num].corr()\n        size = max(7, min(18, len(self._num) * 0.9 + 2))\n        fig, ax = plt.subplots(figsize=(size, size * .78))\n        mask = np.triu(np.ones_like(corr, dtype=bool), k=1)\n\n        # Heatmap triangulaire basse\n        sns.heatmap(corr, mask=mask, annot=len(self._num) <= 25,\n                    fmt='.2f', cmap='coolwarm', center=0, vmin=-1, vmax=1,\n                    linewidths=.3, ax=ax,\n                    annot_kws={'size': max(5, 9 - len(self._num)//5)},\n                    square=True)\n        ax.set_title('Matrice de correlation de Pearson',\n                     fontsize=12, fontweight='bold', pad=12)\n        plt.tight_layout()\n        plt.show()\n\n        # Paires fortement corrélées\n        pairs = []\n        for i in range(len(corr)):\n            for j in range(i):\n                r = corr.iloc[i, j]\n                if abs(r) > .6:\n                    pairs.append({\n                        'Variable A'  : corr.index[i],\n                        'Variable B'  : corr.columns[j],\n                        'Pearson r'   : f'{r:.3f}',\n                        'Force'       : ('Tres forte' if abs(r) > .9\n                                         else 'Forte' if abs(r) > .75\n                                         else 'Moderee'),\n                        'Sens'        : 'Positif' if r > 0 else 'Negatif',\n                    })\n        if pairs:\n            display(HTML(\"<b>Paires fortement correlees (|r| > 0.6) :</b>\"))\n            df_pairs = pd.DataFrame(pairs)\n            def color_r(val):\n                try:\n                    v = float(val)\n                    if abs(v) > .9: return 'background-color:#f8d7da'\n                    if abs(v) > .75: return 'background-color:#fff3cd'\n                    return 'background-color:#fff8e1'\n                except: return ''\n            display(df_pairs.style.applymap(color_r, subset=['Pearson r']))\n\n    # ── 2.2 Pairplot ─────────────────────────────────────────\n    def _pairplot(self):\n        cols = self._num[:6]   # max 6 pour lisibilite\n        if len(cols) < 2:\n            print(\"Moins de 2 variables numeriques pour le pairplot.\")\n            return\n\n        hue = self._target if (self._target and\n              self._target in self.df.columns and\n              self.df[self._target].nunique() <= 10) else None\n\n        g = sns.pairplot(self.df[cols + ([hue] if hue else [])].dropna(),\n                         hue=hue,\n                         diag_kind='kde',\n                         plot_kws=dict(alpha=.45, s=18, edgecolor='none'),\n                         diag_kws=dict(fill=True, alpha=.5),\n                         palette='muted')\n        g.fig.suptitle(f'Pairplot{\"  (couleur : \" + hue + \")\" if hue else \"\"}',\n                       y=1.01, fontsize=12, fontweight='bold')\n        plt.tight_layout()\n        plt.show()\n\n    # ── 2.3 Cat x Cat : Cramer's V ───────────────────────────\n    def _cat_cat(self):\n        cols = self._cat[:12]\n        if len(cols) < 2:\n            print(\"Moins de 2 variables categorielles.\")\n            return\n\n        def cramers_v(x, y):\n            ct  = pd.crosstab(x, y)\n            chi2 = chi2_contingency(ct, correction=False)[0]\n            n    = len(x.dropna())\n            k, r = ct.shape\n            return np.sqrt(chi2 / (n * (min(k, r) - 1) + 1e-9))\n\n        mat = pd.DataFrame(np.zeros((len(cols), len(cols))),\n                           index=cols, columns=cols)\n        for i, c1 in enumerate(cols):\n            for j, c2 in enumerate(cols):\n                if i == j:\n                    mat.loc[c1, c2] = 1.0\n                elif i < j:\n                    v = cramers_v(self.df[c1], self.df[c2])\n                    mat.loc[c1, c2] = v\n                    mat.loc[c2, c1] = v\n\n        size = max(6, len(cols) * .9 + 1)\n        fig, ax = plt.subplots(figsize=(size, size * .8))\n        mask = np.triu(np.ones_like(mat, dtype=bool), k=1)\n        sns.heatmap(mat.astype(float), mask=mask,\n                    annot=True, fmt='.2f',\n                    cmap='YlOrRd', vmin=0, vmax=1,\n                    linewidths=.3, ax=ax, square=True,\n                    annot_kws={'size': max(6, 9 - len(cols)//4)})\n        ax.set_title(\"Cramer's V — association entre variables categorielles\",\n                     fontsize=11, fontweight='bold', pad=10)\n        plt.tight_layout()\n        plt.show()\n\n    # ── 2.4 Num x Cat — interactif ───────────────────────────\n    def _num_cat_interactive(self):\n        if not self._num or not self._cat:\n            print(\"Il faut au moins une variable numerique ET une categorielle.\")\n            return\n\n        dd_num = widgets.Dropdown(\n            options=self._num,\n            description='Numerique :',\n            style={'description_width': '95px'},\n            layout=widgets.Layout(width='280px')\n        )\n        dd_cat = widgets.Dropdown(\n            options=self._cat,\n            description='Categorielle :',\n            style={'description_width': '95px'},\n            layout=widgets.Layout(width='280px')\n        )\n        dd_plot = widgets.Dropdown(\n            options=['Violin', 'Box', 'Strip + Box', 'Barre (moyenne)', 'KDE par groupe'],\n            description='Graphique :',\n            style={'description_width': '95px'},\n            layout=widgets.Layout(width='280px')\n        )\n        btn = widgets.Button(description='Tracer', button_style='primary',\n                             layout=widgets.Layout(width='100px'))\n        out = widgets.Output()\n\n        def _plot(_):\n            with out:\n                clear_output(wait=True)\n                num = dd_num.value\n                cat = dd_cat.value\n                plot_type = dd_plot.value\n\n                sub = self.df[[num, cat]].dropna()\n                groups = [g[num].values for _, g in sub.groupby(cat)]\n                cats   = sub[cat].unique()\n                n_cats = sub[cat].nunique()\n\n                fig, axes = plt.subplots(1, 1, figsize=(max(8, n_cats*.9+3), 5))\n\n                if plot_type == 'Violin':\n                    sns.violinplot(data=sub, x=cat, y=num, ax=axes,\n                                   palette='muted', inner='quartile',\n                                   cut=0)\n                elif plot_type == 'Box':\n                    sns.boxplot(data=sub, x=cat, y=num, ax=axes,\n                                palette='muted', width=.5,\n                                flierprops=dict(marker='o', markersize=3,\n                                                color='#e53935', alpha=.5))\n                elif plot_type == 'Strip + Box':\n                    sns.boxplot(data=sub, x=cat, y=num, ax=axes,\n                                palette='muted', width=.45,\n                                flierprops=dict(alpha=0))\n                    sns.stripplot(data=sub, x=cat, y=num, ax=axes,\n                                  color='#1a237e', alpha=.25, size=3,\n                                  jitter=True)\n                elif plot_type == 'Barre (moyenne)':\n                    means = sub.groupby(cat)[num].mean()\n                    errs  = sub.groupby(cat)[num].sem()\n                    colors = sns.color_palette('muted', len(means))\n                    axes.bar(means.index.astype(str), means.values,\n                             yerr=errs.values, capsize=4,\n                             color=colors, edgecolor='white', linewidth=.5)\n                    axes.set_ylabel(f'Moyenne de {num}')\n                elif plot_type == 'KDE par groupe':\n                    cats_list = sub[cat].unique()\n                    pal = sns.color_palette('Set2', len(cats_list))\n                    for c_val, col in zip(cats_list, pal):\n                        d = sub[sub[cat] == c_val][num]\n                        if len(d) > 1:\n                            d.plot.kde(ax=axes, label=str(c_val),\n                                       color=col, linewidth=1.8)\n                    axes.legend(fontsize=8, title=cat)\n\n                # Test statistique ANOVA ou Kruskal\n                if len(groups) >= 2 and all(len(g) >= 3 for g in groups):\n                    try:\n                        _, p_anova  = f_oneway(*groups)\n                        _, p_kruskal = kruskal(*groups)\n                        axes.set_xlabel(\n                            f'{cat}   |   ANOVA p={p_anova:.4f}   '\n                            f'Kruskal p={p_kruskal:.4f}', fontsize=8)\n                    except Exception:\n                        pass\n\n                axes.set_title(f'{num}  par  {cat}', fontweight='bold')\n                plt.xticks(rotation=30, ha='right', fontsize=8)\n                plt.tight_layout()\n                plt.show()\n\n        btn.on_click(_plot)\n        display(widgets.HBox([dd_num, dd_cat, dd_plot, btn]))\n        display(out)\n\n    # ── 2.5 Scatterplot interactif ───────────────────────────\n    def _scatter_interactive(self):\n        if len(self._num) < 2:\n            print(\"Moins de 2 variables numeriques pour le scatterplot.\")\n            return\n\n        dd_x   = widgets.Dropdown(options=self._num, value=self._num[0],\n                                  description='Axe X :',\n                                  style={'description_width': '60px'},\n                                  layout=widgets.Layout(width='240px'))\n        dd_y   = widgets.Dropdown(options=self._num,\n                                  value=self._num[1] if len(self._num) > 1\n                                  else self._num[0],\n                                  description='Axe Y :',\n                                  style={'description_width': '60px'},\n                                  layout=widgets.Layout(width='240px'))\n        hue_opts = ['(aucune)'] + self._cat[:8]\n        dd_hue = widgets.Dropdown(options=hue_opts, value='(aucune)',\n                                  description='Couleur :',\n                                  style={'description_width': '70px'},\n                                  layout=widgets.Layout(width='230px'))\n        cb_reg = widgets.Checkbox(value=True, description='Droite de regression',\n                                  indent=False)\n        btn    = widgets.Button(description='Tracer', button_style='primary',\n                                layout=widgets.Layout(width='100px'))\n        out    = widgets.Output()\n\n        def _plot(_):\n            with out:\n                clear_output(wait=True)\n                x   = dd_x.value\n                y   = dd_y.value\n                hue = None if dd_hue.value == '(aucune)' else dd_hue.value\n                cols_needed = [x, y] + ([hue] if hue else [])\n                sub = self.df[cols_needed].dropna()\n\n                fig, ax = plt.subplots(figsize=(8, 5))\n                if hue:\n                    groups = sub[hue].unique()\n                    pal = sns.color_palette('Set2', len(groups))\n                    for grp, col in zip(groups, pal):\n                        mask = sub[hue] == grp\n                        ax.scatter(sub.loc[mask, x], sub.loc[mask, y],\n                                   label=str(grp), color=col,\n                                   alpha=.55, s=22, edgecolors='none')\n                    ax.legend(title=hue, fontsize=8, title_fontsize=8)\n                else:\n                    ax.scatter(sub[x], sub[y], color=PALETTE[0],\n                               alpha=.45, s=20, edgecolors='none')\n\n                if cb_reg.value:\n                    m, b, r, p, se = stats.linregress(sub[x], sub[y])\n                    x_line = np.linspace(sub[x].min(), sub[x].max(), 200)\n                    ax.plot(x_line, m * x_line + b,\n                            color='#e53935', linewidth=1.8,\n                            label=f'r={r:.3f}  p={p:.4f}')\n                    ax.legend(fontsize=8)\n\n                ax.set_xlabel(x, fontsize=10)\n                ax.set_ylabel(y, fontsize=10)\n                ax.set_title(f'{y}  vs  {x}', fontweight='bold', fontsize=11)\n                plt.tight_layout()\n                plt.show()\n\n        btn.on_click(_plot)\n        display(widgets.HBox([dd_x, dd_y, dd_hue, cb_reg, btn]))\n        display(out)\n\n\n# ══════════════════════════════════════════════════════════════\n# MODULE 3 — Analyse multivariée\n# ══════════════════════════════════════════════════════════════\n\nclass MultivariateAnalysis:\n\n    def __init__(self, df, col_meta):\n        self.df       = df\n        self.col_meta = col_meta\n        self._num     = [c for c in _num_cols(df, col_meta)\n                         if col_meta[c]['kind'] == 'numeric']\n\n    def show(self):\n        _section(\"3.1  Heatmap des valeurs manquantes (pattern)\")\n        self._missing_pattern()\n\n        _section(\"3.2  PCA — visualisation en 2D\")\n        self._pca()\n\n        _section(\"3.3  Clustermap hierarchique\")\n        self._clustermap()\n\n        _section(\"3.4  Analyse par rapport a la cible\")\n        self._target_analysis()\n\n    # ── 3.1 Pattern manquants ────────────────────────────────\n    def _missing_pattern(self):\n        miss = self.df.isnull()\n        miss_cols = miss.columns[miss.any()].tolist()\n\n        if not miss_cols:\n            display(HTML(\n                \"<div style='background:#d4edda;border-left:4px solid #28a745;\"\n                \"padding:10px;border-radius:4px'>Aucune valeur manquante.</div>\"))\n            return\n\n        sub = miss[miss_cols].astype(int)\n        # Limiter pour la lisibilite\n        sub = sub.sample(min(500, len(sub)), random_state=42) \\\n              if len(sub) > 500 else sub\n\n        fig, ax = plt.subplots(figsize=(max(6, len(miss_cols)*.7+2), 5))\n        sns.heatmap(sub.T, cmap=['#d4edda', '#f8d7da'],\n                    cbar=False, ax=ax, yticklabels=True,\n                    xticklabels=False, linewidths=0)\n        ax.set_xlabel('Observations (echantillon)')\n        ax.set_ylabel('')\n        ax.set_title('Pattern des valeurs manquantes',\n                     fontweight='bold', fontsize=11)\n        red_patch   = mpatches.Patch(color='#f8d7da', label='Manquant')\n        green_patch = mpatches.Patch(color='#d4edda', label='Present')\n        ax.legend(handles=[green_patch, red_patch],\n                  loc='upper right', fontsize=8)\n        plt.tight_layout()\n        plt.show()\n\n    # ── 3.2 PCA ──────────────────────────────────────────────\n    def _pca(self):\n        from sklearn.preprocessing import StandardScaler\n        from sklearn.decomposition import PCA\n\n        cols = self._num\n        if len(cols) < 3:\n            print(\"Moins de 3 variables numeriques pour la PCA.\")\n            return\n\n        sub = self.df[cols].dropna()\n        if len(sub) < 10:\n            print(\"Pas assez d'observations.\")\n            return\n\n        scaler = StandardScaler()\n        X_sc   = scaler.fit_transform(sub)\n\n        pca    = PCA()\n        X_pca  = pca.fit_transform(X_sc)\n        ev     = pca.explained_variance_ratio_\n\n        fig = plt.figure(figsize=(14, 5))\n        gs  = gridspec.GridSpec(1, 3, figure=fig, wspace=.3)\n\n        # Scree plot\n        ax1 = fig.add_subplot(gs[0])\n        n_comp = min(len(ev), 15)\n        ax1.bar(range(1, n_comp + 1), ev[:n_comp] * 100,\n                color=PALETTE[0], alpha=.8)\n        ax1.plot(range(1, n_comp + 1),\n                 np.cumsum(ev[:n_comp]) * 100,\n                 'o-', color='#e53935', linewidth=1.6, markersize=5)\n        ax1.axhline(80, linestyle='--', color='#e53935',\n                    alpha=.5, linewidth=1)\n        ax1.set_xlabel('Composante')\n        ax1.set_ylabel('Variance expliquee (%)')\n        ax1.set_title('Scree plot', fontweight='bold')\n\n        # Biplot PC1 vs PC2\n        ax2 = fig.add_subplot(gs[1])\n        ax2.scatter(X_pca[:, 0], X_pca[:, 1],\n                    alpha=.35, s=15, color=PALETTE[1], edgecolors='none')\n        ax2.set_xlabel(f'PC1 ({ev[0]*100:.1f}%)')\n        ax2.set_ylabel(f'PC2 ({ev[1]*100:.1f}%)')\n        ax2.set_title('Projection PC1 vs PC2', fontweight='bold')\n        ax2.axhline(0, color='#bbb', linewidth=.8)\n        ax2.axvline(0, color='#bbb', linewidth=.8)\n\n        # Loadings\n        ax3 = fig.add_subplot(gs[2])\n        loadings = pca.components_[:2].T\n        for j, col in enumerate(cols):\n            ax3.arrow(0, 0, loadings[j, 0], loadings[j, 1],\n                      head_width=.03, head_length=.02,\n                      fc=PALETTE[j % len(PALETTE)],\n                      ec=PALETTE[j % len(PALETTE)])\n            ax3.text(loadings[j, 0] * 1.12, loadings[j, 1] * 1.12,\n                     col, fontsize=7.5, ha='center')\n        circle = plt.Circle((0, 0), 1, fill=False,\n                             color='#bbb', linewidth=1)\n        ax3.add_patch(circle)\n        ax3.set_xlim(-1.2, 1.2)\n        ax3.set_ylim(-1.2, 1.2)\n        ax3.axhline(0, color='#bbb', linewidth=.8)\n        ax3.axvline(0, color='#bbb', linewidth=.8)\n        ax3.set_xlabel(f'PC1 ({ev[0]*100:.1f}%)')\n        ax3.set_ylabel(f'PC2 ({ev[1]*100:.1f}%)')\n        ax3.set_title('Loadings (cercle de correlation)', fontweight='bold')\n\n        plt.suptitle('Analyse en Composantes Principales (PCA)',\n                     fontsize=12, fontweight='bold', y=1.02)\n        plt.tight_layout()\n        plt.show()\n\n        # Tableau variance cumulee\n        n_for_80 = int(np.argmax(np.cumsum(ev) >= .80)) + 1\n        display(HTML(\n            f\"<div style='background:#e3f2fd;padding:10px 16px;\"\n            f\"border-radius:4px;font-size:.88em'>\"\n            f\"<b>{n_for_80} composante(s)</b> suffisent pour expliquer \"\n            f\"<b>80%</b> de la variance totale \"\n            f\"(sur {len(cols)} variables initiales).</div>\"\n        ))\n\n    # ── 3.3 Clustermap ───────────────────────────────────────\n    def _clustermap(self):\n        cols = self._num[:20]\n        if len(cols) < 3:\n            print(\"Moins de 3 variables numeriques.\")\n            return\n\n        sub = self.df[cols].dropna()\n        if len(sub) < 5:\n            print(\"Pas assez d'observations.\")\n            return\n\n        corr = sub.corr()\n        g = sns.clustermap(corr, cmap='coolwarm', center=0,\n                           vmin=-1, vmax=1,\n                           figsize=(max(7, len(cols)*.7), max(6, len(cols)*.7)),\n                           annot=len(cols) <= 15, fmt='.2f',\n                           annot_kws={'size': 7},\n                           linewidths=.2,\n                           dendrogram_ratio=(.15, .15))\n        g.fig.suptitle('Clustermap hierarchique des correlations',\n                       y=1.02, fontsize=12, fontweight='bold')\n        plt.show()\n\n    # ── 3.4 Analyse par rapport à la target ──────────────────\n    def _target_analysis(self):\n        dd = widgets.Dropdown(\n            options=['(aucune)'] + list(self.df.columns),\n            value='(aucune)',\n            description='Variable cible :',\n            style={'description_width': '130px'},\n            layout=widgets.Layout(width='350px')\n        )\n        out = widgets.Output()\n\n        def _update(change):\n            with out:\n                clear_output(wait=True)\n                target = change['new']\n                if target == '(aucune)':\n                    return\n\n                kind = self.col_meta.get(target, {}).get('kind', 'unknown')\n\n                # Cible categorielle -> importance par chi2 ou ANOVA\n                if kind in ('categorical', 'binary'):\n                    display(HTML(f\"<b>Cible categorielle : {target}</b>\"))\n                    rows = []\n                    for col in self._num:\n                        groups = [g[col].dropna().values\n                                  for _, g in self.df.groupby(target)]\n                        groups = [g for g in groups if len(g) >= 2]\n                        if len(groups) < 2:\n                            continue\n                        try:\n                            _, p_a = f_oneway(*groups)\n                            _, p_k = kruskal(*groups)\n                            rows.append({'Feature': col,\n                                         'ANOVA p': f'{p_a:.4f}',\n                                         'Kruskal p': f'{p_k:.4f}',\n                                         'Significatif': 'Oui' if p_a < .05 else 'Non'})\n                        except Exception:\n                            pass\n                    if rows:\n                        df_r = pd.DataFrame(rows).set_index('Feature')\n                        def cs(v):\n                            return ('background-color:#d4edda'\n                                    if v == 'Oui' else 'background-color:#f5f5f5')\n                        display(df_r.style.applymap(cs, subset=['Significatif']))\n\n                    # Distribution de la cible\n                    fig, ax = plt.subplots(figsize=(6, 3.5))\n                    vc = self.df[target].value_counts()\n                    ax.bar(vc.index.astype(str), vc.values,\n                           color=sns.color_palette('muted', len(vc)),\n                           edgecolor='white')\n                    ax.set_title(f'Distribution de la cible : {target}',\n                                 fontweight='bold')\n                    plt.tight_layout()\n                    plt.show()\n\n                # Cible numérique -> corrélations\n                elif kind == 'numeric':\n                    display(HTML(f\"<b>Cible numerique : {target}</b>\"))\n                    corr_with_target = (self.df[self._num]\n                                        .corrwith(self.df[target])\n                                        .drop(target, errors='ignore')\n                                        .sort_values(key=abs, ascending=False))\n\n                    fig, ax = plt.subplots(figsize=(7, max(3, len(corr_with_target)*.4)))\n                    colors  = ['#e53935' if v < 0 else '#1e88e5'\n                               for v in corr_with_target.values]\n                    ax.barh(corr_with_target.index[::-1],\n                            corr_with_target.values[::-1],\n                            color=colors[::-1], edgecolor='white')\n                    ax.axvline(0, color='#333', linewidth=.8)\n                    ax.set_xlabel(\"Correlation de Pearson avec la cible\")\n                    ax.set_title(f'Correlations avec {target}',\n                                 fontweight='bold')\n                    plt.tight_layout()\n                    plt.show()\n\n        dd.observe(_update, names='value')\n        display(dd)\n        display(out)\n\n\n# ══════════════════════════════════════════════════════════════\n# MODULE 4 — Rapport de synthese\n# ══════════════════════════════════════════════════════════════\n\nclass SynthesisReport:\n\n    def __init__(self, df, col_meta):\n        self.df       = df\n        self.col_meta = col_meta\n\n    def show(self):\n        _section(\"4.  Rapport de synthese automatique\")\n        df, cm = self.df, self.col_meta\n\n        num_cols  = [c for c, m in cm.items() if m['kind'] == 'numeric']\n        cat_cols  = [c for c, m in cm.items() if m['kind'] == 'categorical']\n        bin_cols  = [c for c, m in cm.items() if m['kind'] == 'binary']\n        miss_cols = [c for c, m in cm.items() if m['pct_miss'] > 0]\n        high_miss = [c for c, m in cm.items() if m['pct_miss'] > 20]\n\n        issues, infos = [], []\n\n        if df.duplicated().sum() > 0:\n            issues.append(f\"{df.duplicated().sum()} lignes dupliquees detectees\")\n        if high_miss:\n            issues.append(f\"Colonnes avec >20% manquants : {high_miss}\")\n        # Outliers approximatif\n        for col in num_cols:\n            d = df[col].dropna()\n            q1, q3 = d.quantile(.25), d.quantile(.75)\n            n_out = int(((d < q1 - 1.5*(q3-q1)) | (d > q3 + 1.5*(q3-q1))).sum())\n            if n_out / max(len(d), 1) > .05:\n                issues.append(f\"Colonne '{col}' : {n_out} outliers IQR ({n_out/len(d)*100:.1f}%)\")\n        # Skewness forte\n        for col in num_cols:\n            sk = df[col].skew()\n            if abs(sk) > 2:\n                infos.append(f\"'{col}' : skewness = {sk:.2f} — transformation log possible\")\n        # Déséquilibre binary\n        for col in bin_cols:\n            vc = df[col].value_counts(normalize=True)\n            if len(vc) >= 2 and vc.iloc[0] > .85:\n                issues.append(f\"'{col}' : classe majoritaire a {vc.iloc[0]*100:.1f}%\")\n\n        html = \"<div style='display:flex;gap:16px;flex-wrap:wrap'>\"\n        if issues:\n            html += \"<div style='flex:1;min-width:280px'>\"\n            html += \"<b style='color:#c62828'>Points d\\'attention</b><ul style='margin:6px 0'>\"\n            for iss in issues:\n                html += f\"<li style='font-size:.87em;margin:3px 0'>{iss}</li>\"\n            html += \"</ul></div>\"\n        if infos:\n            html += \"<div style='flex:1;min-width:280px'>\"\n            html += \"<b style='color:#1565c0'>Informations</b><ul style='margin:6px 0'>\"\n            for inf in infos:\n                html += f\"<li style='font-size:.87em;margin:3px 0'>{inf}</li>\"\n            html += \"</ul></div>\"\n        if not issues and not infos:\n            html += (\"<div style='background:#d4edda;padding:12px;\"\n                     \"border-radius:4px'>Aucun probleme majeur detecte.</div>\")\n        html += \"</div>\"\n        display(HTML(html))\n\n\n# ══════════════════════════════════════════════════════════════\n# EDA_Engine — orchestrateur principal\n# ══════════════════════════════════════════════════════════════\n\nclass EDAEngine:\n    \"\"\"\n    EDA complet et interactif pour un ou plusieurs DataFrames.\n\n    Usage :\n        eda = EDAEngine(loader.get_all(), explorer.meta)\n        eda.show()\n    \"\"\"\n\n    TABS = [\n        \"Univariee\",\n        \"Bivariee\",\n        \"Multivariee\",\n        \"Synthese\",\n    ]\n\n    def __init__(self, datasets: dict, meta: dict):\n        if isinstance(datasets, pd.DataFrame):\n            datasets = {'Donnees': datasets}\n        self.datasets = datasets\n        self.meta     = meta\n\n    def show(self):\n        display(HTML(\n            \"<h3 style='margin:0 0 4px'>EDA Avance</h3>\"\n            \"<p style='color:#555;font-size:.88em;margin:0 0 14px'>\"\n            \"Analyses univariees, bivariees, multivariees et rapport de synthese.\"\n            \" Selectionnez un dataset puis un onglet d\\'analyse.</p>\"\n        ))\n\n        # Si plusieurs datasets -> sélecteur\n        if len(self.datasets) > 1:\n            ds_dd = widgets.Dropdown(\n                options=list(self.datasets.keys()),\n                description='Dataset :',\n                style={'description_width': '70px'},\n                layout=widgets.Layout(width='260px', margin='0 0 12px')\n            )\n            out_main = widgets.Output()\n\n            def _switch(change):\n                with out_main:\n                    clear_output(wait=True)\n                    self._render(change['new'])\n\n            ds_dd.observe(_switch, names='value')\n            display(ds_dd)\n            display(out_main)\n            # Rendu initial\n            with out_main:\n                self._render(list(self.datasets.keys())[0])\n        else:\n            self._render(next(iter(self.datasets)))\n\n    def _render(self, label: str):\n        df       = self.datasets[label]\n        col_meta = self.meta.get(label, {})\n\n        univ  = UnivariateAnalysis(df, col_meta)\n        biv   = BivariateAnalysis(df, col_meta)\n        multi = MultivariateAnalysis(df, col_meta)\n        synth = SynthesisReport(df, col_meta)\n\n        tab_outputs = []\n        for _ in self.TABS:\n            tab_outputs.append(widgets.Output())\n\n        tab = widgets.Tab(children=tab_outputs)\n        for i, name in enumerate(self.TABS):\n            tab.set_title(i, name)\n\n        display(tab)\n\n        # Chargement paresseux : render au premier clic\n        rendered = [False] * len(self.TABS)\n        modules  = [univ, biv, multi, synth]\n\n        def _on_tab_change(change):\n            idx = change['new']\n            if not rendered[idx]:\n                with tab_outputs[idx]:\n                    modules[idx].show()\n                rendered[idx] = True\n\n        tab.observe(_on_tab_change, names='selected_index')\n\n        # Afficher le premier onglet directement\n        with tab_outputs[0]:\n            modules[0].show()\n        rendered[0] = True\n\n\n# ── Lancement ─────────────────────────────────────────────────────────\ndatasets = loader.get_all()\nmeta     = explorer.meta\n\nif datasets and meta:\n    eda = EDAEngine(datasets, meta)\n    eda.show()\nelse:\n    print(\"Executez d'abord les cellules 1 et 2.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-30T09:46:59.179944Z","iopub.execute_input":"2026-04-30T09:4