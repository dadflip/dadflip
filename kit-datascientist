    "class BusinessEditor:\n",
    "    def __init__(self, datasets, data_types):\n",
    "        self.datasets = datasets\n",
    "        self.data_types = data_types\n",
    "        \n",
    "    def show(self):\n",
    "        if not self.datasets:\n",
    "            display(HTML(\"<div style='padding:12px; background:#fef2f2; border-left:4px solid #ef4444; color:#991b1b; border-radius:4px;'>Veuillez charger des données à l'étape 1.</div>\"))\n",
