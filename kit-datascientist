    "\n",
    "    def _do_load(self):\n",
    "        src_key = self.source_dd.value\n",
    "        src = self.SUPPORTED_TYPES[src_key]\n",
    "        kwargs = self._get_tabular_kwargs()\n",
    "        loaded = []\n",
    "\n",
    "        # ---- sklearn ----\n",
    "        if src == \"sklearn\":\n",
    "            name = self._sklearn_name.value if self._sklearn_name else \"iris\"\n",
