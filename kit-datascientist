    "\n",
    "def align_columns(X_ref: pd.DataFrame, X_target: pd.DataFrame,\n",
    "                  fill_value=0) -> tuple:\n",
    "    \"\"\"\n",
    "    Aligne X_target sur les colonnes de X_ref.\n",
    "    Retourne (X_aligned, rapport_html).\n",
    "    \"\"\"\n",
    "    X_out = X_target.copy()\n",
    "    ref_cols = list(X_ref.columns)\n",
