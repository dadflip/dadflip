    "            styles.help_box(\n",
    "                \"<b>Predictions:</b> Distribution of y_pred vs y_true, error analysis by class or value range, and CSV export.\",\n",
    "                '#3b82f6'\n",
    "            ),\n",
    "            self.btn_pred, self.out_pred\n",
    "        ])\n",
