    "# ============================================================\n",
    "# CELLULE 7 — EXPORT ET SYNTHÈSE\n",
    "# ============================================================\n",
    "display(HTML(\"<h3>Export du Dataset Préparé</h3>\"))\n",
    "def export_data(datasets, base_name=\"dataset_prepared\"):\n",
    "    for lbl, df in datasets.items():\n",
    "        fname = f\"{base_name}_{lbl}.csv\"\n",
    "        df.to_csv(fname, index=False)\n",
    "        print(f\"Sauvegardé : {fname} ({df.shape[0]} lignes, {df.shape[1]} colonnes)\")\n",
    "\n",
    "if 'normalizer' in locals() and normalizer.results:\n",
    "    btn_export = widgets.Button(description=\"Exporter en CSV\", button_style='primary')\n",
    "    out_exp = widgets.Output()\n",
    "    def on_exp(b):\n",
    "        with out_exp:\n",
    "            clear_output()\n",
    "            export_data(normalizer.results)\n",
    "            display(HTML(\"<b style='color:green;'>Exportation terminée. Les fichiers sont disponibles dans votre environnement.</b>\"))\n",
    "    btn_export.on_click(on_exp)\n",
    "    display(btn_export, out_exp)\n",
    "else:\n",
    "    print(\"Veuillez finaliser le pipeline jusqu'à la Normalisation.\")\n"
   ]
