    "# ============================================================\n",
    "# CELLULE 5 — ENCODAGE DES VARIABLES (Tabulaire + Non-Tabulaire)\n",
    "# Supporte : DataFrames, Images, Textes, Graphes, Audio, Séries Temporelles\n",
    "# ============================================================\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, HTML, clear_output\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------\n",
    "# Inférence des types pour colonnes tabulaires\n",
    "# ----------------------------------------------------------------\n",
    "def infer_types(df: pd.DataFrame) -> dict:\n",
    "    col_meta = {}\n",
    "    for col in df.columns:\n",
    "        s, n_unique, n_total = df[col], df[col].nunique(), max(len(df[col].dropna()), 1)\n",
    "        if pd.api.types.is_datetime64_any_dtype(s):                          kind = 'datetime'\n",
    "        elif pd.api.types.is_bool_dtype(s) or n_unique == 2:                 kind = 'binary'\n",
    "        elif pd.api.types.is_numeric_dtype(s):\n",
    "            kind = 'id_like' if (n_unique / n_total > 0.95 and n_unique > 50) else 'numeric'\n",
    "        else:\n",
    "            avg_len = s.dropna().astype(str).str.len().mean() if not s.dropna().empty else 0\n",
    "            if n_unique / n_total > 0.90 and avg_len > 20:                   kind = 'text'\n",
    "            elif n_unique / n_total > 0.95 and n_unique > 50:                kind = 'id_like'\n",
    "            else:                                                             kind = 'categorical'\n",
    "        col_meta[col] = {'kind': kind, 'n_unique': n_unique}\n",
    "    return col_meta\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------\n",
    "# Inférence du type de données non-tabulaires\n",
    "# ----------------------------------------------------------------\n",
    "def infer_non_tabular_type(key: str, value) -> str:\n",
    "    \"\"\"Inférence heuristique basée sur le type Python et le nom de la clé.\"\"\"\n",
    "    type_name = type(value).__name__.lower()\n",
    "    key_lower  = key.lower()\n",
    "\n",
    "    # Graphes / Réseaux\n",
    "    try:\n",
    "        import networkx as nx\n",
    "        if isinstance(value, (nx.Graph, nx.DiGraph, nx.MultiGraph, nx.MultiDiGraph)):\n",
    "            return 'graph'\n",
    "    except ImportError:\n",
    "        pass\n",
    "\n",
    "    # Images (numpy arrays 2D/3D, PIL, torch.Tensor)\n",
    "    if hasattr(value, 'shape'):\n",
    "        shape = value.shape\n",
    "        if len(shape) in (2, 3) and any(k in key_lower for k in ['img', 'image', 'photo', 'frame', 'pixel']):\n",
    "            return 'image'\n",
    "        if len(shape) == 3 and shape[-1] in (1, 3, 4):\n",
    "            return 'image'\n",
    "    try:\n",
    "        from PIL import Image\n",
    "        if isinstance(value, Image.Image):\n",
    "            return 'image'\n",
    "    except ImportError:\n",
    "        pass\n",
    "\n",
    "    # Audio (numpy 1D, soundfile arrays, librosa output)\n",
    "    if hasattr(value, 'shape') and len(value.shape) in (1, 2):\n",
    "        if any(k in key_lower for k in ['audio', 'sound', 'wave', 'speech', 'signal']):\n",
    "            return 'audio'\n",
    "\n",
    "    # Séries temporelles (DataFrame avec index temporel ou clé spécifique)\n",
    "    if isinstance(value, pd.DataFrame):\n",
    "        if pd.api.types.is_datetime64_any_dtype(value.index) or \\\n",
    "           any(k in key_lower for k in ['ts', 'timeseries', 'time_series', 'temporal']):\n",
    "            return 'timeseries'\n",
    "        return 'dataframe'\n",
    "\n",
    "    # Texte brut (liste de strings, string unique, Series de strings)\n",
    "    if isinstance(value, str) or \\\n",
    "       (isinstance(value, list) and value and isinstance(value[0], str)) or \\\n",
    "       (isinstance(value, pd.Series) and value.dtype == object):\n",
    "        return 'text'\n",
    "\n",
    "    # Embeddings / vecteurs déjà encodés\n",
    "    if hasattr(value, 'shape') and len(value.shape) in (1, 2):\n",
    "        if any(k in key_lower for k in ['embed', 'vector', 'feat', 'latent', 'repr']):\n",
    "            return 'embedding'\n",
    "\n",
    "    # Documents (dict, JSON-like)\n",
    "    if isinstance(value, (dict, list)):\n",
    "        return 'document'\n",
    "\n",
    "    return 'unknown'\n",
    "\n",
