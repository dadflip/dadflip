    "# ============================================================\n",
    "# CELLULE 1 — IMPORT UNIVERSEL DES DONNEES (Tabulaires & Complexes)\n",
    "# Supporte : CSV, TSV, Excel, JSON, Parquet, Images, Graphes, Textes, Séries Temporelles\n",
    "# ============================================================\n",
    "import io\n",
    "import pandas as pd\n",
    "import networkx as nx\n",
    "from PIL import Image\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, clear_output\n",
    "\n",
    "def _read_file_bytes(raw_bytes: bytes, filename: str, sep: str, enc: str, header, source_type: str):\n",
    "    ext = filename.rsplit('.', 1)[-1].lower() if '.' in filename else ''\n",
    "    buf = io.BytesIO(raw_bytes)\n",
    "    \n",
    "    if source_type == 'Image (.png/.jpg)': return Image.open(buf)\n",
    "    elif source_type == 'Graphe (.graphml/.gml)':\n",
    "        try: return nx.read_graphml(io.BytesIO(raw_bytes))\n",
    "        except: return nx.read_gml(io.BytesIO(raw_bytes))\n",
    "    elif source_type == 'Texte (.txt)': return buf.read().decode(enc)\n",
    "    \n",
    "    if ext == 'csv': return pd.read_csv(buf, sep=sep, encoding=enc, header=header)\n",
    "    elif ext == 'tsv': return pd.read_csv(buf, sep='\\t', encoding=enc, header=header)\n",
    "    elif ext in ('xls', 'xlsx'): return pd.read_excel(buf, header=header)\n",
    "    elif ext == 'json': return pd.read_json(buf)\n",
    "    elif ext == 'parquet': return pd.read_parquet(buf)\n",
    "    else: return pd.read_csv(buf, sep=sep, encoding=enc, header=header)\n",
    "\n",
    "def _extract_from_upload(upload_widget):\n",
    "    val = upload_widget.value\n",
    "    results = []\n",
    "    if isinstance(val, dict):\n",
    "        for fname, info in val.items(): results.append((fname, bytes(info['content'])))\n",
    "    elif isinstance(val, (list, tuple)):\n",
    "        for item in val:\n",
    "            if hasattr(item, 'content'):\n",
    "                name = getattr(item, 'name', 'fichier.ext')\n",
    "                content = item.content\n",
    "                if hasattr(content, 'tobytes'): content = content.tobytes()\n",
    "                results.append((name, bytes(content)))\n",
    "            elif isinstance(item, dict):\n",
    "                results.append((item.get('name', 'fichier.ext'), bytes(item.get('content', b''))))\n",
    "    return results\n",
    "\n",
    "class DataLoader:\n",
    "    SUPPORTED = {\n",
    "        'Tabulaire CSV (.csv)': 'csv', 'Tabulaire TSV (.tsv)': 'tsv', 'Excel (.xlsx/.xls)': 'excel',\n",
    "        'JSON (.json)': 'json', 'Parquet (.parquet)': 'parquet',\n",
    "        'Série Temporelle (CSV avec date)': 'timeseries',\n",
    "        'Image (.png/.jpg)': 'image', 'Graphe (.graphml/.gml)': 'graph',\n",
    "        'Texte (.txt)': 'text', 'Dossier zippé / Lot (.zip)': 'zip', 'URL directe (Tabulaire)': 'url',\n",
    "    }\n",
    "    SLOT_LABELS = ['Train', 'Test', 'Validation', 'Autre']\n",
    "\n",
    "    def __init__(self):\n",
    "        self.datasets = {}\n",
    "        self.data_types = {}\n",
    "        self._build_ui()\n",
    "\n",
    "    def _apply_sample(self, data, pct):\n",
    "        if pct >= 100: return data\n",
    "        if isinstance(data, pd.DataFrame):\n",
    "            n = max(1, int(len(data) * (pct / 100.0)))\n",
    "            return data.sample(n=n, random_state=42).reset_index(drop=True)\n",
    "        return data\n",
    "\n",
    "    def _build_ui(self):\n",
    "        title = widgets.HTML(\"<h3 style='margin:0 0 12px'>Chargement des Données</h3>\")\n",
    "        self.mode_toggle = widgets.ToggleButtons(options=['Fichier unique', 'Multi-fichiers'], value='Fichier unique')\n",
    "        self.source_dd = widgets.Dropdown(options=list(self.SUPPORTED.keys()), description='Type :', layout=widgets.Layout(width='350px'))\n",
    "        \n",
    "        self.sep_input = widgets.Text(value=',', description='Séparateur :', layout=widgets.Layout(width='180px'))\n",
    "        self.enc_input = widgets.Text(value='utf-8', description='Encodage :', layout=widgets.Layout(width='180px'))\n",
    "        self.header_cb = widgets.Checkbox(value=True, description='En-têtes', indent=False)\n",
    "        self.date_col_input = widgets.Text(value='', placeholder='ex: Date', description='Col Date (Séries) :', layout=widgets.Layout(width='250px'))\n",
    "        \n",
    "        adv = widgets.Accordion(children=[widgets.HBox([self.sep_input, self.enc_input, self.header_cb, self.date_col_input])])\n",
    "        adv.set_title(0, 'Options avancées')\n",
    "        adv.selected_index = None\n",
    "\n",
    "        self.sample_slider = widgets.IntSlider(value=100, min=1, max=100, step=1, description='Utiliser % :')\n",
    "        self.sample_box = widgets.HBox([self.sample_slider, widgets.Label(\"Taille de l'échantillon à conserver.\")])\n",
    "\n",
    "        self.dynamic_box = widgets.VBox([])\n",
    "        self.load_btn = widgets.Button(description='Charger', button_style='primary')\n",
    "        self.status = widgets.Output()\n",
    "\n",
    "        self.source_dd.observe(self._refresh_dynamic, names='value')\n",
    "        self.mode_toggle.observe(self._refresh_dynamic, names='value')\n",
    "        self.load_btn.on_click(self._on_load)\n",
    "\n",
    "        self.ui = widgets.VBox([title, self.mode_toggle, self.source_dd, self.dynamic_box, adv, self.sample_box, self.load_btn, self.status])\n",
    "        self._refresh_dynamic(None)\n",
    "\n",
    "    def _make_upload_slot(self, label: str) -> tuple:\n",
    "        lbl = widgets.Label(value=label, layout=widgets.Layout(width='120px'))\n",
    "        btn = widgets.FileUpload(multiple=True, description='Choisir', layout=widgets.Layout(width='220px'))\n",
    "        return lbl, btn\n",
    "\n",
    "    def _refresh_dynamic(self, _):\n",
    "        src = self.SUPPORTED[self.source_dd.value]\n",
    "        multi = (self.mode_toggle.value != 'Fichier unique')\n",
    "        children = []\n",
    "\n",
    "        if src != 'url':\n",
    "            if not multi:\n",
    "                lbl, btn = self._make_upload_slot('Fichier :')\n",
    "                self._slots = [('Données', btn)]\n",
    "                children = [widgets.HBox([lbl, btn])]\n",
    "            else:\n",
    "                self._slots = []\n",
    "                rows = []\n",
    "                for sname in self.SLOT_LABELS:\n",
    "                    lbl, btn = self._make_upload_slot(f'{sname} :')\n",
    "                    self._slots.append((sname, btn))\n",
    "                    rows.append(widgets.HBox([lbl, btn]))\n",
    "                children = rows\n",
    "        elif src == 'url':\n",
    "            if not multi:\n",
    "                inp = widgets.Text(placeholder='https://...', description='URL :', layout=widgets.Layout(width='520px'))\n",
    "                self._url_inputs = [('Données', inp)]\n",
    "                children = [inp]\n",
    "            else:\n",
    "                self._url_inputs = []\n",
    "                for sname in self.SLOT_LABELS:\n",
    "                    inp = widgets.Text(placeholder='https://...', description=f'{sname} :', layout=widgets.Layout(width='560px'))\n",
    "                    self._url_inputs.append((sname, inp))\n",
    "                    children.append(inp)\n",
    "\n",
    "        self.dynamic_box.children = children\n",
    "\n",
    "    def _on_load(self, _):\n",
    "        with self.status:\n",
    "            clear_output()\n",
    "            try:\n",
    "                src_key = self.source_dd.value\n",
    "                src = self.SUPPORTED[src_key]\n",
    "                sep, enc = self.sep_input.value or ',', self.enc_input.value or 'utf-8'\n",
    "                header = 0 if self.header_cb.value else None\n",
    "                date_col = self.date_col_input.value\n",
    "                pct = self.sample_slider.value\n",
    "                \n",
    "                if src != 'url':\n",
    "                    for label, btn in self._slots:\n",
    "                        files = _extract_from_upload(btn)\n",
    "                        if files:\n",
    "                            if src == 'zip':\n",
    "                                import zipfile\n",
    "                                fname, raw = files[0]\n",
    "                                try:\n",
    "                                    z = zipfile.ZipFile(io.BytesIO(raw))\n",
    "                                    for info in z.infolist():\n",
    "                                        if info.is_dir() or info.filename.startswith('__MACOSX'): continue\n",
    "                                        ext_z = info.filename.rsplit('.', 1)[-1].lower() if '.' in info.filename else ''\n",
    "                                        with z.open(info) as f:\n",
    "                                            content = f.read()\n",
    "                                            lbl_k = f\"{label}_{info.filename.split('/')[-1]}\"\n",
    "                                            try:\n",
    "                                                if ext_z in ('png', 'jpg', 'jpeg'): \n",
    "                                                    self.datasets[lbl_k] = Image.open(io.BytesIO(content)).copy()\n",
    "                                                    self.data_types[lbl_k] = 'image'\n",
    "                                                elif ext_z == 'txt': \n",
    "                                                    self.datasets[lbl_k] = content.decode(enc, errors='ignore')\n",
    "                                                    self.data_types[lbl_k] = 'text'\n",
    "                                                elif ext_z == 'csv': \n",
    "                                                    df = pd.read_csv(io.BytesIO(content), sep=sep, encoding=enc, header=header)\n",
    "                                                    self.datasets[lbl_k] = self._apply_sample(df, pct)\n",
    "                                                    self.data_types[lbl_k] = 'csv'\n",
    "                                            except: pass\n",
    "                                except Exception as e:\n",
    "                                    print(f\"Erreur ZIP : {e}\")\n",
    "                            else:\n",
    "                                for i, (fname, raw) in enumerate(files):\n",
    "                                    lbl = label if len(files) == 1 else f\"{label}_{i}_{fname.split('/')[-1]}\"\n",
    "                                    data = _read_file_bytes(raw, fname, sep, enc, header, src_key)\n",
    "                                    \n",
    "                                    if src == 'timeseries' and isinstance(data, pd.DataFrame) and date_col in data.columns:\n",
    "                                        data[date_col] = pd.to_datetime(data[date_col])\n",
    "                                        data = data.set_index(date_col)\n",
    "                                        \n",
    "                                    self.datasets[lbl] = self._apply_sample(data, pct)\n",
    "                                    self.data_types[lbl] = src\n",
    "                elif src == 'url':\n",
    "                    for label, inp in self._url_inputs:\n",
    "                        url = inp.value.strip()\n",
    "                        if url:\n",
    "                            df = pd.read_csv(url, sep=sep, encoding=enc, header=header)\n",
    "                            self.datasets[label] = self._apply_sample(df, pct)\n",
    "                            self.data_types[label] = 'url'\n",
    "\n",
    "                if self.datasets:\n",
    "                    print(f\"Données chargées avec succès: {list(self.datasets.keys())}\")\n",
    "                    for k, v in self.datasets.items():\n",
    "                        if isinstance(v, pd.DataFrame): print(f\"   [{k}] DataFrame: {v.shape[0]} lignes x {v.shape[1]} colonnes\")\n",
    "                        elif isinstance(v, Image.Image): print(f\"   [{k}] Image: {v.size} (Mode: {v.mode})\")\n",
    "                        elif isinstance(v, nx.Graph): print(f\"   [{k}] Graphe: {v.number_of_nodes()} noeuds, {v.number_of_edges()} arêtes\")\n",
    "                        elif isinstance(v, str): print(f\"   [{k}] Texte: {len(v)} caractères\")\n",
    "            except Exception as e:\n",
    "                import traceback\n",
    "                print(f\"Erreur : {e}\"); traceback.print_exc()\n",
