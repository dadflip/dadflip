    "# ============================================================\n",
    "# BUSINESS CONTEXT — 02_business.py\n",
    "# Defines the project name, goals, target variables, and\n",
    "# the machine learning domain of the pipeline.\n",
    "# ============================================================\n",
    "\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, clear_output, HTML\n",
    "import pandas as pd\n",
    "\n",
    "class BusinessEditorUI:\n",
    "    \"\"\"\n",
    "    User interface for defining the business context and objective.\n",
    "    \"\"\"\n",
    "    def __init__(self, state):\n",
    "        self.state = state\n",
    "        self._build_ui()\n",
    "\n",
    "    def _build_ui(self):\n",
    "        title = widgets.HTML(\n",
    "            \"<h2 style='margin:0 0 10px 0; color:#1d4ed8; font-family:sans-serif;'>Business Context & Problem Definition</h2>\"\n",
    "        )\n",
