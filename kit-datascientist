       "value": "\n        <div class='pipeline-card'>\n            <div class='pipeline-title'>Configuration Loaded <span class='pipeline-badge'>Global Pipeline Specs</span></div>\n            \n    <div class='pipeline-kv-grid' style='grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));'>\n        \n        <div class='pipeline-kv-cell'>\n            <div class='kv-key'>Supported Domains</div>\n            <div class='kv-val' style='font-size:0.95em; white-space:normal;'>Binary Classification, Multiclass Classification, Regression, Clustering, Time Series, NLP, Computer Vision, Graph Analysis, Ontology / Knowledge Graph</div>\n        </div>\n        \n        <div class='pipeline-kv-cell'>\n            <div class='kv-key'>Loaders (17)</div>\n            <div class='kv-val' style='font-size:0.85em; white-space:normal; font-weight:normal; color:#475569;'>CSV (.csv), TSV (.tsv), Excel (.xlsx / .xls), JSON (.json), Parquet (.parquet), Feather (.feather), HDF5 (.h5 / .hdf), ORC (.orc), SQLite (.db / .sqlite), Time Series (CSV + datetime col), Image (.png / .jpg / .bmp), Graph (.graphml / .gml), Text file (.txt), Ontology (.owl / .rdf / .ttl), ZIP batch (folder of files), Clipboard (paste CSV text), sklearn toy dataset</div>\n        </div>\n        \n        <div class='pipeline-kv-cell'>\n            <div class='kv-key'>Cleaning & Preprocessing</div>\n            <div class='kv-val' style='font-size:0.95em;'>Missing: 16 | Outliers: 8 | Types: 6 | Text: 9</div>\n        </div>\n        \n        <div class='pipeline-kv-cell'>\n            <div class='kv-key'>Feature Engineering</div>\n            <div class='kv-val' style='font-size:0.95em;'>Tabular: 45 | Non-Tabular: 23 | Feat. Sel: 7</div>\n        </div>\n        \n        <div class='pipeline-kv-cell'>\n            <div class='kv-key'>Modeling</div>\n            <div class='kv-val' style='font-size:0.95em;'>Clf-Bin: 11 | Clf-Mul: 3 | Reg: 10 | Clu: 3 | Non-Tab: 11</div>\n        </div>\n        \n        <div class='pipeline-kv-cell'>\n            <div class='kv-key'>Eval & Interpretability</div>\n            <div class='kv-val' style='font-size:0.95em;'>Metrics: 0 | Explainers: 9</div>\n        </div>\n        \n    </div>\n    <div style='margin-top:12px; font-size:0.85em; color:#10b981; font-weight:bold; text-align:right;'>\n        [OK] Global configuration dictionary injected into 'state.config'\n    </div>\n    \n        </div>\n        "
