    "# ============================================================\n",
    "# CELLULE 3 — EDA COMPLET & MODULAIRE\n",
    "# ============================================================\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import scipy.stats as stats\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, HTML, clear_output\n",
    "\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "\n",
    "def infer_types(df: pd.DataFrame) -> dict:\n",
    "    col_meta = {}\n",
    "    for col in df.columns:\n",
    "        s, n_unique, n_total = df[col], df[col].nunique(), max(len(df[col].dropna()), 1)\n",
    "        if pd.api.types.is_datetime64_any_dtype(s): kind = 'datetime'\n",
    "        elif pd.api.types.is_bool_dtype(s) or n_unique == 2: kind = 'binary'\n",
    "        elif pd.api.types.is_numeric_dtype(s):\n",
    "            kind = 'id_like' if (n_unique / n_total > 0.95 and n_unique > 50) else 'numeric'\n",
    "        else:\n",
    "            avg_len = s.dropna().astype(str).str.len().mean() if not s.dropna().empty else 0\n",
    "            if n_unique / n_total > 0.90 and avg_len > 20: kind = 'text'\n",
    "            elif n_unique / n_total > 0.95 and n_unique > 50: kind = 'id_like'\n",
    "            else: kind = 'categorical'\n",
    "        col_meta[col] = {'kind': kind, 'n_unique': n_unique, 'dtype': str(s.dtype), 'missing': int(s.isna().sum()), 'pct_miss': float(s.isna().mean() * 100)}\n",
    "    return col_meta\n",
    "\n",
    "class UltimateEDA:\n",
    "    def __init__(self, raw_datasets, data_types=None):\n",
    "        self.all_datasets = {k: v for k, v in raw_datasets.items()}\n",
    "        self.data_types = data_types or {}\n",
    "        \n",
    "        # Determine tabular ones and infer types\n",
    "        self.meta = {}\n",
    "        for k, v in self.all_datasets.items():\n",
    "            if isinstance(v, pd.DataFrame):\n",
    "                self.meta[k] = infer_types(v)\n",
    "                \n",
    "        self.current_ds = None\n",
    "        self._build_ui()\n",
    "        \n",
    "    def _build_ui(self):\n",
    "        if not self.all_datasets:\n",
    "            self.ui = widgets.HTML(\"<div style='padding:12px; border-left:4px solid #ef4444; background:#fef2f2; color:#b91c1c;'>Aucun Dataset détecté. Chargez des données à l'étape 1.</div>\")\n",
    "            return\n",
    "            \n",
    "        self.ds_selector = widgets.Dropdown(options=list(self.all_datasets.keys()), description='Dataset:', style={'description_width': 'initial'}, layout=widgets.Layout(width='300px'))\n",
    "        self.ds_selector.observe(self.on_ds_change, names='value')\n",
    "        self.current_ds = self.ds_selector.value\n",
    "        \n",
    "        self.dynamic_ui = widgets.VBox([])\n",
    "        \n",
    "        self.ui = widgets.VBox([\n",
    "            widgets.HTML(\"<div style='border-bottom: 2px solid #e2e8f0; margin-bottom: 16px; padding-bottom: 8px;'><h2 style='font-size:20px; color:#1e293b; margin:0;'>Exploratory Data Analysis (Ultra-Complet)</h2></div>\"),\n",
    "            self.ds_selector,\n",
    "            self.dynamic_ui\n",
    "        ])\n",
    "        \n",
    "        self.on_ds_change(None)\n",
    "\n",
    "    def on_ds_change(self, change):\n",
    "        if change: self.current_ds = change.new\n",
    "        data = self.all_datasets[self.current_ds]\n",
    "        dtype = self.data_types.get(self.current_ds, 'unknown')\n",
    "        \n",
    "        if isinstance(data, pd.DataFrame):\n",
    "            self._build_tabular_ui(data, dtype)\n",
    "        else:\n",
    "            try:\n",
    "                from PIL import Image\n",
    "                import networkx as nx\n",
    "                if isinstance(data, Image.Image):\n",
    "                    self._build_image_ui(data)\n",
    "                elif isinstance(data, str):\n",
    "                    self._build_text_ui(data)\n",
    "                elif isinstance(data, nx.Graph):\n",
    "                    self._build_graph_ui(data)\n",
    "                else:\n",
    "                    self.dynamic_ui.children = [widgets.HTML(f\"<div style='padding:12px; color:#b91c1c;'>Type de données non pris en charge pour l'EDA : {type(data)}</div>\")]\n",
    "            except ImportError:\n",
    "                self.dynamic_ui.children = [widgets.HTML(\"<div style='padding:12px; color:#b91c1c;'>Dépendances manquantes pour ce type de données.</div>\")]\n",
    "\n",
    "    def _build_tabular_ui(self, df, dtype):\n",
    "        # We recreate the tabs for tabular data\n",
    "        self.tabs = widgets.Tab()\n",
    "        \n",
    "        # Tab 1: Qualité & Résumé Stats\n",
    "        self.out_recap = widgets.Output()\n",
    "        tab_recap = widgets.VBox([\n",
    "            widgets.HTML(\"<p style='color:#475569;'>Aperçu, Valeurs manquantes et Statistiques basiques.</p>\"),\n",
    "            self.out_recap\n",
    "        ])\n",
    "        \n",
    "        # Helper class for checkbox selection\n",
    "        class CheckboxContainer:\n",
    "            def __init__(self, options):\n",
    "                self.checkboxes = {opt: widgets.Checkbox(description=opt, value=False, indent=False, layout=widgets.Layout(width='auto', margin='0')) for opt in options}\n",
    "                self.box = widgets.VBox(list(self.checkboxes.values()), layout=widgets.Layout(max_height='150px', overflow_y='auto', border='1px solid #cbd5e1', padding='4px', width='100%'))\n",
    "                self.btn_all = widgets.Button(description='Toutes', layout=widgets.Layout(width='auto'))\n",
    "                self.btn_none = widgets.Button(description='Aucune', layout=widgets.Layout(width='auto'))\n",
    "                self.btn_all.on_click(self.check_all)\n",
    "                self.btn_none.on_click(self.uncheck_all)\n",
    "                self.ui = widgets.VBox([\n",
    "                    widgets.HBox([self.btn_all, self.btn_none], layout=widgets.Layout(margin='0 0 4px 0')),\n",
