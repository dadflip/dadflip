    "# ============================================================\n",
    "# INSTALLER LOGIC\n",
    "# ============================================================\n",
    "\n",
    "def _pip_install(packages: list[str], output_widget) -> tuple[bool, list[str]]:\n",
    "    \"\"\"\n",
    "    Install packages using !pip (IPython magic) — the native notebook syntax.\n",
    "    Equivalent to running: !pip install pkg1 pkg2 ... -q\n",
    "    Returns (success, failed_pkgs).\n",
    "    \"\"\"\n",
    "    failed = []\n",
    "    _ipy = get_ipython()\n",
    "    for pkg in packages:\n",
    "        with output_widget:\n",
    "            print(f\"   !pip install {pkg} -q\")\n",
    "        try:\n",
    "            _ipy.run_line_magic(\"pip\", f\"install {pkg} -q\")\n",
    "        except Exception as exc:\n",
    "            failed.append(pkg)\n",
    "            with output_widget:\n",
    "                print(f\"   [FAILED] {pkg} — {exc}\")\n",
    "    return len(failed) == 0, failed\n",
    "\n",
    "\n",
    "def _check_imports(modules: list[str]) -> dict[str, bool]:\n",
    "    \"\"\"Try importing each module. Returns {module: ok}.\"\"\"\n",
    "    status = {}\n",
    "    for mod in modules:\n",
    "        try:\n",
    "            importlib.import_module(mod)\n",
    "            status[mod] = True\n",
    "        except ImportError:\n",
    "            status[mod] = False\n",
    "    return status\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# UI\n",
    "# ============================================================\n",
    "\n",
    "class InstallerUI:\n",
    "\n",
    "    def __init__(self):\n",
    "        self._checkboxes: dict[str, widgets.Checkbox] = {}\n",
    "        self._build_ui()\n",
    "\n",
    "    def _build_ui(self):\n",
    "        header = widgets.HTML(\"\"\"\n",
    "        <div style=\"font-family:monospace; padding:8px 0 4px 0;\">\n",
    "            <span style=\"font-size:1.25em; font-weight:bold;\">[Installer] Package Installer</span><br>\n",
    "            <span style=\"font-size:0.85em; color:#888;\">\n",
    "                Select the groups you need, then click <b>Install selected</b>.<br>\n",
    "                Required groups are always installed and cannot be deselected.\n",
    "            </span>\n",
    "        </div>\n",
    "        \"\"\")\n",
    "\n",
    "        # --- Checkboxes per group ---\n",
    "        rows = []\n",
    "        for grp in PACKAGE_GROUPS:\n",
    "            cb = widgets.Checkbox(\n",
    "                value=grp[\"default\"] or grp[\"required\"],\n",
    "                disabled=grp[\"required\"],\n",
    "                indent=False,\n",
    "                layout=widgets.Layout(width=\"30px\"),\n",
    "            )\n",
    "            self._checkboxes[grp[\"id\"]] = cb\n",
    "\n",
    "            lbl = widgets.HTML(\n",
    "                f'<span style=\"font-family:monospace; font-size:0.92em;\">'\n",
    "                f'<b>{grp[\"label\"]}</b><br>'\n",
    "                f'<span style=\"color:#666; font-size:0.88em;\">{grp[\"description\"]}</span>'\n",
    "                f'</span>'\n",
    "            )\n",
    "            check_btn = widgets.Button(\n",
    "                description=\"Check\",\n",
    "                button_style=\"\",\n",
    "                layout=widgets.Layout(width=\"max-content\", height=\"28px\", padding=\"0 10px\"),\n",
    "                tooltip=\"Verify if these packages are already installed\",\n",
    "            )\n",
    "            status_html = widgets.HTML(\n",
    "                \"<span style='color:#aaa; font-size:0.8em;'>not checked</span>\",\n",
    "                layout=widgets.Layout(width=\"160px\"),\n",
    "            )\n",
    "\n",
    "            # Bind check button\n",
    "            check_btn.on_click(self._make_checker(grp, status_html))\n",
    "\n",
    "            row = widgets.HBox(\n",
    "                [cb, lbl, check_btn, status_html],\n",
    "                layout=widgets.Layout(\n",
    "                    align_items=\"center\",\n",
    "                    padding=\"6px 8px\",\n",
    "                    border=\"1px solid #e0e0e0\",\n",
    "                    margin=\"2px 0\",\n",
    "                    border_radius=\"6px\",\n",
    "                ),\n",
    "            )\n",
    "            rows.append(row)\n",
    "\n",
    "        groups_box = widgets.VBox(rows, layout=widgets.Layout(width=\"800px\"))\n",
    "\n",
    "        # --- Quick-select row ---\n",
    "        sel_all = widgets.Button(description=\"Select all\",   button_style=\"\", layout=widgets.Layout(width=\"max-content\", padding=\"0 10px\"))\n",
    "        sel_def = widgets.Button(description=\"Defaults\",     button_style=\"\", layout=widgets.Layout(width=\"max-content\", padding=\"0 10px\"))\n",
    "        sel_non = widgets.Button(description=\"Deselect all\", button_style=\"\", layout=widgets.Layout(width=\"max-content\", padding=\"0 10px\"))\n",
    "        chk_all = widgets.Button(description=\"Check all\",    button_style=\"info\", layout=widgets.Layout(width=\"max-content\", padding=\"0 10px\"))\n",
    "\n",
    "        sel_all.on_click(lambda _: self._quick_select(\"all\"))\n",
    "        sel_def.on_click(lambda _: self._quick_select(\"default\"))\n",
    "        sel_non.on_click(lambda _: self._quick_select(\"none\"))\n",
    "        chk_all.on_click(self._check_all)\n",
    "\n",
    "        quick_row = widgets.HBox([sel_all, sel_def, sel_non, chk_all],\n",
    "                                 layout=widgets.Layout(margin=\"8px 0 4px 0\", gap=\"6px\"))\n",
    "\n",
    "        # --- Install button + log ---\n",
    "        self._install_btn = widgets.Button(\n",
    "            description=\"Install selected\",\n",
    "            button_style=\"primary\",\n",
    "            layout=widgets.Layout(width=\"max-content\", height=\"38px\", margin=\"0 10px 0 0\", padding=\"0 20px\"),\n",
    "        )\n",
    "        self._install_btn.on_click(self._on_install)\n",
    "\n",
    "        self._progress = widgets.IntProgress(\n",
    "            min=0, max=1, value=0,\n",
    "            bar_style=\"info\",\n",
    "            layout=widgets.Layout(width=\"600px\", visibility=\"hidden\"),\n",
    "        )\n",
    "        self._log = widgets.Output(\n",
    "            layout=widgets.Layout(\n",
    "                border=\"1px solid #ddd\",\n",
    "                max_height=\"280px\",\n",
    "                overflow_y=\"auto\",\n",
    "                padding=\"6px\",\n",
    "                width=\"800px\",\n",
    "                font_family=\"monospace\",\n",
    "            )\n",
    "        )\n",
    "\n",
    "        self.ui = widgets.VBox([\n",
    "            header,\n",
    "            groups_box,\n",
    "            quick_row,\n",
    "            widgets.HBox([self._install_btn, self._progress],\n",
    "                         layout=widgets.Layout(align_items=\"center\", gap=\"12px\")),\n",
    "            self._log,\n",
    "        ])\n",
    "\n",
    "    # -------------------------------------------------------\n",
    "    def _make_checker(self, grp, status_html):\n",
    "        def _check(_):\n",
    "            result = _check_imports(grp[\"check\"])\n",
    "            ok_all = all(result.values())\n",
    "            parts = []\n",
    "            for mod, ok in result.items():\n",
    "                icon = \"[OK]\" if ok else \"[FAIL]\"\n",
    "                parts.append(f\"{icon} {mod}\")\n",
    "            color = \"#2e7d32\" if ok_all else \"#c62828\"\n",
    "            status_html.value = (\n",
    "                f'<span style=\"font-size:0.78em; color:{color};\">'\n",
    "                + \" &nbsp; \".join(parts)\n",
    "                + \"</span>\"\n",
    "            )\n",
    "        return _check\n",
    "\n",
    "    def _check_all(self, _):\n",
    "        \"\"\"Trigger check on all groups.\"\"\"\n",
    "        # Rebuild rows to retrieve status_html refs — simpler: just re-run checks inline\n",
    "        with self._log:\n",
    "            clear_output()\n",
    "            print(\"Checking all groups…\")\n",
    "            for grp in PACKAGE_GROUPS:\n",
