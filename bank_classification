    "import pandas as pd\n",
    "from scipy.stats import randint\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.model_selection import RandomizedSearchCV, StratifiedKFold\n",
    "\n",
    "SEED = 42\n",
    "\n",
    "# -----------------------------\n",
    "# Vérification des données\n",
    "# -----------------------------\n",
    "if 'X' not in dir() or 'y' not in dir():\n",
    "    print('Load train.csv first.')\n",
    "else:\n",
    "\n",
    "    # -----------------------------\n",
    "    # Échantillonnage (accélération)\n",
    "    # -----------------------------\n",
    "    USE_SAMPLE = True  # True = utilise 30% des données pour accélérer fortement\n",
    "\n",
    "    if USE_SAMPLE:\n",
    "        # Réduction du dataset → gain de temps majeur (souvent x3 à x5)\n",
    "        X_train = X.sample(frac=0.3, random_state=SEED)\n",
    "        y_train = y.loc[X_train.index]\n",
    "    else:\n",
    "        X_train, y_train = X, y\n",
    "\n",
    "    # -----------------------------\n",
    "    # Pipeline\n",
    "    # -----------------------------\n",
    "    rf_pipeline = Pipeline([\n",
    "        ('pre', build_preprocessor(NUM_COLS, CAT_COLS)),  # preprocessing refait à chaque fold\n",
    "        ('clf', RandomForestClassifier(\n",
    "            class_weight='balanced',\n",
    "            random_state=SEED,\n",
    "            n_jobs=-1  # utilise tous les CPU\n",
    "        ))\n",
    "    ])\n",
    "\n",
    "    # -----------------------------\n",
    "    # Espace de recherche réduit\n",
    "    # -----------------------------\n",
    "    rf_param_dist = {\n",
    "        # Réduit de [100–500] → [50–200]\n",
    "        # Moins d’arbres = gain direct de temps\n",
    "        'clf__n_estimators': randint(50, 200),\n",
    "\n",
    "        # Réduit de [5–20] → [5–15]\n",
    "        # Moins profond = arbres plus rapides à construire\n",
    "        'clf__max_depth': randint(5, 15),\n",
    "\n",
    "        # Réduit de [2–20] → [2–10]\n",
    "        # Moins de combinaisons inutiles\n",
    "        'clf__min_samples_split': randint(2, 10),\n",
    "\n",
    "        # Réduit de [1–10] → [1–5]\n",
    "        # Simplification du search space\n",
    "        'clf__min_samples_leaf': randint(1, 5),\n",
    "\n",
    "        # Supprime 0.5 pour réduire les possibilités\n",
    "        'clf__max_features': ['sqrt', 'log2']\n",
    "    }\n",
    "\n",
    "    # -----------------------------\n",
    "    # Validation croisée\n",
    "    # -----------------------------\n",
    "    cv = StratifiedKFold(\n",
    "        n_splits=3,  # réduit de 5 → 3 (≈ 40% plus rapide)\n",
    "        shuffle=True,\n",
    "        random_state=SEED\n",
    "    )\n",
    "\n",
    "    # -----------------------------\n",
    "    # Randomized Search\n",
    "    # -----------------------------\n",
    "    rf_search = RandomizedSearchCV(\n",
    "        estimator=rf_pipeline,\n",
    "        param_distributions=rf_param_dist,\n",
    "        \n",
    "        n_iter=10,  # réduit de 20 → 10 (divise le nombre de modèles testés par 2)\n",
    "        \n",
    "        scoring='roc_auc',\n",
    "        cv=cv,\n",
    "        verbose=2,\n",
    "        random_state=SEED,\n",
    "        n_jobs=-1  # parallélisation maximale\n",
    "    )\n",
    "\n",
    "    # -----------------------------\n",
    "    # Entraînement\n",
    "    # -----------------------------\n",
    "    print('Running RandomizedSearchCV (fast mode)...')\n",
    "    rf_search.fit(X_train, y_train)\n",
    "\n",
    "    # -----------------------------\n",
    "    # Résultats\n",
    "    # -----------------------------\n",
    "    print('\\nBest AUC-ROC:', round(rf_search.best_score_, 4))\n",
    "\n",
    "    print('\\nBest parameters:')\n",
    "    for k, v in rf_search.best_params_.items():\n",
