    "def preprocess(df, is_train=True):\n",
    "    \"\"\"Apply feature engineering and return X (and y if train).\"\"\"\n",
    "    df = df.copy()\n",
    "\n",
    "    # --- Feature engineering ---\n",
    "\n",
    "    # 1. Binary flag: was the client contacted in a previous campaign?\n",
    "    df['was_contacted_before'] = (df['pdays'] != -1).astype(int)\n",
    "\n",
    "    # 2. Replace pdays=-1 with 0 (no previous contact = 0 days ago is misleading;\n",
    "    #    we keep the flag above and set a neutral value)\n",
    "    df['pdays'] = df['pdays'].replace(-1, 0)\n",
    "\n",
    "    # 3. Month as integer (cyclical order matters)\n",
    "    month_map = {'jan':1,'feb':2,'mar':3,'apr':4,'may':5,'jun':6,\n",
    "                 'jul':7,'aug':8,'sep':9,'oct':10,'nov':11,'dec':12}\n",
    "    df['month_num'] = df['month'].map(month_map)\n",
    "\n",
    "    # 4. Balance sign flag\n",
    "    df['negative_balance'] = (df['balance'] < 0).astype(int)\n",
    "\n",
    "    # Define feature columns\n",
    "    NUMERICAL = ['age', 'balance', 'duration', 'campaign',\n",
    "                 'pdays', 'previous', 'month_num',\n",
    "                 'was_contacted_before', 'negative_balance']\n",
    "\n",
    "    CATEGORICAL = ['job', 'marital', 'education', 'default',\n",
    "                   'housing', 'loan', 'contact', 'poutcome']\n",
    "\n",
    "    X = df[NUMERICAL + CATEGORICAL]\n",
    "\n",
    "    if is_train and 'y' in df.columns:\n",
    "        y = df['y']\n",
    "        return X, y, NUMERICAL, CATEGORICAL\n",
    "    return X, NUMERICAL, CATEGORICAL\n",
    "\n",
    "\n",
    "# Build preprocessor (ColumnTransformer)\n",
    "def build_preprocessor(numerical_cols, categorical_cols):\n",
    "    from sklearn.preprocessing import StandardScaler, OrdinalEncoder\n",
    "    from sklearn.compose import ColumnTransformer\n",
    "\n",
    "    return ColumnTransformer(transformers=[\n",
    "        ('num', StandardScaler(), numerical_cols),\n",
    "        ('cat', OrdinalEncoder(handle_unknown='use_encoded_value', unknown_value=-1), categorical_cols)\n",
    "    ], remainder='drop')\n",
    "\n",
    "\n",
    "# Apply preprocessing\n",
    "if 'df_train' in dir() and 'y' in df_train.columns:\n",
    "    X, y, NUM_COLS, CAT_COLS = preprocess(df_train, is_train=True)\n",
    "    print(f'X shape: {X.shape} | y shape: {y.shape}')\n",
    "    print(f'Positive class rate: {y.mean():.3f}')\n",
    "    X.head(3)\n",
    "else:\n",
    "    print('Load train.csv to build X and y.')"
   ]
