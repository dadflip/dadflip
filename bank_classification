    "\n",
    "    # -----------------------------\n",
    "    # Modèle final\n",
    "    # -----------------------------\n",
    "    best_model = rf_search.best_estimator_\n",
    "\n",
    "    # Réentraînement sur toutes les données\n",
    "    # Important : compense l'utilisation du sample\n",
    "    print('\\nRetraining best model on full dataset...')\n",
    "    best_model.fit(X, y)\n",
    "\n",
    "    print('Model ready.')"
