estClassifier, GradientBoostingClassifier\nfrom sklearn.metrics import (\n    roc_auc_score, f1_score, classification_report,\n    ConfusionMatrixDisplay, RocCurveDisplay\n)\n\n# XGBoost\ntry:\n    from xgboost import XGBClassifier\n    USE_XGB = True\nexcept ImportError:\n    print('XGBoost not installed — using GradientBoostingClassifier instead')\n    USE_XGB = False\n\nplt.style.use('seaborn-v0_8-whitegrid')\nsns.set_palette('Set2')\nSEED = 42\nprint('Libraries loaded successfully.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-30T07:33:41.141024Z","iopub.execute_input":"2026-04-30T07:33:41.142126Z","iopub.status.idle":"2026-04-30T07:33:43.995780Z","shell.execute_reply.started":"2026-04-30T07:33:41.142075Z","shell.execute_reply":"2026-04-30T07:33:43.994630Z"}},"outputs":[{"name":"stdout","text":"Libraries loaded successfully.\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"import os\n\nTEST_PATH  = '/kaggle/input/datasets/davidechinedum/bank-dataset/test.csv'\nSUB_PATH   = '/kaggle/input/datasets/davidechinedum/bank-dataset/sample_submission.csv'\nTRAIN_PATH = '/kaggle/input/datasets/davidechinedum/bank-dataset/train.csv'  # May not exist on Kaggle playground — see cell below\n\ndf_test = pd.read_csv(TEST_PATH)\ndf_sub  = pd.read_csv(SUB_PATH)\n\nif os.path.exists(TRAIN_PATH):\n    df_train = pd.read_csv(TRAIN_PATH)\n    print(f'Train: {df_train.shape} | Test: {df_test.shape}')\nelse:\n    print('train.csv not found — download it from Kaggle!')\n    print(f'Test shape: {df_test.shape}')\n\ndf_test.head()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-30T07:33:47.920247Z","iopub.execute_input":"2026-04-30T07:33:47.921310Z","iopub.status.idle":"2026-04-30T07:33:50.680850Z","shell.execute_reply.started":"2026-04-30T07:33:47.921271Z","shell.execute_reply":"2026-04-30T07:33:50.679820Z"}},"outputs":[{"name":"stdout","text":"Train: (750000, 18) | Test: (250000, 17)\n","output_type":"stream"}