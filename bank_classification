    "\n",
    "    # --- Model 1: Logistic Regression ---\n",
    "    model_lr = Pipeline([\n",
    "        ('pre', preprocessor),\n",
    "        ('clf', LogisticRegression(\n",
    "            class_weight='balanced',\n",
    "            max_iter=1000,\n",
    "            random_state=SEED\n",
    "        ))\n",
    "    ])\n",
    "\n",
    "    # --- Model 2: Random Forest ---\n",
    "    model_rf = Pipeline([\n",
    "        ('pre', build_preprocessor(NUM_COLS, CAT_COLS)),\n",
    "        ('clf', RandomForestClassifier(\n",
    "            n_estimators=200,\n",
    "            class_weight='balanced',\n",
    "            max_depth=10,\n",
    "            n_jobs=-1,\n",
    "            random_state=SEED\n",
    "        ))\n",
    "    ])\n",
    "\n",
    "    # --- Model 3: XGBoost (or GBM fallback) ---\n",
    "    if USE_XGB:\n",
    "        # Compute scale_pos_weight to handle imbalance\n",
    "        neg, pos = (y == 0).sum(), (y == 1).sum()\n",
    "        spw = neg / pos\n",
    "        model_boost = Pipeline([\n",
    "            ('pre', build_preprocessor(NUM_COLS, CAT_COLS)),\n",
    "            ('clf', XGBClassifier(\n",
    "                n_estimators=300,\n",
    "                learning_rate=0.05,\n",
    "                max_depth=6,\n",
    "                scale_pos_weight=spw,\n",
    "                eval_metric='auc',\n",
    "                random_state=SEED,\n",
    "                n_jobs=-1\n",
    "            ))\n",
    "        ])\n",
    "    else:\n",
    "        model_boost = Pipeline([\n",
